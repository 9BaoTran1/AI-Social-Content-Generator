          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'X\303\242y d\341\273\261ng s\341\273\251c b\341\273\201n tinh th\341\272\247n: Kh\303\264ng khu\341\272\245t ph\341\273\245c, ki\303\252n \304\221\341\273\213nh v\341\273\233i m\341\273\245c ti\303\252u\',"
