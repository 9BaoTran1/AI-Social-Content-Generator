          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'M\341\273\215i th\341\273\251 c\303\263 s\341\272\265n trong m\341\273\231t c\303\272 ch\341\272\241m khi\341\272\277n s\341\273\251c ch\341\273\213u \304\221\341\273\261ng, ngh\341\273\213 l\341\273\261c gi\341\272\243m \304\221i\',"
