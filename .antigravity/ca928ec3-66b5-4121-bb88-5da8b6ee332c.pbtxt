        }
        lines {
          text: "    coreValues: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Nh\341\272\255n di\341\273\207n: B\341\272\257t tr\303\272ng th\341\273\247 ph\341\272\241m g\303\242y m\341\272\245t t\341\272\255p trung v\303\240 ph\303\242n m\341\272\243nh n\304\203ng l\306\260\341\273\243ng\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Th\341\273\261c h\303\240nh: X\303\241c \304\221\341\273\213nh \306\260u ti\303\252n, s\341\272\257p x\341\272\277p l\341\273\231 tr\303\254nh v\303\240 l\341\273\261a ch\341\273\215n t\303\242m \304\221i\341\273\203m theo t\341\273\253ng giai \304\221o\341\272\241n\',"
