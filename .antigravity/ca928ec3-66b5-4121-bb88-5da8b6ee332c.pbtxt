        lines {
          text: "    title: \'LIFE ACTION \342\200\223 \304\220\341\272\240O DI\341\273\204N CH\303\215NH M\303\214NH\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    type: \'ws\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    description: \'H\303\240nh tr\303\254nh c\303\271ng b\341\272\241n nh\303\254n l\341\272\241i nh\341\273\257ng g\303\254 \304\221\303\243 qua, thay \304\221\341\273\225i g\303\263c nh\303\254n v\303\240 ch\341\273\247 \304\221\341\273\231ng vi\341\272\277t ti\341\272\277p k\341\273\213ch b\341\272\243n cu\341\273\231c \304\221\341\273\235i m\303\254nh thay v\303\254 s\341\273\221ng theo mong \304\221\341\273\243i c\341\273\247a ng\306\260\341\273\235i kh\303\241c.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    targetAudience: [\'Ng\306\260\341\273\235i t\341\273\253ng tr\341\272\243i qua th\341\272\245t b\341\272\241i ho\341\272\267c m\341\272\245t ph\306\260\306\241ng h\306\260\341\273\233ng\', \'Ng\306\260\341\273\235i c\341\272\243m th\341\272\245y \304\221ang s\341\273\221ng theo k\341\273\213ch b\341\272\243n c\341\273\247a ng\306\260\341\273\235i kh\303\241c\', \'\304\220\341\273\231 tu\341\273\225i 20-35 tu\341\273\225i\'],"
