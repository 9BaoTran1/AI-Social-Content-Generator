273\253ng ng\341\272\241i tr\341\272\243i nghi\341\273\207m nh\341\273\257ng \304\221i\341\273\201u m\341\273\233i, b\341\273\237i ch\303\255nh nh\341\273\257ng tr\341\272\243i nghi\341\273\207m \304\221\303\263 s\341\272\275 gi\303\272p m\303\254nh nh\303\254n r\303\265 gi\303\241 tr\341\273\213, \304\221i\341\273\203m m\341\272\241nh v\303\240 c\341\272\243 nh\341\273\257ng gi\341\273\233i h\341\272\241n c\341\272\247n v\306\260\341\273\243t qua c\341\273\247a b\341\272\243n th\303\242n. M\303\254nh c\303\263 bi\341\272\277t m\341\273\231t d\341\273\261 \303\241n kh\303\241 hay gi\303\272p x\303\241c \304\221\341\273\213nh hi\341\273\207n t\341\272\241i b\341\272\241n \304\221ang \341\273\237 tr\341\272\241ng th\303\241i n\303\240o, \304\221i\341\273\201u g\303\254 \304\221ang c\341\272\243n tr\341\273\237 s\341\273\261 ph\303\241t tri\341\273\203n v\303\240 \304\221\303\242u l\303\240 h\306\260\341\273\233ng \304\221i ph\303\271 h\341\273\243p h\306\241n trong th\341\273\235i gian t\341\273\233i. N\341\272\277u b\341\272\241n \304\221ang mu\341\273\221n hi\341\273\203u b\341\272\243n th\303\242n h\306\241n v\303\240 ph\303\241t tri\341\273\203n \304\221\303\272ng h\306\260\341\273\233ng, c\303\263 th\341\273\203 nh\341\272\257n m\303\254nh nh\303\251`\n  },\n  {\n    id: \'bm-tt-2\',\n    platform: \'TikTok\',\n    category: \'Comment Tu\341\273\225i 20-39\',\n    title: \'Khung m\341\272\253u: \304\220\341\273\253ng so s\303\241nh b\341\272\243n th\303\242n & Test tr\306\260\341\273\237ng th\303\240nh\',\n    tags: [\'Tiktok\', \'So s\303\241nh\', \'B\303\240i test 1-1\'],\n    keyInsight: \'G\341\273\241 b\341\273\217 t\341\273\261 ti khi so s\303\241nh v\341\273\233i ng\306\260\341\273\235i kh\303\241c, trao quy\341\273\201n t\341\273\261 quy\341\272\277t cu\341\273\231c \304\221\341\273\235i.\',\n    content: `G\341\273\255i c\303\241c b\341\272\241n \304\221ang \341\273\237 \304\221\341\273\231 tu\341\273\225i 20-39t, \304\221\341\273\253ng so s\303\241nh b\341\272\243n th\303\242n v\341\273\233i ng\306\260\341\273\235i kh\303\241c, c\305\251ng \304\221\341\273\253ng v\303\254 1 l\341\273\235i c\341\273\247a ng\306\260\341\273\235i kh\303\241c m\303\240 nghi ng\341\273\235 v\303\240 t\341\273\261 ti v\341\273\201 b\341\272\243n th\303\242n. Cu\341\273\231c \304\221\341\273\235i c\341\273\247a b\341\272\243n th\303\242n ph\341\273\245 thu\341\273\231c v\303\240o s\341\273\261 l\341\273\261a ch\341\273\215n c\341\273\247a ch\303\255nh m\303\254nh, v\341\272\255y h\303\243y suy ngh\304\251 th\341\272\255t k\341\273\271 v\303\240 l\341\273\261a ch\341\273\215n \304\221\303\272ng v\303\240 tr\341\272\243i nghi\341\273\207m t\341\272\245t c\341\272\243 \304\221\341\273\203 bi\341\272\277t m\303\254nh ch\341\273\215n \304\221\303\272ng hay sai. M\303\254nh c\303\263 1 b\303\240i test \304\221\303\241nh gi\303\241 m\341\273\251c \304\221\341\273\231 tr\306\260\341\273\237ng th\303\240nh c\341\273\247a suy ngh\304\251 v\303\240 c\303\263 gi\341\272\243i \304\221\303\241p chi ti\341\272\277t 1-1 h\306\260\341\273\233ng ph\303\241t tri\341\273\203n. B\341\272\241n n\303\240o mong mu\341\273\221n m\303\254nh tr\341\273\237 n\303\252n v\341\273\257ng v\303\240ng, quy\341\272\277t \304\221o\303\241n, t\303\255ch c\341\273\261c h\306\241n, c\341\272\247n m\303\254nh g\341\273\255i cho free nh\303\251 \341\272\241   `\n  },\n  {\n    id: \'bm-tt-3\',\n    platform: \'TikTok\',\n    category: \'Comment C\341\272\243m X\303\272c & S\341\273\251c B\341\273\201n\',\n    title: \'Khung m\341\272\253u: V\306\260\341\273\243t qua ti\303\252u c\341\273\261c & X\303\242y d\341\273\261ng t\306\260 duy b\341\273\201n b\341\273\211\',\n    tags: [\'Tiktok\', \'C\341\272\243m x\303\272c\', \'S\341\273\251c b\341\273\201n\'],\n    keyInsight: \'B\303\254nh th\306\260\341\273\235ng h\303\263a c\341\272\243m gi\303\241c mu\341\273\221n b\341\273\217 cu\341\273\231c v\303\240 \304\221\306\260a ra gi\341\272\243i ph\303\241p r\303\250n luy\341\273\207n \303\275 ch\303\255.\',\n    content: `M\341\273\231t \304\221i\341\273\201u m\303\240 m\303\254nh th\341\272\245y c\303\241c b\341\272\241n tr\341\272\273 b\303\242y gi\341\273\235 c\305\251ng n\303\252n h\341\273\215c \304\221\303\263 l\303\240 nhanh l\341\272\245y l\341\272\241i c\341\272\243m x\303\272c - v\306\260\341\273\243t qua s\341\273\261 ti\303\252u c\341\273\261c V\303\254 ch\303\272ng ta th\303\254 r\341\272\245t d\341\273\205 bu\341\273\223n ch\303\241n v\303\240 t\341\273\253 b\341\273\217 ch\341\273\211 v\303\254 m\341\273\231t v\303\240i v\341\272\245n \304\221\341\273\201 nh\341\273\217 trong ng\303\240y, ngay sau \304\221\303\263 l\303\240 v\341\273\251t h\341\272\277t m\341\273\215i th\341\273\251, kh\303\264ng mu\341\273\221n l\303\240m g\303\254, c\305\251ng kh\303\264ng gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201. \304\220\303\264i khi b\341\272\241n kh\303\264ng mu\341\273\221n v\341\272\255y \304\221\303\242u, nh\306\260ng kh\303\264ng th\341\273\203 l\303\240m kh\303\241c \304\221\306\260\341\273\243c. \304\220i\341\273\201u n\303\240y c\305\251ng l\303\240 \341\273\237 tinh th\341\272\247n, \303\275 ch\303\255 c\341\273\247a b\341\272\243n th\303\242n. M\303\254nh \304\221ang c\303\263 m\341\273\231t b\303\240i test review nh\341\273\217 c\303\263 gi\341\272\243i \304\221\303\241p chi ti\341\272\277t 1-1 qua online gi\303\272p \304\221\341\273\241 x\303\242y d\341\273\261ng suy ngh\304\251 t\306\260 duy m\341\272\241nh m\341\272\275, ch\341\273\247 \304\221\341\273\231ng, t\303\255ch c\341\273\261c, b\341\273\201n b\341\273\211 h\306\241n ph\303\271 h\341\273\243p v\341\273\233i t\303\255nh c\303\241ch, ti\341\273\201m n\304\203ng c\341\273\247a t\341\273\253ng b\341\272\241n. M\303\254nh v\341\272\253n chia s\341\272\273 free cho c\303\241c b\341\272\241n n\303\240o t\341\273\253 20+ \304\221ang c\341\272\247n \341\272\241.   `\n  },\n  {\n    id: \'bm-tt-4\',\n    platform: \'TikTok\',\n    category: \'Comment Tu\341\273\225i 21-35\',\n    title: \'Khung m\341\272\253u: Ch\341\273\257a l\303\240nh vs Th\341\272\245u hi\341\273\203u b\341\272\243n ch\341\272\245t\',\n    tags: [\'Tiktok\', \'\304\220\341\273\251a tr\341\272\273 b\303\252n trong\', \'Template 1-1\'],\n    keyInsight: \'\304\220i t\303\254m nguy\303\252n nh\303\242n g\341\273\221c r\341\273\205 c\341\273\247a s\341\273\261 thi\341\272\277u t\341\273\261 tin thay v\303\254 ch\341\273\211 ch\341\273\257a l\303\240nh t\341\272\241m th\341\273\235i.\',\n    content: `G\341\273\255i c\303\241c b\341\272\241n \304\221ang trong h\303\240nh tr\303\254nh r\341\273\261c r\341\273\241 tu\341\273\225i 21-35 tu\341\273\225i: \304\220\303\242y c\303\263 l\341\272\275 l\303\240 l\303\272c b\341\272\241n \304\221ang tha thi\341\272\277t \304\221i t\303\254m h\306\260\341\273\233ng \304\221i ph\303\271 h\341\273\243p cho m\303\254nh. Nh\306\260ng \304\221a s\341\273\221 ch\303\272ng ta l\341\272\241i \304\221ang \304\221i t\303\254m \342\200\234gi\341\272\243i ph\303\241p\342\200\235 \304\221\341\273\203 ch\341\273\257a l\303\240nh cho \304\221\341\273\251a tr\341\272\273 b\303\252n trong c\341\273\247a m\303\254nh. D\303\271 c\303\263 l\303\240m \304\221\306\260\341\273\243c nhi\341\273\201u vi\341\273\207c, nh\306\260ng sao v\341\272\253n kh\303\264ng c\341\272\243m th\341\272\245y t\341\273\261 tin v\303\240 h\341\272\241nh ph\303\272c m\341\273\227i ng\303\240y? M\303\254nh c\303\263 m\341\273\231t Template \304\221\303\241nh gi\303\241 m\341\273\251c \304\221\341\273\231 th\341\272\245u hi\341\273\203u t\303\255nh c\303\241ch, con ng\306\260\341\273\235i th\341\272\255t c\341\273\247a b\341\272\241n v\303\240 h\341\273\227 tr\341\273\243 gi\341\272\243i \304\221\303\241p 1-1 v\341\273\201 l\341\273\231 tr\303\254nh \304\221\341\273\203 c\341\272\243i thi\341\273\207n b\341\272\243n l\304\251nh v\303\240 s\341\273\261 t\341\273\261 tin t\341\273\253 b\303\252n trong. B\341\272\241n n\303\240o \304\221ang c\341\272\247n m\341\273\231t \"ng\306\260\341\273\235i d\341\272\253n \304\221\306\260\341\273\235ng\" th\303\254 m\303\254nh g\341\273\255i t\341\272\267ng free nh\303\251   `\n  },\n  {\n    id: \'bm-tt-5\',\n    platform: \'TikTok\',\n    category: \'Comment \304\220i L\303\240m & K\341\273\271 N\304\203ng M\341\273\201m\',\n    title: \'Khung m\341\272\253u: Chuy\303\252n m\303\264n vs T\306\260 duy l\303\240m vi\341\273\207c v\341\273\233i con ng\306\260\341\273\235i\',\n    tags: [\'Tiktok\', \'Ng\306\260\341\273\235i \304\221i l\303\240m\', \'Th\341\273\235i \304\221\341\272\241i AI\'],\n    keyInsight: \'Chuy\303\252n m\303\264n l\303\240 ch\306\260a \304\221\341\273\247, t\306\260 duy gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201 v\303\240 hi\341\273\203u m\303\254nh m\341\273\233i t\341\272\241o ra \304\221\341\273\231t ph\303\241.\',\n    content: `M\303\254nh t\341\273\253ng ngh\304\251 ch\341\273\211 c\341\272\247n gi\341\273\217i chuy\303\252n m\303\264n l\303\240 \304\221\341\273\247. C\303\240ng \304\221i l\303\240m m\341\273\233i th\341\272\245y nhi\341\273\201u ng\306\260\341\273\235i kh\303\264ng h\341\272\263n code gi\341\273\217i nh\341\272\245t nh\306\260ng l\341\272\241i \304\221\306\260\341\273\243c giao d\341\273\261 \303\241n l\341\273\233n h\306\241n v\303\254 h\341\273\215 c\303\263 t\306\260 duy gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201, giao ti\341\272\277p v\303\240 l\303\240m vi\341\273\207c v\341\273\233i con ng\306\260\341\273\235i r\341\272\245t t\341\273\221t. \304\220i\341\273\201u n\303\240y kh\303\264ng ai d\341\272\241y k\341\273\271 \341\273\237 tr\306\260\341\273\235ng c\341\272\243. Nh\341\273\235 m\341\273\231t b\303\240i \304\221\303\241nh gi\303\241 v\341\273\201 t\306\260 duy v\303\240 n\304\203ng l\341\273\261c c\303\241 nh\303\242n m\303\240 m\303\254nh hi\341\273\203u r\303\265 \304\221i\341\273\203m m\341\272\241nh, \304\221i\341\273\203m c\341\272\247n ph\303\241t tri\341\273\203n c\341\273\247a b\341\272\243n th\303\242n h\306\241n. B\341\272\241n n\303\240o \304\221ang loay hoay v\341\273\201 \304\221\341\273\213nh h\306\260\341\273\233ng ngh\341\273\201 nghi\341\273\207p ho\341\272\267c mu\341\273\221n ph\303\241t tri\341\273\203n xa h\306\241n trong th\341\273\235i \304\221\341\272\241i AI th\303\254 ib m\303\254nh, m\303\254nh share nh\303\251.`\n  },\n  {\n    id: \'bm-li-1\',\n    platform: \'LinkedIn\',\n    category: \'Tin nh\341\272\257n Outreach HRBP\',\n    title: \'M\341\272\253u ti\341\272\277p c\341\272\255n LinkedIn: HRBP & Nghi\303\252n c\341\273\251u n\304\203ng l\306\260\341\273\243ng Work-Life\',\n    tags: [\'LinkedIn\', \'HRBP\', \'MBTI\', \'1:1 Consultation\'],\n    keyInsight: \'T\341\272\241o uy t\303\255n b\341\272\261ng v\341\273\213 tr\303\255 HRBP/L&D v\303\240 g\303\263c nh\303\254n khoa h\341\273\215c (MBTI, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng).\',\n    content: `Xin ch\303\240o b\341\272\241n, m\303\254nh l\303\240 Ng\341\273\215c Di\341\273\207p, hi\341\273\207n \304\221ang l\303\240m HRBP. Ngo\303\240i c\303\264ng vi\341\273\207c ch\303\255nh th\303\254 m\303\254nh y\303\252u th\303\255ch nghi\303\252n c\341\273\251u v\341\273\201 ph\303\241t tri\341\273\203n con ng\306\260\341\273\235i. M\303\254nh \304\221ang \304\221ang c\341\273\231ng t\303\241c c\303\271ng team HR, L&D v\341\273\201 m\341\273\231t project v\341\273\201 ph\303\241t tri\341\273\203n b\341\272\243n th\303\242n & c\303\241ch m\341\273\227i ng\306\260\341\273\235i s\341\273\255 d\341\273\245ng n\304\203ng l\306\260\341\273\243ng trong work-life. D\341\273\261 \303\241n d\303\240nh cho sinh vi\303\252n n\304\203m 3, 4 v\303\240 ng\306\260\341\273\235i \304\221i l\303\240m, c\303\263:\n- Test t\303\255nh c\303\241ch khoa h\341\273\215c (c\303\263 MBTI) \304\221\341\273\203 hi\341\273\203u r\303\265 \304\221i\341\273\203m m\341\272\241nh, \304\221i\341\273\203m y\341\272\277u c\341\273\247a m\303\254nh\n- T\303\254m hi\341\273\203u nguy\303\252n nh\303\242n v\303\240 c\303\241ch c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng\n- \304\220\341\273\213nh h\306\260\341\273\233ng ph\303\241t tri\341\273\203n c\303\241 nh\303\242n h\303\263a cho t\341\273\253ng ng\306\260\341\273\235i\nProject t\303\242m huy\341\272\277t c\341\273\247a ch\303\272ng m\303\254nh \304\221ang m\341\273\237 online, mi\341\273\205n ph\303\255 nh\341\272\255n tham v\341\272\245n 1:1. N\341\272\277u b\341\272\241n quan t\303\242m, b\341\272\241n \304\221\304\203ng k\303\275 t\341\272\241i \304\221\303\242y: [Link Tally/Form]\nN\341\272\277u c\303\263 c\303\242u h\341\273\217i cho m\303\254nh v\303\240 d\341\273\261 \303\241n, b\341\272\241n nh\341\272\257n l\341\272\241i m\303\254nh nh\303\251.\nC\341\272\243m \306\241n b\341\272\241n \304\221\303\243 \304\221\341\273\215c.\nCh\303\272c b\341\272\241n m\341\273\231t ng\303\240y t\303\255ch c\341\273\261c v\303\240 hi\341\273\207u qu\341\272\243 \341\272\241. \342\235\244\357\270\217`\n  },\n  {\n    id: \'bm-fb-1\',\n    platform: \'Facebook\',\n    category: \'Comment Ph\303\242n T\303\255ch \304\220a Chi\341\273\201u\',\n    title: \'M\341\272\253u comment Facebook: Trung l\341\272\255p, \304\221\341\273\223ng c\341\272\243m th\341\273\261c t\341\272\277 cho c\341\272\243 \304\221\303\264i b\303\252n\',\n    tags: [\'Facebook\', \'WS Only\', \'Trung l\341\272\255p\', \'Ph\303\242n t\303\255ch\'],\n    keyInsight: \'Kh\303\264ng \303\241p \304\221\341\272\267t 1 chi\341\273\201u, \304\221\341\273\223ng c\341\272\243m kh\303\241ch quan v\341\273\233i \303\241p l\341\273\261c c\303\264ng s\341\273\237 v\303\240 gi\341\273\233i thi\341\273\207u WS nh\341\272\271 nh\303\240ng.\',\n    content: `T\303\254nh tr\341\272\241ng n\303\240y kh\303\264ng ph\341\272\243i m\341\273\231t m\303\254nh b\341\272\241n, manager hi\341\273\207n c\303\262n b\341\273\213 \304\221\303\250 l\306\260\306\241ng d\306\260\341\273\233i 18m trong khi v\341\273\253a t\303\241i c\341\272\245u tr\303\272c duy tr\303\254 v\341\272\255n h\303\240nh v\341\273\253a ph\341\272\243i \304\221\303\240o t\341\272\241o 6 newbie (trong \304\221\303\263 c\303\263 ch\303\241u s\341\272\277p). Khi b\341\272\243n th\303\242n c\303\263 th\341\273\261c l\341\273\261c nh\306\260ng ch\306\260a \304\221\341\273\213nh v\341\273\213 r\303\265 r\303\240ng b\341\272\243n s\341\272\257c v\303\240 th\341\272\277 m\341\272\241nh ri\303\252ng, r\341\272\245t d\341\273\205 r\306\241i v\303\240o tr\341\272\241ng th\303\241i qu\303\241 t\341\272\243i v\303\240 m\341\272\245t ph\306\260\306\241ng h\306\260\341\273\233ng. B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS n\303\240y \304\221\341\273\203 nh\303\254n nh\341\272\255n l\341\272\241i \304\221i\341\273\203m m\341\272\241nh v\303\240 c\303\263 chi\341\272\277n l\306\260\341\273\243c ph\303\271 h\341\273\243p h\306\241n cho giai \304\221o\341\272\241n t\341\273\233i nh\303\251.`\n  }\n];\n"
    }
