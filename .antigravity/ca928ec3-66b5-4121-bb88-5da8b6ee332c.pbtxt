    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { OrderMeta, OrderType } from \'../types\';\nimport { ORDERS_METADATA } from \'../data/defaultPrograms\';\nimport { Video, Facebook, MessageCircle, Send, Mail, Linkedin, Sparkles, AlertCircle, ArrowRight } from \'lucide-react\';\n\ninterface OrderGridProps {\n  onSelectOrder: (orderType: OrderType) => void;\n}\n\nexport const OrderGrid: React.FC<OrderGridProps> = ({ onSelectOrder }) => {\n  const getPlatformIcon = (platform: string) => {\n    switch (platform) {\n      case \'Tiktok\':\n        return <Video className=\"w-5 h-5 text-rose-400\" />;\n      case \'Facebook\':\n        return <Facebook className=\"w-5 h-5 text-blue-400\" />;\n      case \'Threads\':\n        return <MessageCircle className=\"w-5 h-5 text-neutral-300\" />;\n      case \'LinkedIn\':\n        return <Linkedin className=\"w-5 h-5 text-sky-400\" />;\n      case \'Email\':\n        return <Mail className=\"w-5 h-5 text-amber-400\" />;\n      default:\n        return <Sparkles className=\"w-5 h-5 text-indigo-400\" />;\n    }\n  };\n\n  const getPlatformBadge = (platform: string) => {\n    switch (platform) {\n      case \'Tiktok\':\n        return \'bg-rose-500/15 text-rose-300 border-rose-500/30\';\n      case \'Facebook\':\n        return \'bg-blue-500/15 text-blue-300 border-blue-500/30\';\n      case \'Threads\':\n        return \'bg-slate-700/50 text-slate-200 border-slate-600/40\';\n      case \'LinkedIn\':\n        return \'bg-sky-500/15 text-sky-300 border-sky-500/30\';\n      case \'Email\':\n        return \'bg-amber-500/15 text-amber-300 border-amber-500/30\';\n      default:\n        return \'bg-indigo-500/15 text-indigo-300 border-indigo-500/30\';\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Banner Notice with Strict Rules Recap */}\n      <div className=\"bg-gradient-to-r from-slate-900 via-indigo-950/40 to-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <div className=\"flex items-center space-x-2 text-indigo-300 font-semibold text-sm mb-1\">\n              <Sparkles className=\"w-4 h-4 text-amber-400\" />\n              <span>H\341\273\207 Th\341\273\221ng 7 L\341\273\207nh Order Content Si\303\252u Nh\303\240n (10 N\304\203m Kinh Nghi\341\273\207m)</span>\n            </div>\n            <p className=\"text-slate-300 text-xs leading-relaxed max-w-3xl\">\n              Ch\341\273\215n m\341\273\231t trong 7 Order d\306\260\341\273\233i \304\221\303\242y, nh\341\272\255p m\303\264 t\341\272\243 clip/post ho\341\272\267c t\341\272\243i \341\272\243nh m\303\240n h\303\254nh l\303\252n. AI s\341\272\275 t\341\273\261 \304\221\341\273\231ng ph\303\242n t\303\255ch ng\341\273\257 c\341\272\243nh, ch\341\273\215n Workshop (WS) ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh (CT) t\341\273\221i \306\260u, tu\303\242n th\341\273\247 nghi\303\252m ng\341\272\267t quy t\341\272\257c t\341\273\253ng n\341\273\201n t\341\272\243ng v\303\240 cung c\341\272\245p k\341\273\213ch b\341\272\243n inbox 1-1 chuy\341\273\203n \304\221\341\273\225i cao.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-2 text-[11px]\">\n            <span className=\"px-2.5 py-1 rounded-lg bg-blue-950/80 text-blue-300 border border-blue-700/50 flex items-center gap-1.5 font-medium\">\n              <AlertCircle className=\"w-3.5 h-3.5 text-blue-400\" />\n              FB: Ch\341\273\211 r\341\272\243i Workshop (WS)\n            </span>\n            <span className=\"px-2.5 py-1 rounded-lg bg-rose-950/80 text-rose-300 border border-rose-700/50 flex items-center gap-1.5 font-medium\">\n              TikTok: 20-39t & Test 1-1\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Orders Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {ORDERS_METADATA.map((order: OrderMeta) => {\n          const isFacebook = order.platform === \'Facebook\';\n          return (\n            <div\n              key={order.id}\n              onClick={() => onSelectOrder(order.id)}\n              className={`group relative bg-slate-900/90 hover:bg-slate-850 border border-slate-800 hover:border-indigo-500/50 rounded-2xl p-5 transition-all duration-200 cursor-pointer shadow-sm hover:shadow-indigo-500/10 flex flex-col justify-between ${\n                isFacebook ? \'ring-1 ring-blue-500/20\' : \'\'\n              }`}\n            >\n              <div>\n                {/* Header: Order number + Platform */}\n                <div className=\"flex items-center justify-between mb-3\">\n                  <div className=\"flex items-center space-x-2.5\">\n                    <div className=\"p-2 rounded-xl bg-slate-800/80 group-hover:scale-105 transition-transform\">\n                      {getPlatformIcon(order.platform)}\n                    </div>\n                    <div>\n                      <span className=\"text-[11px] font-bold uppercase tracking-wider text-slate-400\">\n                        Order {order.orderNumber}\n                      </span>\n                      <h3 className=\"font-bold text-slate-100 text-sm group-hover:text-indigo-300 transition-colors\">\n                        {order.title}\n                      </h3>\n                    </div>\n                  </div>\n                  <span className={`px-2 py-0.5 text-[10px] font-semibold uppercase rounded-md border ${getPlatformBadge(order.platform)}`}>\n                    {order.platform}\n                  </span>\n                </div>\n\n                {/* Description */}\n                <p className=\"text-slate-400 text-xs leading-relaxed mb-4\">\n                  {order.description}\n                </p>\n\n                {/* Strict Tag Notice if Facebook */}\n                {isFacebook && (\n                  <div className=\"mb-4 p-2.5 rounded-xl bg-blue-950/40 border border-blue-800/40 text-[11px] text-blue-200/90 leading-tight\">\n                    <strong className=\"text-blue-300 font-semibold block mb-0.5\">\342\232\240\357\270\217 Quy t\341\272\257c Facebook:</strong>\n                    Ch\341\273\211 ch\341\272\241y Workshop (WS), tone trung l\341\272\255p, khi\303\252m t\341\273\221n & ph\303\242n t\303\255ch \304\221a chi\341\273\201u cho c\341\272\243 2 b\303\252n.\n                  </div>\n                )}\n\n                {/* Tone Guideline Preview */}\n                <div className=\"p-2.5 rounded-xl bg-slate-950/60 border border-slate-800/80 text-[11px] text-slate-300 mb-4\">\n                  <span className=\"text-slate-500 font-medium block text-[10px] uppercase mb-0.5\">\n                    Tone & Mood chu\341\272\251n:\n                  </span>\n                  <span className=\"italic text-slate-300 line-clamp-2\">\"{order.toneGuideline}\"</span>\n                </div>\n              </div>\n\n              {/* Action Button */}\n              <div className=\"pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-indigo-400 group-hover:text-indigo-300\">\n                <span className=\"flex items-center gap-1\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  M\341\273\237 Studio T\341\272\241o Order {order.orderNumber}\n                </span>\n                <ArrowRight className=\"w-4 h-4 transform group-hover:translate-x-1 transition-transform\" />\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }
