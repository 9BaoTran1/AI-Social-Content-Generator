          text: "                <h3 className={`text-sm font-bold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  S\341\272\265n s\303\240ng t\341\272\241o n\341\273\231i dung chuy\341\273\203n \304\221\341\273\225i"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
