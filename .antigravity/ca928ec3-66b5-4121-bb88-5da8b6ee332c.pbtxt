  file_change {
    absolute_path_uri: "file:///src/components/GeneratorWorkbench.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { ProgramItem, OrderType, OrderMeta, GeneratedContent } from \'../types\';\nimport { ORDERS_METADATA } from \'../data/defaultPrograms\';\nimport {\n  Sparkles,\n  Copy,\n  Check,\n  Upload,\n  Image as ImageIcon,\n  AlertTriangle,\n  RefreshCw,\n  FileText,\n  Layers,\n  ChevronDown,\n  UserCheck,\n  Sliders,\n  Smartphone,\n  Share2,\n  Heart,\n  MessageCircle,\n  Wand2,\n  ExternalLink,\n  ChevronRight,\n  ShieldAlert,\n  Info\n} from \'lucide-react\';\nimport { saveHistoryItem } from \'../lib/storage\';\n\ninterface GeneratorWorkbenchProps {\n  programs: ProgramItem[];\n  initialOrderType?: OrderType;\n  onNavigateToPrograms: () => void;\n}\n\nconst QUICK_IDEAS = [\n  {\n    label: \'Kh\341\273\247ng ho\341\272\243ng 25 tu\341\273\225i\',\n    orderType: \'order_1\' as OrderType,\n    text: \'Clip n\303\263i v\341\273\201 c\341\272\243m gi\303\241c kh\341\273\247ng ho\341\272\243ng tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng t\341\273\261 tin v\341\273\201 chuy\303\252n m\303\264n, li\303\252n t\341\273\245c so s\303\241nh v\341\273\233i b\341\272\241n b\303\250 mua nh\303\240 mua xe tr\303\252n MXH.\',\n  },\n  {\n    label: \'S\341\272\277p vs Gen Z (Facebook)\',\n    orderType: \'order_2\' as OrderType,\n    text: \'B\303\240i vi\341\272\277t v\341\273\201 t\303\254nh hu\341\273\221ng qu\341\272\243n l\303\275 giao vi\341\273\207c nh\306\260ng nh\303\242n s\341\273\261 Gen Z l\303\240m \304\221\341\273\221i ph\303\263, trong khi nh\303\242n s\341\273\261 c\341\272\243m th\341\272\245y s\341\272\277p micromanage v\303\240 kh\303\264ng t\341\272\241o kh\303\264ng gian ph\303\241t tri\341\273\203n.\',\n  },\n  {\n    label: \'Ki\341\273\207t s\341\273\251c & M\341\272\245t h\306\260\341\273\233ng (Threads)\',\n    orderType: \'order_4\' as OrderType,\n    text: \'T\303\242m s\341\273\261 c\341\273\247a m\341\273\231t b\341\272\241n \304\221i l\303\240m 4 n\304\203m, b\341\273\201 ngo\303\240i \341\273\225n \304\221\341\273\213nh nh\306\260ng b\303\252n trong r\341\273\227ng tu\341\272\277ch, m\341\273\227i s\303\241ng th\341\273\251c d\341\272\255y \304\221\341\273\201u m\341\273\207t m\341\273\217i v\303\240 kh\303\264ng bi\341\272\277t m\341\273\245c ti\303\252u ngh\341\273\201 nghi\341\273\207p ti\341\272\277p theo l\303\240 g\303\254.\',\n  },\n  {\n    label: \'L&D & \304\220\303\240o t\341\272\241o n\341\273\231i b\341\273\231 (LinkedIn)\',\n    orderType: \'order_6\' as OrderType,\n    text: \'Post ph\303\242n t\303\255ch vi\341\273\207c \304\221\303\240o t\341\272\241o nh\303\242n s\341\273\261 n\341\273\231i b\341\273\231 kh\303\264ng hi\341\273\207u qu\341\272\243, nh\303\242n vi\303\252n h\341\273\215c xong kh\303\264ng \303\241p d\341\273\245ng \304\221\306\260\341\273\243c v\303\240o th\341\273\261c t\341\272\277 khi\341\272\277n ban l\303\243nh \304\221\341\272\241o ng\341\272\247n ng\341\272\241i \304\221\341\272\247u t\306\260 ng\303\242n s\303\241ch \304\221\303\240o t\341\272\241o.\',\n  },\n];\n\nexport const GeneratorWorkbench: React.FC<GeneratorWorkbenchProps> = ({\n  programs,\n  initialOrderType = \'order_1\',\n  onNavigateToPrograms,\n}) => {\n  const [selectedOrderType, setSelectedOrderType] = useState<OrderType>(initialOrderType);\n  const [context, setContext] = useState<string>(\'\');\n  const [selectedProgramId, setSelectedProgramId] = useState<string>(\'auto\');\n  const [showAdvanced, setShowAdvanced] = useState<boolean>(false);\n  const [includeLink, setIncludeLink] = useState<boolean>(false);\n  const [customAudience, setCustomAudience] = useState<string>(\'\');\n  const [lengthPreference, setLengthPreference] = useState<\'short\' | \'medium\' | \'deep\'>(\'medium\');\n\n  // Result Active Tab: \'variations\' | \'dm_script\' | \'preview\'\n  const [resultTab, setResultTab] = useState<\'variations\' | \'dm_script\' | \'preview\'>(\'variations\');\n  const [activeVariationIndex, setActiveVariationIndex] = useState<number>(0);\n\n  // Image Upload state\n  const [screenshotBase64, setScreenshotBase64] = useState<string | null>(null);\n  const [imagePreview, setImagePreview] = useState<string | null>(null);\n\n  // Generation state\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [isEnhancing, setIsEnhancing] = useState<boolean>(false);\n  const [generatedResult, setGeneratedResult] = useState<GeneratedContent | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const copyWithFeedback = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const currentOrderMeta: OrderMeta =\n    ORDERS_METADATA.find((o) => o.id === selectedOrderType) || ORDERS_METADATA[0];\n\n  const isFacebook = currentOrderMeta.platform === \'Facebook\';\n\n  // Filter programs based on order restrictions\n  const filteredPrograms = programs.filter((p) => {\n    if (!p.isActive) return false;\n    if (isFacebook) return p.type === \'ws\'; // Strictly WS only for FB\n    return true;\n  });\n\n  // Auto reset program if switching to FB and CT was selected\n  useEffect(() => {\n    if (isFacebook && selectedProgramId !== \'auto\') {\n      const selected = programs.find((p) => p.id === selectedProgramId);\n      if (selected && selected.type === \'ct\') {\n        setSelectedProgramId(\'auto\');\n      }\n    }\n  }, [selectedOrderType, isFacebook, selectedProgramId, programs]);\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      if (file.size > 5 * 1024 * 1024) {\n        setError(\'K\303\255ch th\306\260\341\273\233c \341\272\243nh qu\303\241 l\341\273\233n. Vui l\303\262ng ch\341\273\215n \341\272\243nh d\306\260\341\273\233i 5MB.\');\n        return;\n      }\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        const result = reader.result as string;\n        setScreenshotBase64(result);\n        setImagePreview(result);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const removeImage = () => {\n    setScreenshotBase64(null);\n    setImagePreview(null);\n  };\n\n  const handleEnhance = () => {\n    if (!context.trim()) return;\n    setIsEnhancing(true);\n    setTimeout(() => {\n      setContext((prev) => {\n        const trimmed = prev.trim();\n        return `${trimmed}\\n\\n[G\303\263c ti\341\272\277p c\341\272\255n g\341\273\243i \303\275]: Nh\341\272\245n m\341\272\241nh s\341\273\261 \304\221\341\273\223ng c\341\272\243m v\341\273\233i n\341\273\227i b\304\203n kho\304\203n v\341\273\201 n\304\203ng l\341\273\261c th\341\272\255t s\341\273\261, ph\303\242n t\303\255ch nguy\303\252n nh\303\242n g\341\273\221c r\341\273\205 v\303\240 g\341\273\243i m\341\273\237 l\303\240m b\303\240i tr\341\272\257c nghi\341\273\207m/tham v\341\272\245n 1-1 \304\221\341\273\203 \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n r\303\265 r\303\240ng.`;\n      });\n      setIsEnhancing(false);\n    }, 400);\n  };\n\n  const handleGenerate = async () => {\n    if (!context.trim() && !screenshotBase64) {\n      setError(\'Vui l\303\262ng nh\341\272\255p m\303\264 t\341\272\243 ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng ho\341\272\267c t\341\272\243i \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh.\');\n      return;\n    }\n\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\'/api/generate-order\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          orderType: selectedOrderType,\n          context: context.trim(),\n          screenshotBase64,\n          selectedProgramId: selectedProgramId === \'auto\' ? undefined : selectedProgramId,\n          programs: filteredPrograms,\n          options: {\n            includeLink,\n            customAudience: customAudience.trim() || undefined,\n            lengthPreference,\n          },\n        }),\n      });\n\n      const data = await response.json();\n      if (!response.ok || !data.success) {\n        throw new Error(data.error || \'Kh\303\264ng th\341\273\203 t\341\272\241o n\341\273\231i dung. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n      }\n\n      const result: GeneratedContent = {\n        id: `gen-${Date.now()}`,\n        orderId: selectedOrderType,\n        orderTitle: currentOrderMeta.title,\n        platform: currentOrderMeta.platform,\n        programId: data.data.selectedProgramId,\n        programTitle: data.data.selectedProgramTitle,\n        programType: data.data.selectedProgramType,\n        primaryContent: data.data.primaryContent,\n        variations: data.data.variations || [],\n        dmFollowUpScript: data.data.dmFollowUpScript,\n        rationale: data.data.rationale,\n        platformNotes: data.data.platformNotes,\n        createdAt: new Date().toISOString(),\n      };\n\n      setGeneratedResult(result);\n      setActiveVariationIndex(0);\n      setResultTab(\'variations\');\n      saveHistoryItem(result);\n    } catch (err: any) {\n      setError(err.message || \'L\341\273\227i x\341\273\255 l\303\275. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* 1. Clear Order Selector (Single Focused Bar) */}\n      <div className=\"bg-slate-900/90 border border-slate-800/90 rounded-2xl p-4 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-3\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-bold text-slate-200\">B\306\260\341\273\233c 1: Ch\341\273\215n N\341\273\201n T\341\272\243ng & L\341\273\207nh Order</span>\n            <span className=\"text-[11px] text-slate-400\">({ORDERS_METADATA.length} l\341\273\207nh chu\341\272\251n h\303\263a)</span>\n          </div>\n          {isFacebook && (\n            <span className=\"text-[11px] font-medium text-amber-300/90 flex items-center gap-1\">\n              <ShieldAlert className=\"w-3.5 h-3.5 text-amber-400\" />\n              <span>Facebook ch\341\273\211 ch\341\272\241y Workshop (WS) & tone trung l\341\272\255p</span>\n            </span>\n          )}\n        </div>\n\n        {/* Clean Segmented Buttons for 7 Orders */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2\">\n          {ORDERS_METADATA.map((order) => {\n            const isSelected = selectedOrderType === order.id;\n            return (\n              <button\n                key={order.id}\n                onClick={() => {\n                  setSelectedOrderType(order.id);\n                  setError(null);\n                }}\n                className={`text-left p-2.5 rounded-xl border transition-all flex flex-col justify-between ${\n                  isSelected\n                    ? \'bg-indigo-600 text-white border-indigo-500 shadow-sm\'\n                    : \'bg-slate-950/70 text-slate-300 border-slate-800 hover:border-slate-700 hover:bg-slate-850\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between w-full mb-1\">\n                  <span\n                    className={`text-[10px] font-bold uppercase tracking-wider ${\n                      isSelected ? \'text-indigo-200\' : \'text-slate-400\'\n                    }`}\n                  >\n                    Order {order.orderNumber}\n                  </span>\n                  <span\n                    className={`text-[10px] px-1.5 py-0.2 rounded font-medium ${\n                      isSelected ? \'bg-indigo-700/80 text-white\' : \'bg-slate-800 text-slate-400\'\n                    }`}\n                  >\n                    {order.platform}\n                  </span>\n                </div>\n                <span className=\"text-xs font-semibold line-clamp-1\">\n                  {order.title}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. Main 2-Column Cockpit */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Left Column: Form Inputs (5 Cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 space-y-4 shadow-sm\">\n            {/* Active Order Summary Note */}\n            <div className=\"bg-slate-950/80 border border-slate-800/80 rounded-xl p-3 text-xs space-y-1\">\n              <div className=\"flex items-center justify-between text-slate-300 font-semibold\">\n                <span>M\341\273\245c ti\303\252u Order {currentOrderMeta.orderNumber}: {currentOrderMeta.title}</span>\n                <span className=\"text-[10px] text-indigo-400 font-normal\">{currentOrderMeta.platform}</span>\n              </div>\n              <p className=\"text-slate-400 text-[11px] leading-relaxed\">\n                {currentOrderMeta.description}\n              </p>\n            </div>\n\n            {/* Target Workshop / Program Selector */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-xs font-semibold text-slate-200 flex items-center gap-1.5\">\n                  <Layers className=\"w-3.5 h-3.5 text-indigo-400\" />\n                  <span>Workshop / Ch\306\260\306\241ng tr\303\254nh \304\221\303\255ch</span>\n                </label>\n                <button\n                  type=\"button\"\n                  onClick={onNavigateToPrograms}\n                  className=\"text-[11px] text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n                >\n                  <span>Kho ({programs.length})</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </button>\n              </div>\n\n              <div className=\"relative\">\n                <select\n                  value={selectedProgramId}\n                  onChange={(e) => setSelectedProgramId(e.target.value)}\n                  className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 appearance-none cursor-pointer\"\n                >\n                  <option value=\"auto\">\342\234\250 AI t\341\273\261 \304\221\341\273\231ng ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t v\341\273\233i ng\341\273\257 c\341\272\243nh</option>\n                  <optgroup label={isFacebook ? \'Workshops Kh\341\272\243 D\341\273\245ng (FB ch\341\273\211 ch\341\272\241y WS)\' : \'Workshops & Ch\306\260\306\241ng Tr\303\254nh\'}>\n                    {filteredPrograms.map((p) => (\n                      <option key={p.id} value={p.id}>\n                        [{p.type === \'ws\' ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}] {p.title}\n                      </option>\n                    ))}\n                  </optgroup>\n                </select>\n                <ChevronDown className=\"w-4 h-4 text-slate-400 absolute right-3 top-2.5 pointer-events-none\" />\n              </div>\n            </div>\n\n            {/* Input Context & Prompt */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-xs font-semibold text-slate-200\">\n                  \303\235 t\306\260\341\273\237ng / Ng\341\273\257 c\341\272\243nh clip / N\341\273\227i \304\221au ng\306\260\341\273\235i xem <span className=\"text-rose-400\">*</span>\n                </label>\n                {context && (\n                  <button\n                    type=\"button\"\n                    onClick={handleEnhance}\n                    disabled={isEnhancing}\n                    className=\"text-[11px] font-medium text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n                  >\n                    <Wand2 className=\"w-3 h-3\" />\n                    <span>{isEnhancing ? \'\304\220ang th\303\252m...\' : \'T\341\273\221i \306\260u \303\275 t\306\260\341\273\237ng\'}</span>\n                  </button>\n                )}\n              </div>\n\n              <textarea\n                value={context}\n                onChange={(e) => setContext(e.target.value)}\n                placeholder=\"V\303\255 d\341\273\245: Clip n\303\263i v\341\273\201 n\341\273\227i s\341\273\243 tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng t\341\273\261 tin, mu\341\273\221n t\303\254m l\341\273\231 tr\303\254nh \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n r\303\265 r\303\240ng...\"\n                rows={4}\n                className=\"w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 leading-relaxed font-sans\"\n              />\n\n              {/* Quick Idea Chips */}\n              <div className=\"flex items-center gap-1.5 overflow-x-auto pt-1 no-scrollbar\">\n                <span className=\"text-[10px] text-slate-500 whitespace-nowrap\">\303\235 t\306\260\341\273\237ng nhanh:</span>\n                {QUICK_IDEAS.map((idea, i) => (\n                  <button\n                    key={i}\n                    type=\"button\"\n                    onClick={() => {\n                      setSelectedOrderType(idea.orderType);\n                      setContext(idea.text);\n                    }}\n                    className=\"px-2 py-0.5 rounded-md text-[10px] bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800/80 whitespace-nowrap transition-colors\"\n                  >\n                    {idea.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Collapsible Advanced Settings (Keeps UI clean!) */}\n            <div className=\"border-t border-slate-800/80 pt-3\">\n              <button\n                type=\"button\"\n                onClick={() => setShowAdvanced(!showAdvanced)}\n                className=\"w-full flex items-center justify-between text-xs text-slate-400 hover:text-slate-200 py-1\"\n              >\n                <span className=\"flex items-center gap-1.5 font-medium\">\n                  <Sliders className=\"w-3.5 h-3.5 text-slate-500\" />\n                  T\303\271y ch\341\273\215n n\303\242ng cao (\341\272\242nh ch\341\273\245p, \304\220\341\273\231 d\303\240i, Link)\n                </span>\n                <ChevronDown\n                  className={`w-3.5 h-3.5 transform transition-transform ${\n                    showAdvanced ? \'rotate-180\' : \'\'\n                  }`}\n                />\n              </button>\n\n              {showAdvanced && (\n                <div className=\"mt-3 space-y-3 p-3 bg-slate-950/60 rounded-xl border border-slate-800/80\">\n                  {/* Image Upload */}\n                  <div>\n                    <label className=\"text-[11px] font-medium text-slate-400 block mb-1\">\n                      \341\272\242nh ch\341\273\245p m\303\240n h\303\254nh clip/post (AI s\341\272\275 \304\221\341\273\215c text & bi\341\273\203u c\341\272\243m):\n                    </label>\n                    {imagePreview ? (\n                      <div className=\"flex items-center justify-between p-2 bg-slate-900 rounded-lg border border-slate-800\">\n                        <div className=\"flex items-center gap-2\">\n                          <img\n                            src={imagePreview}\n                            alt=\"Preview\"\n                            className=\"w-10 h-10 object-cover rounded border border-slate-700\"\n                          />\n                          <span className=\"text-xs text-slate-300\">\304\220\303\243 n\341\272\241p 1 \341\272\243nh</span>\n                        </div>\n                        <button\n                          type=\"button\"\n                          onClick={removeImage}\n                          className=\"text-[11px] text-rose-400 hover:text-rose-300\"\n                        >\n                          X\303\263a\n                        </button>\n                      </div>\n                    ) : (\n                      <label className=\"flex items-center justify-center p-2.5 border border-dashed border-slate-800 hover:border-slate-700 rounded-lg bg-slate-900/50 cursor-pointer text-xs text-slate-400 hover:text-slate-200 transition-all\">\n                        <Upload className=\"w-3.5 h-3.5 mr-1.5\" />\n                        <span>T\341\272\243i \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh (T\341\273\221i \304\221a 5MB)</span>\n                        <input\n                          type=\"file\"\n                          accept=\"image/*\"\n                          onChange={handleImageUpload}\n                          className=\"hidden\"\n                        />\n                      </label>\n                    )}\n                  </div>\n\n                  {/* Length Preference */}\n                  <div>\n                    <label className=\"text-[11px] font-medium text-slate-400 block mb-1\">\n                      \304\220\341\273\231 d\303\240i n\341\273\231i dung:\n                    </label>\n                    <div className=\"grid grid-cols-3 gap-1.5\">\n                      {[\n                        { id: \'short\', label: \'Ng\341\272\257n g\341\273\215n\' },\n                        { id: \'medium\', label: \'Ti\303\252u chu\341\272\251n\' },\n                        { id: \'deep\', label: \'S\303\242u s\341\272\257c\' },\n                      ].map((l) => (\n                        <button\n                          key={l.id}\n                          type=\"button\"\n                          onClick={() => setLengthPreference(l.id as any)}\n                          className={`py-1 text-xs rounded-lg border transition-all ${\n                            lengthPreference === l.id\n                              ? \'bg-indigo-600/30 text-indigo-300 border-indigo-500 font-semibold\'\n                              : \'bg-slate-900 text-slate-400 border-slate-800\'\n                          }`}\n                        >\n                          {l.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Link Checkbox */}\n                  <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer pt-1\">\n                    <input\n                      type=\"checkbox\"\n                      checked={includeLink}\n                      onChange={(e) => setIncludeLink(e.target.checked)}\n                      className=\"rounded bg-slate-900 border-slate-700 text-indigo-600 focus:ring-indigo-500\"\n                    />\n                    <span>G\341\272\257n k\303\250m link Form / Test v\303\240o comment</span>\n                  </label>\n\n                  {/* Custom Audience */}\n                  <div>\n                    <label className=\"text-[11px] font-medium text-slate-400 block mb-1\">\n                      \304\220\341\273\221i t\306\260\341\273\243ng \304\221\341\273\231c gi\341\272\243 c\341\273\245 th\341\273\203:\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={customAudience}\n                      onChange={(e) => setCustomAudience(e.target.value)}\n                      placeholder=\"V\303\255 d\341\273\245: Ng\306\260\341\273\235i \304\221i l\303\240m 22-30 tu\341\273\225i, loay hoay \304\221\341\273\213nh h\306\260\341\273\233ng...\"\n                      className=\"w-full bg-slate-900 border border-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n                    />\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Error Display */}\n            {error && (\n              <div className=\"p-3 rounded-xl bg-rose-950/60 border border-rose-800/80 text-xs text-rose-300 flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-rose-400 flex-shrink-0\" />\n                <span>{error}</span>\n              </div>\n            )}\n\n            {/* Primary Action Button (The Clear Focal Point!) */}\n            <button\n              onClick={handleGenerate}\n              disabled={isLoading}\n              className=\"w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center space-x-2 disabled:opacity-50 cursor-pointer\"\n            >\n              {isLoading ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin text-white\" />\n                  <span>AI \304\220ang Ph\303\242n T\303\255ch & S\341\272\243n Xu\341\272\245t Content...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>T\341\272\241o 3 Ph\306\260\306\241ng \303\201n & K\341\273\213ch B\341\272\243n DM</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Right Column: Output Workbench (7 Cols) */}\n        <div className=\"lg:col-span-7 space-y-4\">\n          {generatedResult ? (\n            <div className=\"bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 space-y-4 shadow-sm\">\n              {/* Header: Result Info & Tabs */}\n              <div className=\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4\">\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-xs font-bold text-white\">\n                      Order {currentOrderMeta.orderNumber}: {generatedResult.orderTitle}\n                    </span>\n                    <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium\">\n                      {generatedResult.platform}\n                    </span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                    M\341\273\245c ti\303\252u: <strong className=\"text-slate-300\">{generatedResult.programTitle}</strong>\n                  </p>\n                </div>\n\n                {/* Clean View Tabs */}\n                <div className=\"flex bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs\">\n                  <button\n                    onClick={() => setResultTab(\'variations\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all ${\n                      resultTab === \'variations\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : \'text-slate-400 hover:text-slate-200\'\n                    }`}\n                  >\n                    3 Ph\306\260\306\241ng \303\201n\n                  </button>\n                  <button\n                    onClick={() => setResultTab(\'dm_script\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all ${\n                      resultTab === \'dm_script\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : \'text-slate-400 hover:text-slate-200\'\n                    }`}\n                  >\n                    K\341\273\213ch B\341\272\243n DM 1-1\n                  </button>\n                  <button\n                    onClick={() => setResultTab(\'preview\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all ${\n                      resultTab === \'preview\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : \'text-slate-400 hover:text-slate-200\'\n                    }`}\n                  >\n                    Xem Tr\306\260\341\273\233c\n                  </button>\n                </div>\n              </div>\n\n              {/* TAB 1: 3 Content Variations */}\n              {resultTab === \'variations\' && (\n                <div className=\"space-y-3\">\n                  {generatedResult.variations.map((variation, idx) => (\n                    <div\n                      key={idx}\n                      className=\"bg-slate-950 border border-slate-800/90 rounded-xl p-4 space-y-2 hover:border-slate-700 transition-colors\"\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-bold text-indigo-300\">\n                          Ph\306\260\306\241ng \303\241n {idx + 1}\n                        </span>\n                        <button\n                          onClick={() => copyWithFeedback(variation, `var-${idx}`)}\n                          className=\"px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 transition-all flex items-center gap-1.5\"\n                        >\n                          {copiedId === `var-${idx}` ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-400\" />\n                              <span className=\"text-emerald-400 font-semibold\">\304\220\303\243 sao ch\303\251p</span>\n                            </>\n                          ) : (\n                            <>\n                              <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                              <span>Sao ch\303\251p</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n\n                      <p className=\"text-xs text-slate-200 leading-relaxed whitespace-pre-line font-sans select-all\">\n                        {variation}\n                      </p>\n\n                      <div className=\"text-[10px] text-slate-500 pt-1 flex items-center justify-between border-t border-slate-900\">\n                        <span>{variation.length} k\303\275 t\341\273\261</span>\n                        <span>Tone chu\341\272\251n {generatedResult.platform}</span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n\n              {/* TAB 2: DM 1-1 Inbound Script */}\n              {resultTab === \'dm_script\' && (\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center justify-between bg-slate-950/60 p-3 rounded-xl border border-slate-800\">\n                    <span className=\"text-xs text-slate-300\">\n                      Quy tr\303\254nh 3 b\306\260\341\273\233c x\341\273\255 l\303\275 khi kh\303\241ch h\303\240ng comment ho\341\272\267c inbox xin link/test\n                    </span>\n                    <button\n                      onClick={() => {\n                        const fullScript = `B\306\257\341\273\232C 1 (\304\220\341\273\223ng c\341\272\243m):\\n${generatedResult.dmFollowUpScript.step1_empathy}\\n\\nB\306\257\341\273\232C 2 (C\303\242u h\341\273\217i \304\221\303\240o s\303\242u):\\n${generatedResult.dmFollowUpScript.step2_qualifyQuestion}\\n\\nB\306\257\341\273\232C 3 (G\341\273\255i link test & m\341\273\235i tham gia):\\n${generatedResult.dmFollowUpScript.step3_inviteLink}`;\n                        copyWithFeedback(fullScript, \'full-dm\');\n                      }}\n                      className=\"px-3 py-1 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-all flex items-center gap-1.5\"\n                    >\n                      {copiedId === \'full-dm\' ? (\n                        <>\n                          <Check className=\"w-3.5 h-3.5 text-white\" />\n                          <span>\304\220\303\243 ch\303\251p to\303\240n b\341\273\231</span>\n                        </>\n                      ) : (\n                        <>\n                          <Copy className=\"w-3.5 h-3.5\" />\n                          <span>Sao ch\303\251p c\341\272\243 3 b\306\260\341\273\233c</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n                  {/* Step 1 */}\n                  <div className=\"bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-bold text-slate-200\">\n                        B\306\260\341\273\233c 1: Ch\303\240o \304\221\303\263n & \304\220\341\273\223ng c\341\272\243m (T\341\272\241o kh\303\264ng gian an to\303\240n)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step1_empathy,\n                            \'step-1\'\n                          )\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        {copiedId === \'step-1\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/80 p-2.5 rounded-lg border border-slate-800/80 select-all\">\n                      \"{generatedResult.dmFollowUpScript.step1_empathy}\"\n                    </p>\n                  </div>\n\n                  {/* Step 2 */}\n                  <div className=\"bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-bold text-slate-200\">\n                        B\306\260\341\273\233c 2: C\303\242u h\341\273\217i \304\221\303\240o s\303\242u x\303\241c \304\221\341\273\213nh nhu c\341\272\247u (Qualifying)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step2_qualifyQuestion,\n                            \'step-2\'\n                          )\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        {copiedId === \'step-2\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/80 p-2.5 rounded-lg border border-slate-800/80 select-all\">\n                      \"{generatedResult.dmFollowUpScript.step2_qualifyQuestion}\"\n                    </p>\n                  </div>\n\n                  {/* Step 3 */}\n                  <div className=\"bg-slate-950 border border-slate-800 rounded-xl p-3.5 space-y-1.5\">\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className=\"font-bold text-slate-200\">\n                        B\306\260\341\273\233c 3: L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / Form tham v\341\272\245n 1-1\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step3_inviteLink,\n                            \'step-3\'\n                          )\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        {copiedId === \'step-3\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/80 p-2.5 rounded-lg border border-slate-800/80 select-all\">\n                      \"{generatedResult.dmFollowUpScript.step3_inviteLink}\"\n                    </p>\n                  </div>\n                </div>\n              )}\n\n              {/* TAB 3: Real Platform Mockup */}\n              {resultTab === \'preview\' && (\n                <div className=\"space-y-3\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs text-slate-400\">Ch\341\273\215n ph\306\260\306\241ng \303\241n hi\341\273\203n th\341\273\213:</span>\n                    <div className=\"flex gap-1\">\n                      {generatedResult.variations.map((_, i) => (\n                        <button\n                          key={i}\n                          onClick={() => setActiveVariationIndex(i)}\n                          className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-colors ${\n                            activeVariationIndex === i\n                              ? \'bg-indigo-600 text-white\'\n                              : \'bg-slate-950 text-slate-400 hover:text-slate-200\'\n                          }`}\n                        >\n                          M\341\272\253u {i + 1}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  <div className=\"rounded-xl border border-slate-800 bg-slate-950 p-4 max-w-lg mx-auto space-y-3\">\n                    <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className=\"w-8 h-8 rounded-full bg-indigo-600 flex items-center justify-center text-xs font-bold text-white\">\n                          {generatedResult.platform.slice(0, 2).toUpperCase()}\n                        </div>\n                        <div>\n                          <span className=\"text-xs font-semibold text-white block\">Chuy\303\252n Gia \304\220\341\273\213nh H\306\260\341\273\233ng</span>\n                          <span className=\"text-[10px] text-slate-500\">{generatedResult.platform} \342\200\242 V\341\273\253a xong</span>\n                        </div>\n                      </div>\n                    </div>\n\n                    <p className=\"text-xs text-slate-200 leading-relaxed whitespace-pre-line select-all p-2 rounded bg-slate-900/60\">\n                      {generatedResult.variations[activeVariationIndex]}\n                    </p>\n\n                    <div className=\"flex items-center justify-between text-xs text-slate-400 pt-2 border-t border-slate-800\">\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.variations[activeVariationIndex],\n                            \'preview-copy\'\n                          )\n                        }\n                        className=\"text-xs text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1\"\n                      >\n                        <Copy className=\"w-3 h-3\" />\n                        <span>{copiedId === \'preview-copy\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p m\341\272\253u n\303\240y\'}</span>\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          ) : (\n            /* Clean Empty State */\n            <div className=\"h-full min-h-[380px] rounded-2xl border border-slate-800/80 bg-slate-900/40 p-8 flex flex-col items-center justify-center text-center space-y-3\">\n              <div className=\"w-12 h-12 rounded-xl bg-slate-850 border border-slate-800 text-indigo-400 flex items-center justify-center\">\n                <Sparkles className=\"w-5 h-5\" />\n              </div>\n              <div className=\"max-w-sm space-y-1\">\n                <h3 className=\"text-sm font-bold text-slate-200\">\n                  S\341\272\265n s\303\240ng t\341\272\241o n\341\273\231i dung chuy\341\273\203n \304\221\341\273\225i\n                </h3>\n                <p className=\"text-xs text-slate-400 leading-relaxed\">\n                  Nh\341\272\255p \303\275 t\306\260\341\273\237ng b\303\240i \304\221\304\203ng \341\273\237 c\341\273\231t b\303\252n tr\303\241i v\303\240 b\341\272\245m <strong>\"T\341\272\241o 3 Ph\306\260\306\241ng \303\201n & K\341\273\213ch B\341\272\243n DM\"</strong> \304\221\341\273\203 nh\341\272\255n ngay k\341\272\277t qu\341\272\243.\n                </p>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ProgramItem, OrderType, OrderMeta, GeneratedContent, ThemeMode } from \'../types\';\nimport { ORDERS_METADATA } from \'../data/defaultPrograms\';\nimport {\n  Sparkles,\n  Copy,\n  Check,\n  Upload,\n  Image as ImageIcon,\n  AlertTriangle,\n  RefreshCw,\n  FileText,\n  Layers,\n  ChevronDown,\n  UserCheck,\n  Sliders,\n  Smartphone,\n  Share2,\n  Heart,\n  MessageCircle,\n  Wand2,\n  ExternalLink,\n  ChevronRight,\n  ShieldAlert,\n  Info\n} from \'lucide-react\';\nimport { saveHistoryItem } from \'../lib/storage\';\n\ninterface GeneratorWorkbenchProps {\n  programs: ProgramItem[];\n  initialOrderType?: OrderType;\n  onNavigateToPrograms: () => void;\n  theme?: ThemeMode;\n}\n\nconst QUICK_IDEAS = [\n  {\n    label: \'Kh\341\273\247ng ho\341\272\243ng 25 tu\341\273\225i\',\n    orderType: \'order_1\' as OrderType,\n    text: \'Clip n\303\263i v\341\273\201 c\341\272\243m gi\303\241c kh\341\273\247ng ho\341\272\243ng tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng t\341\273\261 tin v\341\273\201 chuy\303\252n m\303\264n, li\303\252n t\341\273\245c so s\303\241nh v\341\273\233i b\341\272\241n b\303\250 mua nh\303\240 mua xe tr\303\252n MXH.\',\n  },\n  {\n    label: \'S\341\272\277p vs Gen Z (Facebook)\',\n    orderType: \'order_2\' as OrderType,\n    text: \'B\303\240i vi\341\272\277t v\341\273\201 t\303\254nh hu\341\273\221ng qu\341\272\243n l\303\275 giao vi\341\273\207c nh\306\260ng nh\303\242n s\341\273\261 Gen Z l\303\240m \304\221\341\273\221i ph\303\263, trong khi nh\303\242n s\341\273\261 c\341\272\243m th\341\272\245y s\341\272\277p micromanage v\303\240 kh\303\264ng t\341\272\241o kh\303\264ng gian ph\303\241t tri\341\273\203n.\',\n  },\n  {\n    label: \'Ki\341\273\207t s\341\273\251c & M\341\272\245t h\306\260\341\273\233ng (Threads)\',\n    orderType: \'order_4\' as OrderType,\n    text: \'T\303\242m s\341\273\261 c\341\273\247a m\341\273\231t b\341\272\241n \304\221i l\303\240m 4 n\304\203m, b\341\273\201 ngo\303\240i \341\273\225n \304\221\341\273\213nh nh\306\260ng b\303\252n trong r\341\273\227ng tu\341\272\277ch, m\341\273\227i s\303\241ng th\341\273\251c d\341\272\255y \304\221\341\273\201u m\341\273\207t m\341\273\217i v\303\240 kh\303\264ng bi\341\272\277t m\341\273\245c ti\303\252u ngh\341\273\201 nghi\341\273\207p ti\341\272\277p theo l\303\240 g\303\254.\',\n  },\n  {\n    label: \'L&D & \304\220\303\240o t\341\272\241o n\341\273\231i b\341\273\231 (LinkedIn)\',\n    orderType: \'order_6\' as OrderType,\n    text: \'Post ph\303\242n t\303\255ch vi\341\273\207c \304\221\303\240o t\341\272\241o nh\303\242n s\341\273\261 n\341\273\231i b\341\273\231 kh\303\264ng hi\341\273\207u qu\341\272\243, nh\303\242n vi\303\252n h\341\273\215c xong kh\303\264ng \303\241p d\341\273\245ng \304\221\306\260\341\273\243c v\303\240o th\341\273\261c t\341\272\277 khi\341\272\277n ban l\303\243nh \304\221\341\272\241o ng\341\272\247n ng\341\272\241i \304\221\341\272\247u t\306\260 ng\303\242n s\303\241ch \304\221\303\240o t\341\272\241o.\',\n  },\n];\n\nexport const GeneratorWorkbench: React.FC<GeneratorWorkbenchProps> = ({\n  programs,\n  initialOrderType = \'order_1\',\n  onNavigateToPrograms,\n  theme = \'light\',\n}) => {\n  const isDark = theme === \'dark\';\n  const [selectedOrderType, setSelectedOrderType] = useState<OrderType>(initialOrderType);\n  const [context, setContext] = useState<string>(\'\');\n  const [selectedProgramId, setSelectedProgramId] = useState<string>(\'auto\');\n  const [showAdvanced, setShowAdvanced] = useState<boolean>(false);\n  const [includeLink, setIncludeLink] = useState<boolean>(false);\n  const [customAudience, setCustomAudience] = useState<string>(\'\');\n  const [lengthPreference, setLengthPreference] = useState<\'short\' | \'medium\' | \'deep\'>(\'medium\');\n\n  // Result Active Tab: \'variations\' | \'dm_script\' | \'preview\'\n  const [resultTab, setResultTab] = useState<\'variations\' | \'dm_script\' | \'preview\'>(\'variations\');\n  const [activeVariationIndex, setActiveVariationIndex] = useState<number>(0);\n\n  // Image Upload state\n  const [screenshotBase64, setScreenshotBase64] = useState<string | null>(null);\n  const [imagePreview, setImagePreview] = useState<string | null>(null);\n\n  // Generation state\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [isEnhancing, setIsEnhancing] = useState<boolean>(false);\n  const [generatedResult, setGeneratedResult] = useState<GeneratedContent | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const copyWithFeedback = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  const currentOrderMeta: OrderMeta =\n    ORDERS_METADATA.find((o) => o.id === selectedOrderType) || ORDERS_METADATA[0];\n\n  const isFacebook = currentOrderMeta.platform === \'Facebook\';\n\n  // Filter programs based on order restrictions\n  const filteredPrograms = programs.filter((p) => {\n    if (!p.isActive) return false;\n    if (isFacebook) return p.type === \'ws\'; // Strictly WS only for FB\n    return true;\n  });\n\n  // Auto reset program if switching to FB and CT was selected\n  useEffect(() => {\n    if (isFacebook && selectedProgramId !== \'auto\') {\n      const selected = programs.find((p) => p.id === selectedProgramId);\n      if (selected && selected.type === \'ct\') {\n        setSelectedProgramId(\'auto\');\n      }\n    }\n  }, [selectedOrderType, isFacebook, selectedProgramId, programs]);\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      if (file.size > 5 * 1024 * 1024) {\n        setError(\'K\303\255ch th\306\260\341\273\233c \341\272\243nh qu\303\241 l\341\273\233n. Vui l\303\262ng ch\341\273\215n \341\272\243nh d\306\260\341\273\233i 5MB.\');\n        return;\n      }\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        const result = reader.result as string;\n        setScreenshotBase64(result);\n        setImagePreview(result);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const removeImage = () => {\n    setScreenshotBase64(null);\n    setImagePreview(null);\n  };\n\n  const handleEnhance = () => {\n    if (!context.trim()) return;\n    setIsEnhancing(true);\n    setTimeout(() => {\n      setContext((prev) => {\n        const trimmed = prev.trim();\n        return `${trimmed}\\n\\n[G\303\263c ti\341\272\277p c\341\272\255n g\341\273\243i \303\275]: Nh\341\272\245n m\341\272\241nh s\341\273\261 \304\221\341\273\223ng c\341\272\243m v\341\273\233i n\341\273\227i b\304\203n kho\304\203n v\341\273\201 n\304\203ng l\341\273\261c th\341\272\255t s\341\273\261, ph\303\242n t\303\255ch nguy\303\252n nh\303\242n g\341\273\221c r\341\273\205 v\303\240 g\341\273\243i m\341\273\237 l\303\240m b\303\240i tr\341\272\257c nghi\341\273\207m/tham v\341\272\245n 1-1 \304\221\341\273\203 \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n r\303\265 r\303\240ng.`;\n      });\n      setIsEnhancing(false);\n    }, 400);\n  };\n\n  const handleGenerate = async () => {\n    if (!context.trim() && !screenshotBase64) {\n      setError(\'Vui l\303\262ng nh\341\272\255p m\303\264 t\341\272\243 ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng ho\341\272\267c t\341\272\243i \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh.\');\n      return;\n    }\n\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\'/api/generate-order\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          orderType: selectedOrderType,\n          context: context.trim(),\n          screenshotBase64,\n          selectedProgramId: selectedProgramId === \'auto\' ? undefined : selectedProgramId,\n          programs: filteredPrograms,\n          options: {\n            includeLink,\n            customAudience: customAudience.trim() || undefined,\n            lengthPreference,\n          },\n        }),\n      });\n\n      const data = await response.json();\n      if (!response.ok || !data.success) {\n        throw new Error(data.error || \'Kh\303\264ng th\341\273\203 t\341\272\241o n\341\273\231i dung. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n      }\n\n      const result: GeneratedContent = {\n        id: `gen-${Date.now()}`,\n        orderId: selectedOrderType,\n        orderTitle: currentOrderMeta.title,\n        platform: currentOrderMeta.platform,\n        programId: data.data.selectedProgramId,\n        programTitle: data.data.selectedProgramTitle,\n        programType: data.data.selectedProgramType,\n        primaryContent: data.data.primaryContent,\n        variations: data.data.variations || [],\n        dmFollowUpScript: data.data.dmFollowUpScript,\n        rationale: data.data.rationale,\n        platformNotes: data.data.platformNotes,\n        createdAt: new Date().toISOString(),\n      };\n\n      setGeneratedResult(result);\n      setActiveVariationIndex(0);\n      setResultTab(\'variations\');\n      saveHistoryItem(result);\n    } catch (err: any) {\n      setError(err.message || \'L\341\273\227i x\341\273\255 l\303\275. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* 1. Clear Order Selector (Single Focused Bar) */}\n      <div\n        className={`rounded-2xl p-4 shadow-sm border transition-colors ${\n          isDark\n            ? \'bg-slate-900/90 border-slate-800/90\'\n            : \'bg-white border-slate-200\'\n        }`}\n      >\n        <div className=\"flex items-center justify-between mb-3\">\n          <div className=\"flex items-center gap-2\">\n            <span className={`text-xs font-bold ${isDark ? \'text-slate-200\' : \'text-slate-900\'}`}>\n              B\306\260\341\273\233c 1: Ch\341\273\215n N\341\273\201n T\341\272\243ng & L\341\273\207nh Order\n            </span>\n            <span className={`text-[11px] ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              ({ORDERS_METADATA.length} l\341\273\207nh chu\341\272\251n h\303\263a)\n            </span>\n          </div>\n          {isFacebook && (\n            <span\n              className={`text-[11px] font-medium flex items-center gap-1 px-2 py-0.5 rounded-lg ${\n                isDark ? \'text-amber-300/90 bg-amber-950/40\' : \'text-amber-800 bg-amber-50 border border-amber-200\'\n              }`}\n            >\n              <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500\" />\n              <span>Facebook ch\341\273\211 ch\341\272\241y Workshop (WS) & tone trung l\341\272\255p</span>\n            </span>\n          )}\n        </div>\n\n        {/* Clean Segmented Buttons for 7 Orders */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2\">\n          {ORDERS_METADATA.map((order) => {\n            const isSelected = selectedOrderType === order.id;\n            return (\n              <button\n                key={order.id}\n                onClick={() => {\n                  setSelectedOrderType(order.id);\n                  setError(null);\n                }}\n                className={`text-left p-2.5 rounded-xl border transition-all flex flex-col justify-between cursor-pointer ${\n                  isSelected\n                    ? \'bg-indigo-600 text-white border-indigo-500 shadow-sm\'\n                    : isDark\n                    ? \'bg-slate-950/70 text-slate-300 border-slate-800 hover:border-slate-700 hover:bg-slate-850\'\n                    : \'bg-slate-50/90 text-slate-700 border-slate-200/90 hover:border-slate-300 hover:bg-white\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between w-full mb-1\">\n                  <span\n                    className={`text-[10px] font-bold uppercase tracking-wider ${\n                      isSelected ? \'text-indigo-200\' : isDark ? \'text-slate-400\' : \'text-slate-500\'\n                    }`}\n                  >\n                    Order {order.orderNumber}\n                  </span>\n                  <span\n                    className={`text-[10px] px-1.5 py-0.2 rounded font-medium ${\n                      isSelected\n                        ? \'bg-indigo-700/80 text-white\'\n                        : isDark\n                        ? \'bg-slate-800 text-slate-400\'\n                        : \'bg-slate-200/80 text-slate-600\'\n                    }`}\n                  >\n                    {order.platform}\n                  </span>\n                </div>\n                <span\n                  className={`text-xs font-semibold line-clamp-1 ${\n                    isSelected ? \'text-white\' : isDark ? \'text-slate-200\' : \'text-slate-800\'\n                  }`}\n                >\n                  {order.title}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. Main 2-Column Cockpit */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Left Column: Form Inputs (5 Cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div\n            className={`border rounded-2xl p-5 space-y-4 shadow-sm transition-colors ${\n              isDark\n                ? \'bg-slate-900/90 border-slate-800/90\'\n                : \'bg-white border-slate-200\'\n            }`}\n          >\n            {/* Active Order Summary Note */}\n            <div\n              className={`border rounded-xl p-3 text-xs space-y-1 ${\n                isDark\n                  ? \'bg-slate-950/80 border-slate-800/80\'\n                  : \'bg-indigo-50/50 border-indigo-100/80\'\n              }`}\n            >\n              <div\n                className={`flex items-center justify-between font-semibold ${\n                  isDark ? \'text-slate-300\' : \'text-indigo-950\'\n                }`}\n              >\n                <span>M\341\273\245c ti\303\252u Order {currentOrderMeta.orderNumber}: {currentOrderMeta.title}</span>\n                <span className=\"text-[10px] text-indigo-600 font-semibold\">{currentOrderMeta.platform}</span>\n              </div>\n              <p className={`text-[11px] leading-relaxed ${isDark ? \'text-slate-400\' : \'text-slate-600\'}`}>\n                {currentOrderMeta.description}\n              </p>\n            </div>\n\n            {/* Target Workshop / Program Selector */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label\n                  className={`text-xs font-semibold flex items-center gap-1.5 ${\n                    isDark ? \'text-slate-200\' : \'text-slate-800\'\n                  }`}\n                >\n                  <Layers className=\"w-3.5 h-3.5 text-indigo-600\" />\n                  <span>Workshop / Ch\306\260\306\241ng tr\303\254nh \304\221\303\255ch</span>\n                </label>\n                <button\n                  type=\"button\"\n                  onClick={onNavigateToPrograms}\n                  className=\"text-[11px] text-indigo-600 hover:text-indigo-700 font-medium flex items-center gap-1 cursor-pointer\"\n                >\n                  <span>Kho ({programs.length})</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </button>\n              </div>\n\n              <div className=\"relative\">\n                <select\n                  value={selectedProgramId}\n                  onChange={(e) => setSelectedProgramId(e.target.value)}\n                  className={`w-full border rounded-xl px-3.5 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 appearance-none cursor-pointer ${\n                    isDark\n                      ? \'bg-slate-950 border-slate-800 text-slate-200 focus:border-indigo-500\'\n                      : \'bg-slate-50 border-slate-200 text-slate-900 focus:border-indigo-600 focus:bg-white\'\n                  }`}\n                >\n                  <option value=\"auto\">\342\234\250 AI t\341\273\261 \304\221\341\273\231ng ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t v\341\273\233i ng\341\273\257 c\341\272\243nh</option>\n                  <optgroup label={isFacebook ? \'Workshops Kh\341\272\243 D\341\273\245ng (FB ch\341\273\211 ch\341\272\241y WS)\' : \'Workshops & Ch\306\260\306\241ng Tr\303\254nh\'}>\n                    {filteredPrograms.map((p) => (\n                      <option key={p.id} value={p.id}>\n                        [{p.type === \'ws\' ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}] {p.title}\n                      </option>\n                    ))}\n                  </optgroup>\n                </select>\n                <ChevronDown className=\"w-4 h-4 text-slate-400 absolute right-3 top-2.5 pointer-events-none\" />\n              </div>\n            </div>\n\n            {/* Input Context & Prompt */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <label className={`text-xs font-semibold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>\n                  \303\235 t\306\260\341\273\237ng / Ng\341\273\257 c\341\272\243nh clip / N\341\273\227i \304\221au ng\306\260\341\273\235i xem <span className=\"text-rose-500\">*</span>\n                </label>\n                {context && (\n                  <button\n                    type=\"button\"\n                    onClick={handleEnhance}\n                    disabled={isEnhancing}\n                    className=\"text-[11px] font-semibold text-indigo-600 hover:text-indigo-700 flex items-center gap-1 cursor-pointer\"\n                  >\n                    <Wand2 className=\"w-3 h-3\" />\n                    <span>{isEnhancing ? \'\304\220ang th\303\252m...\' : \'T\341\273\221i \306\260u \303\275 t\306\260\341\273\237ng\'}</span>\n                  </button>\n                )}\n              </div>\n\n              <textarea\n                value={context}\n                onChange={(e) => setContext(e.target.value)}\n                placeholder=\"V\303\255 d\341\273\245: Clip n\303\263i v\341\273\201 n\341\273\227i s\341\273\243 tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng t\341\273\261 tin, mu\341\273\221n t\303\254m l\341\273\231 tr\303\254nh \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n r\303\265 r\303\240ng...\"\n                rows={4}\n                className={`w-full border rounded-xl p-3 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 leading-relaxed font-sans ${\n                  isDark\n                    ? \'bg-slate-950 border-slate-800 text-slate-200 placeholder-slate-500 focus:border-indigo-500\'\n                    : \'bg-slate-50 border-slate-200 text-slate-900 placeholder-slate-400 focus:border-indigo-600 focus:bg-white\'\n                }`}\n              />\n\n              {/* Quick Idea Chips */}\n              <div className=\"flex items-center gap-1.5 overflow-x-auto pt-1 no-scrollbar\">\n                <span className={`text-[10px] whitespace-nowrap ${isDark ? \'text-slate-500\' : \'text-slate-400\'}`}>\n                  \303\235 t\306\260\341\273\237ng nhanh:\n                </span>\n                {QUICK_IDEAS.map((idea, i) => (\n                  <button\n                    key={i}\n                    type=\"button\"\n                    onClick={() => {\n                      setSelectedOrderType(idea.orderType);\n                      setContext(idea.text);\n                    }}\n                    className={`px-2 py-0.5 rounded-md text-[10px] whitespace-nowrap transition-colors cursor-pointer border ${\n                      isDark\n                        ? \'bg-slate-950 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border-slate-800/80\'\n                        : \'bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 border-slate-200\'\n                    }`}\n                  >\n                    {idea.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Collapsible Advanced Settings (Keeps UI clean!) */}\n            <div className={`border-t pt-3 ${isDark ? \'border-slate-800/80\' : \'border-slate-200\'}`}>\n              <button\n                type=\"button\"\n                onClick={() => setShowAdvanced(!showAdvanced)}\n                className={`w-full flex items-center justify-between text-xs py-1 cursor-pointer ${\n                  isDark ? \'text-slate-400 hover:text-slate-200\' : \'text-slate-600 hover:text-slate-900\'\n                }`}\n              >\n                <span className=\"flex items-center gap-1.5 font-semibold\">\n                  <Sliders className=\"w-3.5 h-3.5 text-slate-400\" />\n                  T\303\271y ch\341\273\215n n\303\242ng cao (\341\272\242nh ch\341\273\245p, \304\220\341\273\231 d\303\240i, Link)\n                </span>\n                <ChevronDown\n                  className={`w-3.5 h-3.5 transform transition-transform ${\n                    showAdvanced ? \'rotate-180\' : \'\'\n                  }`}\n                />\n              </button>\n\n              {showAdvanced && (\n                <div\n                  className={`mt-3 space-y-3 p-3 rounded-xl border ${\n                    isDark\n                      ? \'bg-slate-950/60 border-slate-800/80\'\n                      : \'bg-slate-50 border-slate-200\'\n                  }`}\n                >\n                  {/* Image Upload */}\n                  <div>\n                    <label\n                      className={`text-[11px] font-medium block mb-1 ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}\n                    >\n                      \341\272\242nh ch\341\273\245p m\303\240n h\303\254nh clip/post (AI s\341\272\275 \304\221\341\273\215c text & bi\341\273\203u c\341\272\243m):\n                    </label>\n                    {imagePreview ? (\n                      <div\n                        className={`flex items-center justify-between p-2 rounded-lg border ${\n                          isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'\n                        }`}\n                      >\n                        <div className=\"flex items-center gap-2\">\n                          <img\n                            src={imagePreview}\n                            alt=\"Preview\"\n                            className=\"w-10 h-10 object-cover rounded border border-slate-300\"\n                          />\n                          <span className={`text-xs ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                            \304\220\303\243 n\341\272\241p 1 \341\272\243nh\n                          </span>\n                        </div>\n                        <button\n                          type=\"button\"\n                          onClick={removeImage}\n                          className=\"text-[11px] text-rose-500 hover:text-rose-600 font-medium cursor-pointer\"\n                        >\n                          X\303\263a\n                        </button>\n                      </div>\n                    ) : (\n                      <label\n                        className={`flex items-center justify-center p-2.5 border border-dashed rounded-lg cursor-pointer text-xs transition-all ${\n                          isDark\n                            ? \'border-slate-800 hover:border-slate-700 bg-slate-900/50 text-slate-400 hover:text-slate-200\'\n                            : \'border-slate-300 hover:border-slate-400 bg-white text-slate-600 hover:text-slate-900\'\n                        }`}\n                      >\n                        <Upload className=\"w-3.5 h-3.5 mr-1.5 text-indigo-600\" />\n                        <span>T\341\272\243i \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh (T\341\273\221i \304\221a 5MB)</span>\n                        <input\n                          type=\"file\"\n                          accept=\"image/*\"\n                          onChange={handleImageUpload}\n                          className=\"hidden\"\n                        />\n                      </label>\n                    )}\n                  </div>\n\n                  {/* Length Preference */}\n                  <div>\n                    <label\n                      className={`text-[11px] font-medium block mb-1 ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}\n                    >\n                      \304\220\341\273\231 d\303\240i n\341\273\231i dung:\n                    </label>\n                    <div className=\"grid grid-cols-3 gap-1.5\">\n                      {[\n                        { id: \'short\', label: \'Ng\341\272\257n g\341\273\215n\' },\n                        { id: \'medium\', label: \'Ti\303\252u chu\341\272\251n\' },\n                        { id: \'deep\', label: \'S\303\242u s\341\272\257c\' },\n                      ].map((l) => (\n                        <button\n                          key={l.id}\n                          type=\"button\"\n                          onClick={() => setLengthPreference(l.id as any)}\n                          className={`py-1 text-xs rounded-lg border transition-all cursor-pointer ${\n                            lengthPreference === l.id\n                              ? \'bg-indigo-600 text-white border-indigo-600 font-semibold shadow-2xs\'\n                              : isDark\n                              ? \'bg-slate-900 text-slate-400 border-slate-800\'\n                              : \'bg-white text-slate-700 border-slate-200 hover:bg-slate-100\'\n                          }`}\n                        >\n                          {l.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Link Checkbox */}\n                  <label\n                    className={`flex items-center gap-2 text-xs cursor-pointer pt-1 ${\n                      isDark ? \'text-slate-300\' : \'text-slate-700\'\n                    }`}\n                  >\n                    <input\n                      type=\"checkbox\"\n                      checked={includeLink}\n                      onChange={(e) => setIncludeLink(e.target.checked)}\n                      className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                    />\n                    <span>G\341\272\257n k\303\250m link Form / Test v\303\240o comment</span>\n                  </label>\n\n                  {/* Custom Audience */}\n                  <div>\n                    <label\n                      className={`text-[11px] font-medium block mb-1 ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}\n                    >\n                      \304\220\341\273\221i t\306\260\341\273\243ng \304\221\341\273\231c gi\341\272\243 c\341\273\245 th\341\273\203:\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={customAudience}\n                      onChange={(e) => setCustomAudience(e.target.value)}\n                      placeholder=\"V\303\255 d\341\273\245: Ng\306\260\341\273\235i \304\221i l\303\240m 22-30 tu\341\273\225i, loay hoay \304\221\341\273\213nh h\306\260\341\273\233ng...\"\n                      className={`w-full border rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 ${\n                        isDark\n                          ? \'bg-slate-900 border-slate-800 text-slate-200 placeholder-slate-500 focus:border-indigo-500\'\n                          : \'bg-white border-slate-300 text-slate-900 placeholder-slate-400 focus:border-indigo-600\'\n                      }`}\n                    />\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Error Display */}\n            {error && (\n              <div className=\"p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-800 flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-rose-600 flex-shrink-0\" />\n                <span>{error}</span>\n              </div>\n            )}\n\n            {/* Primary Action Button (The Clear Focal Point!) */}\n            <button\n              onClick={handleGenerate}\n              disabled={isLoading}\n              className=\"w-full py-3 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center space-x-2 disabled:opacity-50 cursor-pointer\"\n            >\n              {isLoading ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin text-white\" />\n                  <span>AI \304\220ang Ph\303\242n T\303\255ch & S\341\272\243n Xu\341\272\245t Content...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-4 h-4\" />\n                  <span>T\341\272\241o 3 Ph\306\260\306\241ng \303\201n & K\341\273\213ch B\341\272\243n DM</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Right Column: Output Workbench (7 Cols) */}\n        <div className=\"lg:col-span-7 space-y-4\">\n          {generatedResult ? (\n            <div\n              className={`border rounded-2xl p-5 space-y-4 shadow-sm transition-colors ${\n                isDark\n                  ? \'bg-slate-900/90 border-slate-800/90\'\n                  : \'bg-white border-slate-200\'\n              }`}\n            >\n              {/* Header: Result Info & Tabs */}\n              <div\n                className={`flex flex-wrap items-center justify-between gap-3 border-b pb-4 ${\n                  isDark ? \'border-slate-800\' : \'border-slate-200\'\n                }`}\n              >\n                <div>\n                  <div className=\"flex items-center gap-2\">\n                    <span className={`text-xs font-bold ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n                      Order {currentOrderMeta.orderNumber}: {generatedResult.orderTitle}\n                    </span>\n                    <span\n                      className={`text-[10px] px-2 py-0.5 rounded font-semibold ${\n                        isDark ? \'bg-slate-800 text-slate-300\' : \'bg-slate-100 text-slate-700 border border-slate-200\'\n                      }`}\n                    >\n                      {generatedResult.platform}\n                    </span>\n                  </div>\n                  <p className={`text-[11px] mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                    M\341\273\245c ti\303\252u: <strong className={isDark ? \'text-slate-200\' : \'text-slate-800\'}>{generatedResult.programTitle}</strong>\n                  </p>\n                </div>\n\n                {/* Clean View Tabs */}\n                <div\n                  className={`flex p-1 rounded-xl border text-xs ${\n                    isDark ? \'bg-slate-950 border-slate-800\' : \'bg-slate-100 border-slate-200\'\n                  }`}\n                >\n                  <button\n                    onClick={() => setResultTab(\'variations\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer ${\n                      resultTab === \'variations\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : isDark\n                        ? \'text-slate-400 hover:text-slate-200\'\n                        : \'text-slate-600 hover:text-slate-900\'\n                    }`}\n                  >\n                    3 Ph\306\260\306\241ng \303\201n\n                  </button>\n                  <button\n                    onClick={() => setResultTab(\'dm_script\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer ${\n                      resultTab === \'dm_script\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : isDark\n                        ? \'text-slate-400 hover:text-slate-200\'\n                        : \'text-slate-600 hover:text-slate-900\'\n                    }`}\n                  >\n                    K\341\273\213ch B\341\272\243n DM 1-1\n                  </button>\n                  <button\n                    onClick={() => setResultTab(\'preview\')}\n                    className={`px-3 py-1 rounded-lg font-semibold transition-all cursor-pointer ${\n                      resultTab === \'preview\'\n                        ? \'bg-indigo-600 text-white shadow-sm\'\n                        : isDark\n                        ? \'text-slate-400 hover:text-slate-200\'\n                        : \'text-slate-600 hover:text-slate-900\'\n                    }`}\n                  >\n                    Xem Tr\306\260\341\273\233c\n                  </button>\n                </div>\n              </div>\n\n              {/* TAB 1: 3 Content Variations */}\n              {resultTab === \'variations\' && (\n                <div className=\"space-y-3\">\n                  {generatedResult.variations.map((variation, idx) => (\n                    <div\n                      key={idx}\n                      className={`border rounded-xl p-4 space-y-2 transition-colors ${\n                        isDark\n                          ? \'bg-slate-950 border-slate-800/90 hover:border-slate-700\'\n                          : \'bg-slate-50/80 border-slate-200 hover:border-slate-300\'\n                      }`}\n                    >\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs font-bold text-indigo-600\">\n                          Ph\306\260\306\241ng \303\241n {idx + 1}\n                        </span>\n                        <button\n                          onClick={() => copyWithFeedback(variation, `var-${idx}`)}\n                          className={`px-2.5 py-1 rounded-lg text-xs font-medium border transition-all flex items-center gap-1.5 cursor-pointer ${\n                            isDark\n                              ? \'bg-slate-900 hover:bg-slate-800 text-slate-200 border-slate-700/80\'\n                              : \'bg-white hover:bg-slate-50 text-slate-700 border-slate-300 shadow-2xs\'\n                          }`}\n                        >\n                          {copiedId === `var-${idx}` ? (\n                            <>\n                              <Check className=\"w-3.5 h-3.5 text-emerald-600\" />\n                              <span className=\"text-emerald-600 font-semibold\">\304\220\303\243 sao ch\303\251p</span>\n                            </>\n                          ) : (\n                            <>\n                              <Copy className=\"w-3.5 h-3.5 text-slate-400\" />\n                              <span>Sao ch\303\251p</span>\n                            </>\n                          )}\n                        </button>\n                      </div>\n\n                      <p\n                        className={`text-xs leading-relaxed whitespace-pre-line font-sans select-all ${\n                          isDark ? \'text-slate-200\' : \'text-slate-800\'\n                        }`}\n                      >\n                        {variation}\n                      </p>\n\n                      <div\n                        className={`text-[10px] pt-2 flex items-center justify-between border-t ${\n                          isDark ? \'text-slate-500 border-slate-900\' : \'text-slate-400 border-slate-200\'\n                        }`}\n                      >\n                        <span>{variation.length} k\303\275 t\341\273\261</span>\n                        <span>Tone chu\341\272\251n {generatedResult.platform}</span>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n\n              {/* TAB 2: DM 1-1 Inbound Script */}\n              {resultTab === \'dm_script\' && (\n                <div className=\"space-y-3\">\n                  <div\n                    className={`flex items-center justify-between p-3 rounded-xl border ${\n                      isDark\n                        ? \'bg-slate-950/60 border-slate-800\'\n                        : \'bg-indigo-50/50 border-indigo-100\'\n                    }`}\n                  >\n                    <span className={`text-xs ${isDark ? \'text-slate-300\' : \'text-indigo-950 font-medium\'}`}>\n                      Quy tr\303\254nh 3 b\306\260\341\273\233c x\341\273\255 l\303\275 khi kh\303\241ch h\303\240ng comment ho\341\272\267c inbox xin link/test\n                    </span>\n                    <button\n                      onClick={() => {\n                        const fullScript = `B\306\257\341\273\232C 1 (\304\220\341\273\223ng c\341\272\243m):\\n${generatedResult.dmFollowUpScript.step1_empathy}\\n\\nB\306\257\341\273\232C 2 (C\303\242u h\341\273\217i \304\221\303\240o s\303\242u):\\n${generatedResult.dmFollowUpScript.step2_qualifyQuestion}\\n\\nB\306\257\341\273\232C 3 (G\341\273\255i link test & m\341\273\235i tham gia):\\n${generatedResult.dmFollowUpScript.step3_inviteLink}`;\n                        copyWithFeedback(fullScript, \'full-dm\');\n                      }}\n                      className=\"px-3 py-1 text-xs font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white transition-all flex items-center gap-1.5 cursor-pointer shadow-2xs\"\n                    >\n                      {copiedId === \'full-dm\' ? (\n                        <>\n                          <Check className=\"w-3.5 h-3.5 text-white\" />\n                          <span>\304\220\303\243 ch\303\251p to\303\240n b\341\273\231</span>\n                        </>\n                      ) : (\n                        <>\n                          <Copy className=\"w-3.5 h-3.5\" />\n                          <span>Sao ch\303\251p c\341\272\243 3 b\306\260\341\273\233c</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n\n                  {/* Step 1 */}\n                  <div\n                    className={`border rounded-xl p-3.5 space-y-1.5 ${\n                      isDark ? \'bg-slate-950 border-slate-800\' : \'bg-white border-slate-200\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className={`font-bold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>\n                        B\306\260\341\273\233c 1: Ch\303\240o \304\221\303\263n & \304\220\341\273\223ng c\341\272\243m (T\341\272\241o kh\303\264ng gian an to\303\240n)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step1_empathy,\n                            \'step-1\'\n                          )\n                        }\n                        className={`text-[11px] cursor-pointer ${\n                          isDark ? \'text-slate-400 hover:text-slate-200\' : \'text-slate-500 hover:text-slate-800\'\n                        }`}\n                      >\n                        {copiedId === \'step-1\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                      </button>\n                    </div>\n                    <p\n                      className={`text-xs leading-relaxed italic p-2.5 rounded-lg border select-all ${\n                        isDark\n                          ? \'text-slate-300 bg-slate-900/80 border-slate-800/80\'\n                          : \'text-slate-700 bg-slate-50 border-slate-200\'\n                      }`}\n                    >\n                      \"{generatedResult.dmFollowUpScript.step1_empathy}\"\n                    </p>\n                  </div>\n\n                  {/* Step 2 */}\n                  <div\n                    className={`border rounded-xl p-3.5 space-y-1.5 ${\n                      isDark ? \'bg-slate-950 border-slate-800\' : \'bg-white border-slate-200\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className={`font-bold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>\n                        B\306\260\341\273\233c 2: C\303\242u h\341\273\217i \304\221\303\240o s\303\242u x\303\241c \304\221\341\273\213nh nhu c\341\272\247u (Qualifying)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step2_qualifyQuestion,\n                            \'step-2\'\n                          )\n                        }\n                        className={`text-[11px] cursor-pointer ${\n                          isDark ? \'text-slate-400 hover:text-slate-200\' : \'text-slate-500 hover:text-slate-800\'\n                        }`}\n                      >\n                        {copiedId === \'step-2\' ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                      </button>\n                    </div>\n                    <p\n                      className={`text-xs leading-relaxed italic p-2.5 rounded-lg border select-all ${\n                        isDark\n                          ? \'text-slate-300 bg-slate-900/80 border-slate-800/80\'\n                          : \'text-slate-700 bg-slate-50 border-slate-200\'\n                      }`}\n                    >\n                      \"{generatedResult.dmFollowUpScript.step2_qualifyQuestion}\"\n                    </p>\n                  </div>\n\n                  {/* Step 3 */}\n                  <div\n                    className={`border rounded-xl p-3.5 space-y-1.5 ${\n                      isDark ? \'bg-slate-950 border-slate-800\' : \'bg-white border-slate-200\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between text-xs\">\n                      <span className={`font-bold ${isDark ? \'text-slate-200\' : \'text-slate-800\'}`}>\n                        B\306\260\341\273\233c 3: L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / Form tham v\341\272\245n 1-1\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyWithFeedback(\n                            generatedResult.dmFollowUpScript.step3_inviteLink,\n                            \'step-3\'\n                          )\n                        }\n                        className={`text-[11px] cursor-pointer ${\n                          isDark ? \'text-slate-400 hover:text-slate-200\' : \'text-slate-500 hover:text-