    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Sparkles, Layers, MessageSquare, BookOpen, Clock, Bot, PlusCircle } from \'lucide-react\';\n\ninterface NavbarProps {\n  activeTab: \'orders\' | \'workbench\' | \'programs\' | \'chat\' | \'templates\' | \'history\';\n  setActiveTab: (tab: \'orders\' | \'workbench\' | \'programs\' | \'chat\' | \'templates\' | \'history\') => void;\n  onOpenAddProgram: () => void;\n  onQuickHiTrigger: () => void;\n  programCount: { ws: number; ct: number };\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAddProgram,\n  onQuickHiTrigger,\n  programCount,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 bg-slate-900/95 backdrop-blur border-b border-slate-800 text-slate-100 shadow-md\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Title */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => setActiveTab(\'orders\')}>\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-rose-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-rose-500/20 ring-1 ring-white/20\">\n              <Sparkles className=\"w-5 h-5 text-white\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-lg tracking-tight text-white font-sans\">\n                  PROMPT ORDER AI\n                </span>\n                <span className=\"px-2 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30\">\n                  Si\303\252u Nh\303\240n\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-400 font-medium hidden sm:block\">\n                Social Media 10 N\304\203m KN \342\200\242 TikTok \342\200\242 Facebook \342\200\242 Threads \342\200\242 LinkedIn\n              </p>\n            </div>\n          </div>\n\n          {/* Navigation Tabs */}\n          <nav className=\"hidden md:flex items-center space-x-1 bg-slate-950/60 p-1 rounded-xl border border-slate-800/80\">\n            <button\n              onClick={() => setActiveTab(\'orders\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'orders\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <Layers className=\"w-3.5 h-3.5\" />\n              <span>7 Order T\341\273\261 \304\220\341\273\231ng</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'workbench\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'workbench\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Studio S\341\272\243n Xu\341\272\245t</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'programs\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'programs\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Kho WS/CT ({programCount.ws + programCount.ct})</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'chat\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'chat\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <Bot className=\"w-3.5 h-3.5 text-emerald-400\" />\n              <span>Chat AI (Type \"Hi\")</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'templates\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'templates\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <MessageSquare className=\"w-3.5 h-3.5\" />\n              <span>M\341\272\253u Benchmark</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'history\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'history\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/50\'\n              }`}\n            >\n              <Clock className=\"w-3.5 h-3.5\" />\n              <span>L\341\273\213ch S\341\273\255</span>\n            </button>\n          </nav>\n\n          {/* Quick Action Buttons */}\n          <div className=\"flex items-center space-x-2\">\n            <button\n              onClick={onQuickHiTrigger}\n              title=\"G\303\265 \'Hi\' \304\221\341\273\203 m\341\273\237 danh s\303\241ch Order t\341\273\261 \304\221\341\273\231ng trong Chatbot\"\n              className=\"px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 transition-all flex items-center space-x-1.5 animate-pulse\"\n            >\n              <Bot className=\"w-3.5 h-3.5\" />\n              <span>Type \"Hi\"</span>\n            </button>\n\n            <button\n              onClick={onOpenAddProgram}\n              className=\"px-3 py-1.5 text-xs font-semibold rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white shadow-sm transition-all flex items-center space-x-1.5\"\n            >\n              <PlusCircle className=\"w-3.5 h-3.5\" />\n              <span className=\"hidden sm:inline\">Th\303\252m WS/CT</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Mobile Submenu */}\n        <div className=\"flex md:hidden overflow-x-auto py-2 space-x-1 border-t border-slate-800/60 no-scrollbar\">\n          <button\n            onClick={() => setActiveTab(\'orders\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'orders\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            7 Order\n          </button>\n          <button\n            onClick={() => setActiveTab(\'workbench\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'workbench\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            Studio\n          </button>\n          <button\n            onClick={() => setActiveTab(\'programs\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'programs\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            Kho WS/CT ({programCount.ws + programCount.ct})\n          </button>\n          <button\n            onClick={() => setActiveTab(\'chat\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'chat\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            Chat AI\n          </button>\n          <button\n            onClick={() => setActiveTab(\'templates\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'templates\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            M\341\272\253u Chu\341\272\251n\n          </button>\n          <button\n            onClick={() => setActiveTab(\'history\')}\n            className={`px-3 py-1 rounded-md text-xs font-medium whitespace-nowrap ${\n              activeTab === \'history\' ? \'bg-indigo-600 text-white\' : \'text-slate-400\'\n            }`}\n          >\n            L\341\273\213ch S\341\273\255\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
