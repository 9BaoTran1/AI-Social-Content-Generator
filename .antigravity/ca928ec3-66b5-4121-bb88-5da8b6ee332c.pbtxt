    instruction: "Add theme support and style light mode for ProgramManager component"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { ProgramItem, ProgramType } from \'../types\';\nimport {\n  Plus,\n  BookOpen,\n  Layers,\n  Sparkles,\n  Link as LinkIcon,\n  Upload,\n  Trash2,\n  Edit2,\n  Check,\n  X,\n  Search,\n  AlertCircle,\n  ShieldCheck,\n  ShieldAlert,\n  RefreshCw,\n  Eye,\n  EyeOff\n} from \'lucide-react\';\n\ninterface ProgramManagerProps {\n  programs: ProgramItem[];\n  onAddProgram: (program: ProgramItem) => void;\n  onUpdateProgram: (program: ProgramItem) => void;\n  onDeleteProgram: (id: string) => void;\n  isAddModalOpen: boolean;\n  setIsAddModalOpen: (open: boolean) => void;\n}\n\nexport const ProgramManager: React.FC<ProgramManagerProps> = ({\n  programs,\n  onAddProgram,\n  onUpdateProgram,\n  onDeleteProgram,\n  isAddModalOpen,\n  setIsAddModalOpen,\n}) => {\n  const [filterType, setFilterType] = useState<\'all\' | \'ws\' | \'ct\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  // Extract Modal state\n  const [inputUrl, setInputUrl] = useState<string>(\'\');\n  const [inputText, setInputText] = useState<string>(\'\');\n  const [inputImageBase64, setInputImageBase64] = useState<string | null>(null);\n  const [isExtracting, setIsExtracting] = useState<boolean>(false);\n  const [extractError, setExtractError] = useState<string | null>(null);\n\n  // Extracted Result Draft for review before saving\n  const [draftProgram, setDraftProgram] = useState<Partial<ProgramItem> | null>(null);\n\n  // Editing existing program state\n  const [editingProgram, setEditingProgram] = useState<ProgramItem | null>(null);\n\n  const filteredPrograms = programs.filter((p) => {\n    if (filterType !== \'all\' && p.type !== filterType) return false;\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return (\n        p.title.toLowerCase().includes(q) ||\n        p.description.toLowerCase().includes(q) ||\n        p.targetAudience.some((a) => a.toLowerCase().includes(q))\n      );\n    }\n    return true;\n  });\n\n  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        setInputImageBase64(reader.result as string);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const handleExtract = async () => {\n    if (!inputUrl.trim() && !inputText.trim() && !inputImageBase64) {\n      setExtractError(\'Vui l\303\262ng nh\341\272\255p link Tally/Form, d\303\241n v\304\203n b\341\272\243n m\303\264 t\341\272\243 ho\341\272\267c t\341\272\243i \341\272\243nh l\303\252n.\');\n      return;\n    }\n\n    setIsExtracting(true);\n    setExtractError(null);\n\n    try {\n      const response = await fetch(\'/api/extract-program\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          url: inputUrl.trim() || undefined,\n          text: inputText.trim() || undefined,\n          imageBase64: inputImageBase64,\n        }),\n      });\n\n      const resData = await response.json();\n      if (!response.ok || !resData.success) {\n        throw new Error(resData.error || \'Kh\303\264ng th\341\273\203 b\303\263c t\303\241ch th\303\264ng tin.\');\n      }\n\n      const extracted = resData.data;\n      setDraftProgram({\n        id: `prog-${Date.now()}`,\n        title: extracted.title || \'Ch\306\260\306\241ng tr\303\254nh m\341\273\233i\',\n        type: (extracted.type as ProgramType) || \'ws\',\n        description: extracted.description || \'\',\n        targetAudience: extracted.targetAudience || [],\n        painPoints: extracted.painPoints || [],\n        coreValues: extracted.coreValues || [],\n        testOrFormAngle: extracted.testOrFormAngle || \'\',\n        imageUrl: extracted.imageUrl || undefined,\n        tallyUrl: extracted.tallyUrl || inputUrl.trim() || undefined,\n        notes: extracted.notes || \'\',\n        isActive: true,\n        isBuiltin: false,\n        createdAt: new Date().toISOString(),\n      });\n    } catch (err: any) {\n      setExtractError(err.message || \'L\341\273\227i khi b\303\263c t\303\241ch.\');\n    } finally {\n      setIsExtracting(false);\n    }\n  };\n\n  const handleSaveDraft = () => {\n    if (!draftProgram || !draftProgram.title) return;\n    onAddProgram(draftProgram as ProgramItem);\n    setDraftProgram(null);\n    setInputUrl(\'\');\n    setInputText(\'\');\n    setInputImageBase64(null);\n    setIsAddModalOpen(false);\n  };\n\n  const handleSaveEditing = () => {\n    if (editingProgram) {\n      onUpdateProgram(editingProgram);\n      setEditingProgram(null);\n    }\n  };\n\n  const toggleProgramActive = (p: ProgramItem) => {\n    onUpdateProgram({\n      ...p,\n      isActive: !p.isActive,\n    });\n  };\n\n  const wsCount = programs.filter((p) => p.type === \'ws\').length;\n  const ctCount = programs.filter((p) => p.type === \'ct\').length;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Header & Search Bar */}\n      <div className=\"bg-slate-900/90 border border-slate-800/90 p-5 rounded-2xl space-y-4 shadow-sm\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className=\"text-base font-bold text-white flex items-center gap-2\">\n              <span>Kho Workshop & Ch\306\260\306\241ng Tr\303\254nh</span>\n              <span className=\"text-xs font-medium px-2 py-0.5 rounded-full bg-slate-800 text-slate-300\">\n                {programs.length} m\341\273\245c\n              </span>\n            </h2>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              C\306\241 s\341\273\237 d\341\273\257 li\341\273\207u ki\341\272\277n th\341\273\251c \304\221\341\273\203 AI h\341\273\215c v\303\240 \304\221\341\273\221i chi\341\272\277u khi s\341\272\243n xu\341\272\245t content cho t\341\273\253ng n\341\273\201n t\341\272\243ng\n            </p>\n          </div>\n\n          <button\n            onClick={() => setIsAddModalOpen(true)}\n            className=\"px-3.5 py-2 text-xs font-bold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm transition-all flex items-center justify-center space-x-1.5 self-start sm:self-auto cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Th\303\252m M\341\273\233i B\341\272\261ng Link / AI</span>\n          </button>\n        </div>\n\n        {/* Filter Tabs & Search Box */}\n        <div className=\"flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-slate-800/80\">\n          <div className=\"flex items-center gap-1 bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs w-full sm:w-auto\">\n            <button\n              onClick={() => setFilterType(\'all\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all ${\n                filterType === \'all\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              T\341\272\245t c\341\272\243 ({programs.length})\n            </button>\n            <button\n              onClick={() => setFilterType(\'ws\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all ${\n                filterType === \'ws\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              Workshop (WS: {wsCount})\n            </button>\n            <button\n              onClick={() => setFilterType(\'ct\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all ${\n                filterType === \'ct\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200\'\n              }`}\n            >\n              Ch\306\260\306\241ng tr\303\254nh (CT: {ctCount})\n            </button>\n          </div>\n\n          <div className=\"relative w-full sm:w-64\">\n            <Search className=\"w-3.5 h-3.5 text-slate-500 absolute left-3 top-2.5\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"T\303\254m ki\341\272\277m theo t\303\252n, n\341\273\227i \304\221au...\"\n              className=\"w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Program Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {filteredPrograms.map((program) => {\n          const isWS = program.type === \'ws\';\n          return (\n            <div\n              key={program.id}\n              className={`bg-slate-900/90 border rounded-2xl p-5 shadow-sm space-y-3 transition-all ${\n                program.isActive ? \'border-slate-800/90\' : \'border-slate-800/40 opacity-50\'\n              }`}\n            >\n              {/* Card Top: Badges & Controls */}\n              <div className=\"flex items-start justify-between gap-2\">\n                <div className=\"space-y-1\">\n                  <div className=\"flex flex-wrap items-center gap-1.5\">\n                    <span\n                      className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-md border ${\n                        isWS\n                          ? \'bg-emerald-500/15 text-emerald-300 border-emerald-500/30\'\n                          : \'bg-indigo-500/15 text-indigo-300 border-indigo-500/30\'\n                      }`}\n                    >\n                      {isWS ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}\n                    </span>\n\n                    <span\n                      className={`text-[10px] font-medium px-2 py-0.5 rounded-md flex items-center gap-1 ${\n                        isWS\n                          ? \'bg-slate-950 text-emerald-400 border border-slate-800\'\n                          : \'bg-slate-950 text-slate-400 border border-slate-800\'\n                      }`}\n                    >\n                      {isWS ? (\n                        <>\n                          <ShieldCheck className=\"w-3 h-3 text-emerald-400\" />\n                          <span>Ch\341\272\241y \304\221\306\260\341\273\243c Facebook</span>\n                        </>\n                      ) : (\n                        <>\n                          <ShieldAlert className=\"w-3 h-3 text-slate-400\" />\n                          <span>Kh\303\264ng ch\341\272\241y Facebook</span>\n                        </>\n                      )}\n                    </span>\n\n                    {program.isBuiltin && (\n                      <span className=\"text-[10px] text-slate-500 px-1.5 py-0.5 rounded bg-slate-950 border border-slate-800\">\n                        H\341\273\207 th\341\273\221ng\n                      </span>\n                    )}\n                  </div>\n\n                  <h3 className=\"font-bold text-white text-sm leading-snug pt-0.5\">\n                    {program.title}\n                  </h3>\n                </div>\n\n                {/* Edit & Delete Controls */}\n                <div className=\"flex items-center space-x-1\">\n                  <button\n                    onClick={() => toggleProgramActive(program)}\n                    title={program.isActive ? \'T\341\272\241m ng\341\272\257t k\303\255ch ho\341\272\241t\' : \'K\303\255ch ho\341\272\241t\'}\n                    className={`p-1.5 rounded-lg border text-xs transition-colors ${\n                      program.isActive\n                        ? \'text-slate-400 hover:text-white bg-slate-950 border-slate-800\'\n                        : \'text-emerald-400 bg-slate-950 border-emerald-800/60\'\n                    }`}\n                  >\n                    {program.isActive ? <Eye className=\"w-3.5 h-3.5\" /> : <EyeOff className=\"w-3.5 h-3.5\" />}\n                  </button>\n                  <button\n                    onClick={() => setEditingProgram(program)}\n                    title=\"Ch\341\273\211nh s\341\273\255a\"\n                    className=\"p-1.5 text-slate-400 hover:text-indigo-300 hover:bg-slate-800 rounded-lg border border-slate-800 bg-slate-950 transition-all\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => onDeleteProgram(program.id)}\n                    title=\"X\303\263a\"\n                    className=\"p-1.5 text-slate-400 hover:text-rose-400 hover:bg-slate-800 rounded-lg border border-slate-800 bg-slate-950 transition-all\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Description */}\n              <p className=\"text-slate-300 text-xs leading-relaxed\">\n                {program.description}\n              </p>\n\n              {/* Target Audience & Pain Points */}\n              <div className=\"space-y-2 pt-2 border-t border-slate-800/80 text-xs\">\n                {program.targetAudience?.length > 0 && (\n                  <div>\n                    <span className=\"text-[11px] font-semibold text-indigo-300 block mb-1\">\n                      \360\237\216\257 \304\220\341\273\221i t\306\260\341\273\243ng ph\303\271 h\341\273\243p:\n                    </span>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {program.targetAudience.map((aud, i) => (\n                        <span\n                          key={i}\n                          className=\"px-2 py-0.5 rounded-md bg-slate-950 text-slate-300 border border-slate-800 text-[11px]\"\n                        >\n                          {aud}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {program.painPoints?.length > 0 && (\n                  <div>\n                    <span className=\"text-[11px] font-semibold text-rose-300 block mb-1\">\n                      \342\232\241 N\341\273\227i \304\221au gi\341\272\243i quy\341\272\277t (Pain Points):\n                    </span>\n                    <ul className=\"list-disc list-inside text-slate-400 text-[11px] space-y-0.5\">\n                      {program.painPoints.slice(0, 2).map((point, i) => (\n                        <li key={i} className=\"line-clamp-1\">\n                          {point}\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                )}\n\n                {program.testOrFormAngle && (\n                  <div>\n                    <span className=\"text-[11px] font-semibold text-emerald-300 block mb-1\">\n                      \360\237\223\213 G\303\263c ti\341\272\277p c\341\272\255n b\303\240i test / form 1-1:\n                    </span>\n                    <p className=\"text-[11px] text-slate-300 italic bg-slate-950/80 p-2 rounded-lg border border-slate-800/80 select-all\">\n                      \"{program.testOrFormAngle}\"\n                    </p>\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Add / Extract Modal */}\n      {isAddModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto p-6 space-y-5 shadow-2xl\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n              <div>\n                <h3 className=\"font-bold text-white text-base\">\n                  Th\303\252m Workshop / Ch\306\260\306\241ng Tr\303\254nh\n                </h3>\n                <p className=\"text-slate-400 text-xs mt-0.5\">\n                  D\303\241n link Tally, Form ho\341\272\267c text m\303\264 t\341\272\243 \304\221\341\273\203 AI t\341\273\261 \304\221\341\273\231ng b\303\263c t\303\241ch ki\341\272\277n th\341\273\251c\n                </p>\n              </div>\n              <button\n                onClick={() => {\n                  setIsAddModalOpen(false);\n                  setDraftProgram(null);\n                }}\n                className=\"text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {!draftProgram ? (\n              /* Step 1: Input link / text / image */\n              <div className=\"space-y-4\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                    1. D\303\241n Link Tally ho\341\272\267c Google Form (T\303\271y ch\341\273\215n)\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"url\"\n                      value={inputUrl}\n                      onChange={(e) => setInputUrl(e.target.value)}\n                      placeholder=\"https://storage.tally.so/... ho\341\272\267c https://forms.gle/...\"\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-xl pl-9 pr-4 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n                    />\n                    <LinkIcon className=\"w-3.5 h-3.5 text-slate-500 absolute left-3 top-2.5\" />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                    2. Ho\341\272\267c D\303\241n N\341\273\231i Dung M\303\264 T\341\272\243 / Copy t\341\273\253 Tally (\304\220\306\260\341\273\243c khuy\303\252n d\303\271ng)\n                  </label>\n                  <textarea\n                    value={inputText}\n                    onChange={(e) => setInputText(e.target.value)}\n                    placeholder=\"D\303\241n to\303\240n b\341\273\231 n\341\273\231i dung gi\341\273\233i thi\341\273\207u ch\306\260\306\241ng tr\303\254nh, n\341\273\227i \304\221au, gi\303\241 tr\341\273\213, quy\341\273\201n l\341\273\243i...\"\n                    rows={5}\n                    className=\"w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-sans\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                    3. T\341\272\243i \341\272\242nh Poster / Banner (T\303\271y ch\341\273\215n)\n                  </label>\n                  <label className=\"flex items-center justify-center p-2.5 border border-dashed border-slate-800 rounded-xl bg-slate-950/60 hover:bg-slate-950 cursor-pointer\">\n                    <Upload className=\"w-3.5 h-3.5 text-slate-400 mr-2\" />\n                    <span className=\"text-xs text-slate-300\">\n                      {inputImageBase64 ? \'\342\234\223 \304\220\303\243 ch\341\273\215n file \341\272\243nh\' : \'Ch\341\273\215n file \341\272\243nh poster\'}\n                    </span>\n                    <input\n                      type=\"file\"\n                      accept=\"image/*\"\n                      onChange={handleImageSelect}\n                      className=\"hidden\"\n                    />\n                  </label>\n                </div>\n\n                {extractError && (\n                  <div className=\"p-3 rounded-xl bg-rose-950/60 border border-rose-800 text-xs text-rose-300 flex items-center gap-2\">\n                    <AlertCircle className=\"w-4 h-4 flex-shrink-0 text-rose-400\" />\n                    <span>{extractError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex justify-end gap-2 pt-2\">\n                  <button\n                    onClick={() => setIsAddModalOpen(false)}\n                    className=\"px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800\"\n                  >\n                    H\341\273\247y\n                  </button>\n                  <button\n                    onClick={handleExtract}\n                    disabled={isExtracting}\n                    className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all flex items-center space-x-2 disabled:opacity-50 cursor-pointer\"\n                  >\n                    {isExtracting ? (\n                      <>\n                        <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                        <span>\304\220ang b\303\263c t\303\241ch d\341\273\257 li\341\273\207u...</span>\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles className=\"w-3.5 h-3.5\" />\n                        <span>B\303\263c T\303\241ch & H\341\273\215c D\341\273\257 Li\341\273\207u</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n              </div>\n            ) : (\n              /* Step 2: Review & Edit extracted draft */\n              <div className=\"space-y-4\">\n                <div className=\"p-3 rounded-xl bg-emerald-950/40 border border-emerald-800/50 text-xs text-emerald-300 flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-400 flex-shrink-0\" />\n                  <span>AI \304\221\303\243 b\303\263c t\303\241ch th\303\240nh c\303\264ng! Vui l\303\262ng ki\341\273\203m tra l\341\272\241i tr\306\260\341\273\233c khi l\306\260u.</span>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                      T\303\252n Workshop / CT\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={draftProgram.title || \'\'}\n                      onChange={(e) => setDraftProgram({ ...draftProgram, title: e.target.value })}\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                      Ph\303\242n lo\341\272\241i\n                    </label>\n                    <select\n                      value={draftProgram.type || \'ws\'}\n                      onChange={(e) =>\n                        setDraftProgram({ ...draftProgram, type: e.target.value as ProgramType })\n                      }\n                      className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n                    >\n                      <option value=\"ws\">Workshop (WS - \304\220\306\260\341\273\243c ch\341\272\241y tr\303\252n Facebook)</option>\n                      <option value=\"ct\">Ch\306\260\306\241ng tr\303\254nh (CT - Kh\303\264ng ch\341\272\241y Facebook)</option>\n                    </select>\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-300 block mb-1\">M\303\264 t\341\272\243 ng\341\272\257n</label>\n                  <textarea\n                    value={draftProgram.description || \'\'}\n                    onChange={(e) =>\n                      setDraftProgram({ ...draftProgram, description: e.target.value })\n                    }\n                    rows={2}\n                    className=\"w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-white\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                    G\303\263c ti\341\272\277p c\341\272\255n b\303\240i test / form 1-1\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={draftProgram.testOrFormAngle || \'\'}\n                    onChange={(e) =>\n                      setDraftProgram({ ...draftProgram, testOrFormAngle: e.target.value })\n                    }\n                    className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n                  />\n                </div>\n\n                <div className=\"flex justify-between items-center pt-3 border-t border-slate-800\">\n                  <button\n                    onClick={() => setDraftProgram(null)}\n                    className=\"px-3 py-1.5 text-xs text-slate-400 hover:text-white\"\n                  >\n                    \342\206\220 B\303\263c t\303\241ch l\341\272\241i\n                  </button>\n                  <button\n                    onClick={handleSaveDraft}\n                    className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-md flex items-center space-x-1.5 cursor-pointer\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n                    <span>L\306\260u V\303\240o Kho D\341\273\261 \303\201n</span>\n                  </button>\n                </div>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n\n      {/* Edit Existing Modal */}\n      {editingProgram && (\n        <div className=\"fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4\">\n          <div className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-xl p-6 space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n              <h3 className=\"font-bold text-white text-base\">Ch\341\273\211nh s\341\273\255a Workshop / CT</h3>\n              <button\n                onClick={() => setEditingProgram(null)}\n                className=\"text-slate-400 hover:text-white\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-semibold text-slate-300 block mb-1\">Ti\303\252u \304\221\341\273\201</label>\n              <input\n                type=\"text\"\n                value={editingProgram.title}\n                onChange={(e) => setEditingProgram({ ...editingProgram, title: e.target.value })}\n                className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-xs font-semibold text-slate-300 block mb-1\">Ph\303\242n lo\341\272\241i</label>\n              <select\n                value={editingProgram.type}\n                onChange={(e) =>\n                  setEditingProgram({ ...editingProgram, type: e.target.value as ProgramType })\n                }\n                className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n              >\n                <option value=\"ws\">Workshop (WS - \304\220\306\260\341\273\243c ph\303\251p ch\341\272\241y Facebook)</option>\n                <option value=\"ct\">Ch\306\260\306\241ng tr\303\254nh (CT - Kh\303\264ng ch\341\272\241y Facebook)</option>\n              </select>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-semibold text-slate-300 block mb-1\">M\303\264 t\341\272\243</label>\n              <textarea\n                value={editingProgram.description}\n                onChange={(e) =>\n                  setEditingProgram({ ...editingProgram, description: e.target.value })\n                }\n                rows={3}\n                className=\"w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-xs font-semibold text-slate-300 block mb-1\">\n                G\303\263c ti\341\272\277p c\341\272\255n b\303\240i test / form\n              </label>\n              <input\n                type=\"text\"\n                value={editingProgram.testOrFormAngle}\n                onChange={(e) =>\n                  setEditingProgram({ ...editingProgram, testOrFormAngle: e.target.value })\n                }\n                className=\"w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white\"\n              />\n            </div>\n\n            <div className=\"flex justify-end gap-2 pt-2 border-t border-slate-800\">\n              <button\n                onClick={() => setEditingProgram(null)}\n                className=\"px-4 py-2 text-xs text-slate-400 hover:text-white\"\n              >\n                H\341\273\247y\n              </button>\n              <button\n                onClick={handleSaveEditing}\n                className=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold cursor-pointer\"\n              >\n                C\341\272\255p nh\341\272\255t\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { ProgramItem, ProgramType, ThemeMode } from \'../types\';\nimport {\n  Plus,\n  BookOpen,\n  Layers,\n  Sparkles,\n  Link as LinkIcon,\n  Upload,\n  Trash2,\n  Edit2,\n  Check,\n  X,\n  Search,\n  AlertCircle,\n  ShieldCheck,\n  ShieldAlert,\n  RefreshCw,\n  Eye,\n  EyeOff\n} from \'lucide-react\';\n\ninterface ProgramManagerProps {\n  programs: ProgramItem[];\n  onAddProgram: (program: ProgramItem) => void;\n  onUpdateProgram: (program: ProgramItem) => void;\n  onDeleteProgram: (id: string) => void;\n  isAddModalOpen: boolean;\n  setIsAddModalOpen: (open: boolean) => void;\n  theme?: ThemeMode;\n}\n\nexport const ProgramManager: React.FC<ProgramManagerProps> = ({\n  programs,\n  onAddProgram,\n  onUpdateProgram,\n  onDeleteProgram,\n  isAddModalOpen,\n  setIsAddModalOpen,\n  theme = \'light\',\n}) => {\n  const isDark = theme === \'dark\';\n  const [filterType, setFilterType] = useState<\'all\' | \'ws\' | \'ct\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n\n  // Extract Modal state\n  const [inputUrl, setInputUrl] = useState<string>(\'\');\n  const [inputText, setInputText] = useState<string>(\'\');\n  const [inputImageBase64, setInputImageBase64] = useState<string | null>(null);\n  const [isExtracting, setIsExtracting] = useState<boolean>(false);\n  const [extractError, setExtractError] = useState<string | null>(null);\n\n  // Extracted Result Draft for review before saving\n  const [draftProgram, setDraftProgram] = useState<Partial<ProgramItem> | null>(null);\n\n  // Editing existing program state\n  const [editingProgram, setEditingProgram] = useState<ProgramItem | null>(null);\n\n  const filteredPrograms = programs.filter((p) => {\n    if (filterType !== \'all\' && p.type !== filterType) return false;\n    if (searchQuery.trim()) {\n      const q = searchQuery.toLowerCase();\n      return (\n        p.title.toLowerCase().includes(q) ||\n        p.description.toLowerCase().includes(q) ||\n        p.targetAudience.some((a) => a.toLowerCase().includes(q))\n      );\n    }\n    return true;\n  });\n\n  const handleImageSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        setInputImageBase64(reader.result as string);\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const handleExtract = async () => {\n    if (!inputUrl.trim() && !inputText.trim() && !inputImageBase64) {\n      setExtractError(\'Vui l\303\262ng nh\341\272\255p link Tally/Form, d\303\241n v\304\203n b\341\272\243n m\303\264 t\341\272\243 ho\341\272\267c t\341\272\243i \341\272\243nh l\303\252n.\');\n      return;\n    }\n\n    setIsExtracting(true);\n    setExtractError(null);\n\n    try {\n      const response = await fetch(\'/api/extract-program\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          url: inputUrl.trim() || undefined,\n          text: inputText.trim() || undefined,\n          imageBase64: inputImageBase64,\n        }),\n      });\n\n      const resData = await response.json();\n      if (!response.ok || !resData.success) {\n        throw new Error(resData.error || \'Kh\303\264ng th\341\273\203 b\303\263c t\303\241ch th\303\264ng tin.\');\n      }\n\n      const extracted = resData.data;\n      setDraftProgram({\n        id: `prog-${Date.now()}`,\n        title: extracted.title || \'Ch\306\260\306\241ng tr\303\254nh m\341\273\233i\',\n        type: (extracted.type as ProgramType) || \'ws\',\n        description: extracted.description || \'\',\n        targetAudience: extracted.targetAudience || [],\n        painPoints: extracted.painPoints || [],\n        coreValues: extracted.coreValues || [],\n        testOrFormAngle: extracted.testOrFormAngle || \'\',\n        imageUrl: extracted.imageUrl || undefined,\n        tallyUrl: extracted.tallyUrl || inputUrl.trim() || undefined,\n        notes: extracted.notes || \'\',\n        isActive: true,\n        isBuiltin: false,\n        createdAt: new Date().toISOString(),\n      });\n    } catch (err: any) {\n      setExtractError(err.message || \'L\341\273\227i khi b\303\263c t\303\241ch.\');\n    } finally {\n      setIsExtracting(false);\n    }\n  };\n\n  const handleSaveDraft = () => {\n    if (!draftProgram || !draftProgram.title) return;\n    onAddProgram(draftProgram as ProgramItem);\n    setDraftProgram(null);\n    setInputUrl(\'\');\n    setInputText(\'\');\n    setInputImageBase64(null);\n    setIsAddModalOpen(false);\n  };\n\n  const handleSaveEditing = () => {\n    if (editingProgram) {\n      onUpdateProgram(editingProgram);\n      setEditingProgram(null);\n    }\n  };\n\n  const toggleProgramActive = (p: ProgramItem) => {\n    onUpdateProgram({\n      ...p,\n      isActive: !p.isActive,\n    });\n  };\n\n  const wsCount = programs.filter((p) => p.type === \'ws\').length;\n  const ctCount = programs.filter((p) => p.type === \'ct\').length;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Header & Search Bar */}\n      <div\n        className={`border p-5 rounded-2xl space-y-4 shadow-sm transition-colors ${\n          isDark ? \'bg-slate-900/90 border-slate-800/90\' : \'bg-white border-slate-200\'\n        }`}\n      >\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <h2 className={`text-base font-bold flex items-center gap-2 ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n              <span>Kho Workshop & Ch\306\260\306\241ng Tr\303\254nh</span>\n              <span\n                className={`text-xs font-semibold px-2 py-0.5 rounded-full ${\n                  isDark ? \'bg-slate-800 text-slate-300\' : \'bg-slate-100 text-slate-700 border border-slate-200\'\n                }`}\n              >\n                {programs.length} m\341\273\245c\n              </span>\n            </h2>\n            <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n              C\306\241 s\341\273\237 d\341\273\257 li\341\273\207u ki\341\272\277n th\341\273\251c \304\221\341\273\203 AI h\341\273\215c v\303\240 \304\221\341\273\221i chi\341\272\277u khi s\341\272\243n xu\341\272\245t content cho t\341\273\253ng n\341\273\201n t\341\272\243ng\n            </p>\n          </div>\n\n          <button\n            onClick={() => setIsAddModalOpen(true)}\n            className=\"px-3.5 py-2 text-xs font-bold rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm transition-all flex items-center justify-center space-x-1.5 self-start sm:self-auto cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Th\303\252m M\341\273\233i B\341\272\261ng Link / AI</span>\n          </button>\n        </div>\n\n        {/* Filter Tabs & Search Box */}\n        <div\n          className={`flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t ${\n            isDark ? \'border-slate-800/80\' : \'border-slate-200\'\n          }`}\n        >\n          <div\n            className={`flex items-center gap-1 p-1 rounded-xl border text-xs w-full sm:w-auto ${\n              isDark ? \'bg-slate-950 border-slate-800\' : \'bg-slate-100 border-slate-200\'\n            }`}\n          >\n            <button\n              onClick={() => setFilterType(\'all\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer ${\n                filterType === \'all\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              T\341\272\245t c\341\272\243 ({programs.length})\n            </button>\n            <button\n              onClick={() => setFilterType(\'ws\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer ${\n                filterType === \'ws\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Workshop (WS: {wsCount})\n            </button>\n            <button\n              onClick={() => setFilterType(\'ct\')}\n              className={`flex-1 sm:flex-none px-3 py-1.5 rounded-lg font-semibold transition-all cursor-pointer ${\n                filterType === \'ct\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200\'\n                  : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Ch\306\260\306\241ng tr\303\254nh (CT: {ctCount})\n            </button>\n          </div>\n\n          <div className=\"relative w-full sm:w-64\">\n            <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"T\303\254m ki\341\272\277m theo t\303\252n, n\341\273\227i \304\221au...\"\n              className={`w-full border rounded-xl pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 ${\n                isDark\n                  ? \'bg-slate-950 border-slate-800 text-slate-200 placeholder-slate-500 focus:border-indigo-500\'\n                  : \'bg-white border-slate-300 text-slate-900 placeholder-slate-400 focus:border-indigo-600\'\n              }`}\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Program Cards Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {filteredPrograms.map((program) => {\n          const isWS = program.type === \'ws\';\n          return (\n            <div\n              key={program.id}\n              className={`border rounded-2xl p-5 shadow-sm space-y-3 transition-all ${\n                isDark\n                  ? `bg-slate-900/90 ${program.isActive ? \'border-slate-800/90\' : \'border-slate-800/40 opacity-50\'}`\n                  : `bg-white ${program.isActive ? \'border-slate-200\' : \'border-slate-200 opacity-60\'}`\n              }`}\n            >\n              {/* Card Top: Badges & Controls */}\n              <div className=\"flex items-start justify-between gap-2\">\n                <div className=\"space-y-1\">\n                  <div className=\"flex flex-wrap items-center gap-1.5\">\n                    <span\n                      className={`text-[10px] font-bold uppercase px-2 py-0.5 rounded-md border ${\n                        isWS\n                          ? isDark\n                            ? \'bg-emerald-500/15 text-emerald-300 border-emerald-500/30\'\n                            : \'bg-emerald-50 text-emerald-800 border-emerald-200\'\n                          : isDark\n                          ? \'bg-indigo-500/15 text-indigo-300 border-indigo-500/30\'\n                          : \'bg-indigo-50 text-indigo-800 border-indigo-200\'\n                      }`}\n                    >\n                      {isWS ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}\n                    </span>\n\n                    <span\n                      className={`text-[10px] font-medium px-2 py-0.5 rounded-md flex items-center gap-1 border ${\n                        isWS\n                          ? isDark\n                            ? \'bg-slate-950 text-emerald-400 border-slate-800\'\n                            : \'bg-emerald-50/70 text-emerald-700 border-emerald-200\'\n                          : isDark\n                          ? \'bg-slate-950 text-slate-400 border-slate-800\'\n                          : \'bg-slate-100 text-slate-600 border-slate-200\'\n                      }`}\n                    >\n                      {isWS ? (\n                        <>\n                          <ShieldCheck className=\"w-3 h-3 text-emerald-600\" />\n                          <span>Ch\341\272\241y \304\221\306\260\341\273\243c Facebook</span>\n                        </>\n                      ) : (\n                        <>\n                          <ShieldAlert className=\"w-3 h-3 text-slate-400\" />\n                          <span>Kh\303\264ng ch\341\272\241y Facebook</span>\n                        </>\n                      )}\n                    </span>\n\n                    {program.isBuiltin && (\n                      <span\n                        className={`text-[10px] px-1.5 py-0.5 rounded border ${\n                          isDark\n                            ? \'bg-slate-950 text-slate-400 border-slate-800\'\n                            : \'bg-slate-100 text-slate-500 border-slate-200\'\n                        }`}\n                      >\n                        H\341\273\207 th\341\273\221ng\n                      </span>\n                    )}\n                  </div>\n\n                  <h3 className={`font-bold text-sm leading-snug pt-0.5 ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n                    {program.title}\n                  </h3>\n                </div>\n\n                {/* Edit & Delete Controls */}\n                <div className=\"flex items-center space-x-1\">\n                  <button\n                    onClick={() => toggleProgramActive(program)}\n                    title={program.isActive ? \'T\341\272\241m ng\341\272\257t k\303\255ch ho\341\272\241t\' : \'K\303\255ch ho\341\272\241t\'}\n                    className={`p-1.5 rounded-lg border text-xs transition-colors cursor-pointer ${\n                      program.isActive\n                        ? isDark\n                          ? \'text-slate-400 hover:text-white bg-slate-950 border-slate-800\'\n                          : \'text-slate-500 hover:text-slate-800 bg-slate-50 border-slate-200\'\n                        : isDark\n                        ? \'text-emerald-400 bg-slate-950 border-emerald-800/60\'\n                        : \'text-emerald-600 bg-emerald-50 border-emerald-200\'\n                    }`}\n                  >\n                    {program.isActive ? <Eye className=\"w-3.5 h-3.5\" /> : <EyeOff className=\"w-3.5 h-3.5\" />}\n                  </button>\n                  <button\n                    onClick={() => setEditingProgram(program)}\n                    title=\"Ch\341\273\211nh s\341\273\255a\"\n                    className={`p-1.5 rounded-lg border transition-all cursor-pointer ${\n                      isDark\n                        ? \'text-slate-400 hover:text-indigo-300 hover:bg-slate-800 border-slate-800 bg-slate-950\'\n                        : \'text-slate-500 hover:text-indigo-600 hover:bg-slate-100 border-slate-200 bg-slate-50\'\n                    }`}\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => onDeleteProgram(program.id)}\n                    title=\"X\303\263a\"\n                    className={`p-1.5 rounded-lg border transition-all cursor-pointer ${\n                      isDark\n                        ? \'text-slate-400 hover:text-rose-400 hover:bg-slate-800 border-slate-800 bg-slate-950\'\n                        : \'text-slate-500 hover:text-rose-600 hover:bg-rose-50 border-slate-200 bg-slate-50\'\n                    }`}\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              {/* Description */}\n              <p className={`text-xs leading-relaxed ${isDark ? \'text-slate-300\' : \'text-slate-600\'}`}>\n                {program.description}\n              </p>\n\n              {/* Target Audience & Pain Points */}\n              <div\n                className={`space-y-2 pt-2 border-t text-xs ${\n                  isDark ? \'border-slate-800/80\' : \'border-slate-100\'\n                }`}\n              >\n                {program.targetAudience?.length > 0 && (\n                  <div>\n                    <span\n                      className={`text-[11px] font-semibold block mb-1 ${\n                        isDark ? \'text-indigo-300\' : \'text-indigo-900\'\n                      }`}\n                    >\n                      \360\237\216\257 \304\220\341\273\221i t\306\260\341\273\243ng ph\303\271 h\341\273\243p:\n                    </span>\n                    <div className=\"flex flex-wrap gap-1\">\n                      {program.targetAudience.map((aud, i) => (\n                        <span\n                          key={i}\n                          className={`px-2 py-0.5 rounded-md border text-[11px] ${\n                            isDark\n                              ? \'bg-slate-950 text-slate-300 border-slate-800\'\n                              : \'bg-slate-100 text-slate-700 border-slate-200\'\n                          }`}\n                        >\n                          {aud}\n                        </span>\n                      ))}\n                    </div>\n                  </div>\n                )}\n\n                {program.painPoints?.length > 0 && (\n                  <div>\n                    <span\n                      className={`text-[11px] font-semibold block mb-1 ${\n                        isDark ? \'text-rose-300\' : \'text-rose-900\'\n                      }`}\n                    >\n                      \342\232\241 N\341\273\227i \304\221au gi\341\272\243i quy\341\272\277t (Pain Points):\n                    </span>\n                    <ul\n                      className={`list-disc list-inside text-[11px] space-y-0.5 ${\n                        isDark ? \'text-slate-400\' : \'text-slate-600\'\n                      }`}\n                    >\n                      {program.painPoints.slice(0, 2).map((point, i) => (\n                        <li key={i} className=\"line-clamp-1\">\n                          {point}\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                )}\n\n                {program.testOrFormAngle && (\n                  <div>\n                    <span\n                      className={`text-[11px] font-semibold block mb-1 ${\n                        isDark ? \'text-emerald-300\' : \'text-emerald-900\'\n                      }`}\n                    >\n                      \360\237\223\213 G\303\263c ti\341\272\277p c\341\272\255n b\303\240i test / form 1-1:\n                    </span>\n                    <p\n                      className={`text-[11px] italic p-2 rounded-lg border select-all ${\n                        isDark\n                          ? \'text-slate-300 bg-slate-950/80 border-slate-800/80\'\n                          : \'text-slate-700 bg-emerald-50/50 border-emerald-100\'\n                      }`}\n                    >\n                      \"{program.testOrFormAngle}\"\n                    </p>\n                  </div>\n                )}\n              </div>\n            </div>\n          );\n        })}\n      </div>\n\n      {/* Add / Extract Modal */}\n      {isAddModalOpen && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\">\n          <div\n            className={`border rounded-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto p-6 space-y-5 shadow-2xl ${\n              isDark ? \'bg-slate-900 border-slate-800\' : \'bg-white border-slate-200\'\n            }`}\n          >\n            <div className={`flex items-center justify-between border-b pb-3 ${isDark ? \'border-slate-800\' : \'border-slate-200\'}`}>\n              <div>\n                <h3 className={`font-bold text-base ${isDark ? \'text-white\' : \'text-slate-900\'}`}>\n                  Th\303\252m Workshop / Ch\306\260\306\241ng Tr\303\254nh\n                </h3>\n                <p className={`text-xs mt-0.5 ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>\n                  D\303\241n link Tally, Form ho\341\272\267c text m\303\264 t\341\272\243 \304\221\341\273\203 AI t\341\273\261 \304\221\341\273\231ng b\303\263c t\303\241ch ki\341\272\277n th\341\273\251c\n                </p>\n              </div>\n              <button\n                onClick={() => {\n                  setIsAddModalOpen(false);\n                  setDraftProgram(null);\n                }}\n                className={`p-1 rounded-lg cursor-pointer ${\n                  isDark ? \'text-slate-400 hover:text-white hover:bg-slate-800\' : \'text-slate-500 hover:text-slate-800 hover:bg-slate-100\'\n                }`}\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {!draftProgram ? (\n              /* Step 1: Input link / text / image */\n              <div className=\"space-y-4\">\n                <div>\n                  <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                    1. D\303\241n Link Tally ho\341\272\267c Google Form (T\303\271y ch\341\273\215n)\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"url\"\n                      value={inputUrl}\n                      onChange={(e) => setInputUrl(e.target.value)}\n                      placeholder=\"https://storage.tally.so/... ho\341\272\267c https://forms.gle/...\"\n                      className={`w-full border rounded-xl pl-9 pr-4 py-2 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 ${\n                        isDark\n                          ? \'bg-slate-950 border-slate-800 text-slate-200 placeholder-slate-500 focus:border-indigo-500\'\n                          : \'bg-slate-50 border-slate-300 text-slate-900 placeholder-slate-400 focus:border-indigo-600 focus:bg-white\'\n                      }`}\n                    />\n                    <LinkIcon className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-2.5\" />\n                  </div>\n                </div>\n\n                <div>\n                  <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                    2. Ho\341\272\267c D\303\241n N\341\273\231i Dung M\303\264 T\341\272\243 / Copy t\341\273\253 Tally (\304\220\306\260\341\273\243c khuy\303\252n d\303\271ng)\n                  </label>\n                  <textarea\n                    value={inputText}\n                    onChange={(e) => setInputText(e.target.value)}\n                    placeholder=\"D\303\241n to\303\240n b\341\273\231 n\341\273\231i dung gi\341\273\233i thi\341\273\207u ch\306\260\306\241ng tr\303\254nh, n\341\273\227i \304\221au, gi\303\241 tr\341\273\213, quy\341\273\201n l\341\273\243i...\"\n                    rows={5}\n                    className={`w-full border rounded-xl p-3 text-xs focus:outline-none focus:ring-1 focus:ring-indigo-500 font-sans ${\n                      isDark\n                        ? \'bg-slate-950 border-slate-800 text-slate-200 placeholder-slate-500 focus:border-indigo-500\'\n                        : \'bg-slate-50 border-slate-300 text-slate-900 placeholder-slate-400 focus:border-indigo-600 focus:bg-white\'\n                    }`}\n                  />\n                </div>\n\n                <div>\n                  <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                    3. T\341\272\243i \341\272\242nh Poster / Banner (T\303\271y ch\341\273\215n)\n                  </label>\n                  <label\n                    className={`flex items-center justify-center p-2.5 border border-dashed rounded-xl cursor-pointer ${\n                      isDark\n                        ? \'border-slate-800 bg-slate-950/60 hover:bg-slate-950\'\n                        : \'border-slate-300 bg-slate-50 hover:bg-slate-100\'\n                    }`}\n                  >\n                    <Upload className=\"w-3.5 h-3.5 text-slate-400 mr-2\" />\n                    <span className={`text-xs ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                      {inputImageBase64 ? \'\342\234\223 \304\220\303\243 ch\341\273\215n file \341\272\243nh\' : \'Ch\341\273\215n file \341\272\243nh poster\'}\n                    </span>\n                    <input\n                      type=\"file\"\n                      accept=\"image/*\"\n                      onChange={handleImageSelect}\n                      className=\"hidden\"\n                    />\n                  </label>\n                </div>\n\n                {extractError && (\n                  <div className=\"p-3 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-800 flex items-center gap-2\">\n                    <AlertCircle className=\"w-4 h-4 flex-shrink-0 text-rose-600\" />\n                    <span>{extractError}</span>\n                  </div>\n                )}\n\n                <div className=\"flex justify-end gap-2 pt-2\">\n                  <button\n                    onClick={() => setIsAddModalOpen(false)}\n                    className={`px-4 py-2 rounded-xl text-xs font-semibold cursor-pointer ${\n                      isDark ? \'text-slate-400 hover:bg-slate-800\' : \'text-slate-600 hover:bg-slate-100\'\n                    }`}\n                  >\n                    H\341\273\247y\n                  </button>\n                  <button\n                    onClick={handleExtract}\n                    disabled={isExtracting}\n                    className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition-all flex items-center space-x-2 disabled:opacity-50 cursor-pointer shadow-sm\"\n                  >\n                    {isExtracting ? (\n                      <>\n                        <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                        <span>\304\220ang b\303\263c t\303\241ch d\341\273\257 li\341\273\207u...</span>\n                      </>\n                    ) : (\n                      <>\n                        <Sparkles className=\"w-3.5 h-3.5\" />\n                        <span>B\303\263c T\303\241ch & H\341\273\215c D\341\273\257 Li\341\273\207u</span>\n                      </>\n                    )}\n                  </button>\n                </div>\n              </div>\n            ) : (\n              /* Step 2: Review & Edit extracted draft */\n              <div className=\"space-y-4\">\n                <div className=\"p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 flex items-center gap-2\">\n                  <Check className=\"w-4 h-4 text-emerald-600 flex-shrink-0\" />\n                  <span>AI \304\221\303\243 b\303\263c t\303\241ch th\303\240nh c\303\264ng! Vui l\303\262ng ki\341\273\203m tra l\341\272\241i tr\306\260\341\273\233c khi l\306\260u.</span>\n                </div>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                  <div>\n                    <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                      T\303\252n Workshop / CT\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={draftProgram.title || \'\'}\n                      onChange={(e) => setDraftProgram({ ...draftProgram, title: e.target.value })}\n                      className={`w-full border rounded-xl px-3 py-2 text-xs ${\n                        isDark ? \'bg-slate-950 border-slate-800 text-white\' : \'bg-slate-50 border-slate-300 text-slate-900\'\n                      }`}\n                    />\n                  </div>\n\n                  <div>\n                    <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                      Ph\303\242n lo\341\272\241i\n                    </label>\n                    <select\n                      value={draftProgram.type || \'ws\'}\n                      onChange={(e) =>\n                        setDraftProgram({ ...draftProgram, type: e.target.value as ProgramType })\n                      }\n                      className={`w-full border rounded-xl px-3 py-2 text-xs ${\n                        isDark ? \'bg-slate-950 border-slate-800 text-white\' : \'bg-slate-50 border-slate-300 text-slate-900\'\n                      }`}\n                    >\n                      <option value=\"ws\">Workshop (WS - \304\220\306\260\341\273\243c ch\341\272\241y tr\303\252n Facebook)</option>\n                      <option value=\"ct\">Ch\306\260\306\241ng tr\303\254nh (CT - Kh\303\264ng ch\341\272\241y Facebook)</option>\n                    </select>\n                  </div>\n                </div>\n\n                <div>\n                  <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                    M\303\264 t\341\272\243 ng\341\272\257n\n                  </label>\n                  <textarea\n                    value={draftProgram.description || \'\'}\n                    onChange={(e) =>\n                      setDraftProgram({ ...draftProgram, description: e.target.value })\n                    }\n                    rows={2}\n                    className={`w-full border rounded-xl p-2.5 text-xs ${\n                      isDark ? \'bg-slate-950 border-slate-800 text-white\' : \'bg-slate-50 border-slate-300 text-slate-900\'\n                    }`}\n                  />\n                </div>\n\n                <div>\n                  <label className={`text-xs font-semibold block mb-1 ${isDark ? \'text-slate-300\' : \'text-slate-700\'}`}>\n                    G\303\263c ti\341\272\277p c\341\272\255n b\303\240i test / form 1-1\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={draftProgram.testOrFormAngle || \'\'}\n                    onChange={(e) =>\n                      setDraftProgram({ ...draftProgram, testOrFormAngle: e.target.value })\n                    }\n                    className={`w-full border rounded-xl px-3 py-2 text-xs ${\n                      isDark ? \'bg-slate-950 border-slate-800 text-white\' : \'bg-slate-50 border-slate-300 text-slate-900\'\n                    }`}\n                  />\n                </div>\n\n                <div className={`flex justify-between items-center pt-3 border-t ${isDark ? \'border-slate-800\' : \'border-slate-200\'}`}>\n                  <button\n                    onClick={() => setDraftProgram(null)}\n                    className={`px-3 py-1.5 text-xs cursor-pointer ${\n                      isDark ? \'text-slate-400 hover:text-white\' : \'text-slate-600 hover:text-slate-900\'\n                    }`}\n                  >\n                    \342\206\220 B\303\263c t\303\241ch l\341\272\241i\n                  </button>\n                  <button\n                    onClick={handleSaveDraft}\n                    className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold shadow-md flex items-center space-x-1.5 cursor-pointer\"\n                  >\n                    <Check className=\"w-3.5 h-3.5\" />\n           