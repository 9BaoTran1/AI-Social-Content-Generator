        }
        lines {
          text: "      \'B\303\271 \304\221\341\272\257p kho\341\272\243ng c\303\241ch gi\341\273\257a l\303\275 thuy\341\272\277t \304\221\341\272\241i h\341\273\215c v\303\240 th\341\273\261c chi\341\272\277n th\341\273\213 tr\306\260\341\273\235ng\',"
