          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'D\341\273\205 m\341\272\245t t\341\272\255p trung, thi\341\272\277u ki\303\252n nh\341\272\253n, ph\303\242n t\303\241n n\304\203ng l\306\260\341\273\243ng v\303\240o nhi\341\273\201u vi\341\273\207c nh\341\273\217 nh\341\272\267t\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Kh\303\263 kh\304\203n trong vi\341\273\207c d\303\241m c\341\272\257t b\341\273\217 m\341\273\245c ti\303\252u ph\341\273\245 \304\221\341\273\203 d\341\273\223n t\303\242m s\341\273\251c cho \304\221i\341\273\201u c\341\273\221t l\303\265i\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'C\341\272\241n ki\341\273\207t n\304\203ng l\306\260\341\273\243ng th\341\273\203 ch\341\272\245t v\303\240 tinh th\341\272\247n gi\341\273\257a nh\341\273\213p s\341\273\221ng s\341\273\221\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
