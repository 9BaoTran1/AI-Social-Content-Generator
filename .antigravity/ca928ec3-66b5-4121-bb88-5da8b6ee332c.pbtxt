        lines {
          text: "    targetAudience: [\'Ng\306\260\341\273\235i d\341\273\205 b\341\273\217 cu\341\273\231c tr\306\260\341\273\233c kh\303\263 kh\304\203n\', \'Ng\306\260\341\273\235i b\341\273\213 \341\272\243nh h\306\260\341\273\237ng b\341\273\237i th\303\263i quen m\303\254 \304\203n li\341\273\201n\', \'Sinh vi\303\252n v\303\240 ng\306\260\341\273\235i tr\341\272\273 20-30 tu\341\273\225i\'],"
