        lines {
          text: "    painPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'H\341\273\215c gi\341\273\217i tr\303\252n tr\306\260\341\273\235ng nh\306\260ng m\303\264ng lung, thi\341\272\277u t\341\273\261 tin khi b\306\260\341\273\233c ra ngo\303\240i \304\221i l\303\240m\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Lo l\341\272\257ng kh\303\264ng \304\221\341\273\247 n\304\203ng l\341\273\261c c\341\272\241nh tranh, thi\341\272\277u k\341\273\271 n\304\203ng gi\341\272\243i quy\341\272\277t t\303\254nh hu\341\273\221ng th\341\273\261c t\341\272\277\',"
