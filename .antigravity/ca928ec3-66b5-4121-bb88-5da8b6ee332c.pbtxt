  toneGuideline: \'Trung l\341\272\255p, \304\221\304\251nh \304\221\341\272\241c, ph\303\242n t\303\255ch hai chi\341\273\201u. H\341\273\217i r\303\265 xem c\303\263 c\341\272\247n g\341\272\257n link \304\221\304\203ng k\303\275 hay gi\341\273\233i thi\341\273\207u Workshop \341\273\237 cu\341\273\221i b\303\240i kh\303\264ng.\',\n    defaultPrompt: \'Vi\341\272\277t b\303\240i Facebook ph\303\242n t\303\255ch chuy\303\252n s\303\242u v\341\273\201 v\341\272\245n \304\221\341\273\201 n\303\240y v\303\240 d\341\272\253n d\341\272\257t v\303\240o Workshop.\'\n  },\n  {\n    id: \'order_4\',\n    orderNumber: 4,\n    title: \'Comment Threads\',\n    platform: \'Threads\',\n    category: \'comment\',\n    allowedTypes: [\'ws\', \'ct\'],\n    description: \'Comment Threads ch\303\242n th\341\272\255t, ng\341\272\257n g\341\273\215n, gi\303\240u t\303\255nh t\341\273\261 s\341\273\261 (storytelling), d\341\273\205 ch\341\272\241m v\303\240o n\341\273\227i \304\221au n\341\273\231i t\303\242m c\341\273\247a ng\306\260\341\273\235i \304\221\341\273\215c.\',\n    toneGuideline: \'V\304\203n phong th\341\273\247 th\341\273\211, s\303\242u l\341\272\257ng, c\303\241 nh\303\242n h\303\263a cao, g\341\273\243i m\341\273\237 t\303\242m s\341\273\261 \304\221\341\273\203 ng\306\260\341\273\235i xem mu\341\273\221n ch\341\273\247 \304\221\341\273\231ng nh\341\272\257n tin.\',\n    defaultPrompt: \'T\341\272\241o comment Threads ch\341\272\241m c\341\272\243m x\303\272c v\303\240 chuy\341\273\203n \304\221\341\273\225i th\303\240nh inbox.\'\n  },\n  {\n    id: \'order_5\',\n    orderNumber: 5,\n    title: \'Vi\341\272\277t b\303\240i Threads\',\n    platform: \'Threads\',\n    category: \'post\',\n    allowedTypes: [\'ws\', \'ct\'],\n    description: \'B\303\240i \304\221\304\203ng Threads ng\341\272\257n g\341\273\215n, ng\341\272\257t d\303\262ng nh\341\273\213p nh\303\240ng, hook thu h\303\272t, insight s\341\272\257c b\303\251n v\303\240 CTA t\341\273\261 nhi\303\252n v\341\2