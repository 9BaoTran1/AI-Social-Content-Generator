order border-slate-800/90 rounded-2xl p-4 space-y-3 shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between border-b border-slate-800/80 pb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-bold text-white\">{item.orderTitle}</span>\n                      <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium\">\n                        {item.platform}\n                      </span>\n                      <span className=\"text-xs text-indigo-400\">D\341\273\261 \303\241n: {item.programTitle}</span>\n                    </div>\n                    <span className=\"text-[10px] text-slate-500\">\n                      {new Date(item.createdAt).toLocaleString(\'vi-VN\')}\n                    </span>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    {item.variations.map((v, idx) => (\n                      <div\n                        key={idx}\n                        className=\"bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-1 text-xs\"\n                      >\n                        <div className=\"flex justify-between items-center text-[10px] font-bold text-slate-400\">\n                          <span>M\341\272\253u {idx + 1}</span>\n                          <button\n                            onClick={() => copyText(v, `hist-${item.id}-${idx}`)}\n                            className=\"text-indigo-400 hover:text-indigo-300\"\n                          >\n                            {copiedId === `hist-${item.id}-${idx}` ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                          </button>\n                        </div>\n                        <p className=\"text-slate-200 leading-relaxed whitespace-pre-line\">{v}</p>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n      )}\n\n      {/* SUBTAB 3: BENCHMARK TEMPLATES */}\n      {subTab === \'benchmark\' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {BENCHMARK_TEMPLATES.map((tmpl) => (\n            <div\n              key={tmpl.id}\n              className=\"bg-slate-900/90 border border-slate-800/90 rounded-2xl p-5 space-y-3 shadow-sm\"\n            >\n              <div className=\"flex items-center justify-between border-b border-slate-800 pb-2\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-xs font-bold text-white\">{tmpl.title}</span>\n                  <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300\">\n                    {tmpl.platform}\n                  </span>\n                </div>\n                <button\n                  onClick={() => copyText(tmpl.content, `tmpl-${tmpl.id}`)}\n                  className=\"text-xs text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n                >\n                  <Copy className=\"w-3 h-3\" />\n                  <span>{copiedId === `tmpl-${tmpl.id}` ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}</span>\n                </button>\n              </div>\n\n              <p className=\"text-xs text-slate-200 leading-relaxed bg-slate-950 p-3 rounded-xl border border-slate-800 whitespace-pre-line font-sans select-all\">\n                {tmpl.content}\n              </p>\n\n              <div className=\"text-[11px] text-slate-400 bg-slate-950/60 p-2 rounded-lg border border-slate-800/60\">\n                \360\237\222\241 <strong className=\"text-slate-300\">Insight ph\303\242n t\303\255ch:</strong> {tmpl.keyInsight}\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};"
