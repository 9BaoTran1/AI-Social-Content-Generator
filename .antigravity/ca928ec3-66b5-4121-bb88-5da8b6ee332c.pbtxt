    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Sparkles, BookOpen, Bot, Plus, Layers, Clock } from \'lucide-react\';\n\ninterface NavbarProps {\n  activeTab: \'workbench\' | \'programs\' | \'assistant\';\n  setActiveTab: (tab: \'workbench\' | \'programs\' | \'assistant\') => void;\n  onOpenAddProgram: () => void;\n  programCount: { ws: number; ct: number };\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAddProgram,\n  programCount,\n}) => {\n  return (\n    <header className=\"sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 text-slate-100\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Clean Title */}\n          <div\n            className=\"flex items-center space-x-3 cursor-pointer group\"\n            onClick={() => setActiveTab(\'workbench\')}\n          >\n            <div className=\"w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-sm group-hover:bg-indigo-500 transition-colors\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-bold text-base tracking-tight text-white font-sans\">\n                  PROMPT ORDER AI\n                </span>\n                <span className=\"text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700/60\">\n                  Social Conversion\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-400 hidden sm:block\">\n                H\341\273\207 th\341\273\221ng 7 Order chuy\341\273\203n \304\221\341\273\225i Comment th\303\240nh Inbox\n              </p>\n            </div>\n          </div>\n\n          {/* Clean 3 Main Tabs */}\n          <nav className=\"flex items-center space-x-1 bg-slate-900/90 p-1 rounded-xl border border-slate-800/80\">\n            <button\n              onClick={() => setActiveTab(\'workbench\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'workbench\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-850\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Studio T\341\272\241o Content</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'programs\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'programs\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-850\'\n              }`}\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Kho WS/CT ({programCount.ws + programCount.ct})</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'assistant\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all ${\n                activeTab === \'assistant\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-slate-200 hover:bg-slate-850\'\n              }`}\n            >\n              <Bot className=\"w-3.5 h-3.5\" />\n              <span>Tr\341\273\243 L\303\275 & L\341\273\213ch S\341\273\255</span>\n            </button>\n          </nav>\n\n          {/* Clean Add Action */}\n          <div className=\"flex items-center space-x-2\">\n            <button\n              onClick={onOpenAddProgram}\n              className=\"px-3.5 py-1.5 text-xs font-semibold rounded-xl bg-slate-850 hover:bg-slate-800 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all flex items-center space-x-1.5 cursor-pointer\"\n            >\n              <Plus className=\"w-3.5 h-3.5 text-indigo-400\" />\n              <span className=\"hidden sm:inline\">Th\303\252m Workshop / CT</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { Sparkles, BookOpen, Bot, Plus, Sun, Moon } from \'lucide-react\';\nimport { ThemeMode } from \'../types\';\n\ninterface NavbarProps {\n  activeTab: \'workbench\' | \'programs\' | \'assistant\';\n  setActiveTab: (tab: \'workbench\' | \'programs\' | \'assistant\') => void;\n  onOpenAddProgram: () => void;\n  programCount: { ws: number; ct: number };\n  theme: ThemeMode;\n  onToggleTheme: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAddProgram,\n  programCount,\n  theme,\n  onToggleTheme,\n}) => {\n  const isDark = theme === \'dark\';\n\n  return (\n    <header\n      className={`sticky top-0 z-40 backdrop-blur-md transition-colors ${\n        isDark\n          ? \'bg-slate-950/90 border-b border-slate-800/80 text-slate-100\'\n          : \'bg-white/95 border-b border-slate-200/90 text-slate-900 shadow-xs\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Clean Title */}\n          <div\n            className=\"flex items-center space-x-3 cursor-pointer group\"\n            onClick={() => setActiveTab(\'workbench\')}\n          >\n            <div className=\"w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-sm group-hover:bg-indigo-500 transition-colors\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span\n                  className={`font-bold text-base tracking-tight font-sans ${\n                    isDark ? \'text-white\' : \'text-slate-900\'\n                  }`}\n                >\n                  PROMPT ORDER AI\n                </span>\n                <span\n                  className={`text-[10px] font-medium px-2 py-0.5 rounded-full border ${\n                    isDark\n                      ? \'bg-slate-800 text-slate-300 border-slate-700/60\'\n                      : \'bg-slate-100 text-slate-700 border-slate-200\'\n                  }`}\n                >\n                  Social Conversion\n                </span>\n              </div>\n              <p\n                className={`text-[11px] hidden sm:block ${\n                  isDark ? \'text-slate-400\' : \'text-slate-500\'\n                }`}\n              >\n                H\341\273\207 th\341\273\221ng 7 Order chuy\341\273\203n \304\221\341\273\225i Comment th\303\240nh Inbox\n              </p>\n            </div>\n          </div>\n\n          {/* Clean 3 Main Tabs */}\n          <nav\n            className={`flex items-center space-x-1 p-1 rounded-xl border ${\n              isDark\n                ? \'bg-slate-900/90 border-slate-800/80\'\n                : \'bg-slate-100 border-slate-200\'\n            }`}\n          >\n            <button\n              onClick={() => setActiveTab(\'workbench\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all cursor-pointer ${\n                activeTab === \'workbench\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-white\'\n              }`}\n            >\n              <Sparkles className=\"w-3.5 h-3.5\" />\n              <span>Studio T\341\272\241o Content</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'programs\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all cursor-pointer ${\n                activeTab === \'programs\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-white\'\n              }`}\n            >\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Kho WS/CT ({programCount.ws + programCount.ct})</span>\n            </button>\n\n            <button\n              onClick={() => setActiveTab(\'assistant\')}\n              className={`px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition-all cursor-pointer ${\n                activeTab === \'assistant\'\n                  ? \'bg-indigo-600 text-white shadow-sm\'\n                  : isDark\n                  ? \'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60\'\n                  : \'text-slate-600 hover:text-slate-900 hover:bg-white\'\n              }`}\n            >\n              <Bot className=\"w-3.5 h-3.5\" />\n              <span>Tr\341\273\243 L\303\275 & L\341\273\213ch S\341\273\255</span>\n            </button>\n          </nav>\n\n          {/* Actions: Theme Toggle & Add Button */}\n          <div className=\"flex items-center space-x-2\">\n            {/* Theme Toggle Button */}\n            <button\n              onClick={onToggleTheme}\n              title={isDark ? \'Chuy\341\273\203n sang giao di\341\273\207n S\303\241ng\' : \'Chuy\341\273\203n sang giao di\341\273\207n T\341\273\221i\'}\n              className={`p-2 rounded-xl border text-xs font-medium transition-all flex items-center gap-1.5 cursor-pointer ${\n                isDark\n                  ? \'bg-slate-900 hover:bg-slate-800 text-amber-300 border-slate-700/80\'\n                  : \'bg-white hover:bg-slate-50 text-indigo-600 border-slate-200 shadow-xs\'\n              }`}\n            >\n              {isDark ? (\n                <>\n                  <Sun className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span className=\"hidden sm:inline text-[11px] text-slate-300\">B\341\272\243n s\303\241ng</span>\n                </>\n              ) : (\n                <>\n                  <Moon className=\"w-3.5 h-3.5 text-indigo-600\" />\n                  <span className=\"hidden sm:inline text-[11px] text-slate-700 font-semibold\">B\341\272\243n t\341\273\221i</span>\n                </>\n              )}\n            </button>\n\n            {/* Add Program Button */}\n            <button\n              onClick={onOpenAddProgram}\n              className={`px-3.5 py-1.5 text-xs font-semibold rounded-xl border transition-all flex items-center space-x-1.5 cursor-pointer ${\n                isDark\n                  ? \'bg-slate-900 hover:bg-slate-800 text-slate-200 border-slate-700/80\'\n                  : \'bg-white hover:bg-slate-50 text-slate-800 border-slate-200 shadow-xs\'\n              }`}\n            >\n              <Plus className=\"w-3.5 h-3.5 text-indigo-600\" />\n              <span className=\"hidden sm:inline\">Th\303\252m WS / CT</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};"
