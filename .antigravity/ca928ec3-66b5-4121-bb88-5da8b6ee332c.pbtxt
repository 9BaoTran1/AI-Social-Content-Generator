        lines {
          text: "    description: \'Trang b\341\273\213 n\304\203ng l\341\273\261c th\341\273\261c chi\341\272\277n, b\341\272\243n l\304\251nh \341\273\251ng bi\341\272\277n \303\241p l\341\273\261c, k\341\273\271 n\304\203ng giao ti\341\272\277p h\341\273\243p t\303\241c v\303\240 t\306\260 duy gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201 d\303\240nh ri\303\252ng cho sinh vi\303\252n chu\341\272\251n b\341\273\213 ra tr\306\260\341\273\235ng.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
