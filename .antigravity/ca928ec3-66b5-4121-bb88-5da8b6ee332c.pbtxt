        }
        lines {
          text: "    painPoints: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'C\341\272\243m gi\303\241c b\341\272\277 t\341\272\257c khi cu\341\273\231c \304\221\341\273\235i kh\303\264ng di\341\273\205n ra nh\306\260 k\341\273\213ch b\341\272\243n mong mu\341\273\221n\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'Mang c\341\272\243m gi\303\241c th\341\272\245t b\341\272\241i, t\341\273\261 tr\303\241ch ho\341\272\267c kh\303\264ng d\303\241m b\341\272\257t \304\221\341\272\247u l\341\272\241i\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'S\341\273\221ng v\303\254 s\341\273\261 k\341\273\263 v\341\273\215ng c\341\273\247a x\303\243 h\341\273\231i m\303\240 qu\303\252n m\341\272\245t m\303\254nh th\341\273\261c s\341\273\261 l\303\240 ai\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    coreValues: ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'N\306\241i \304\221\306\260\341\273\243c b\303\240y t\341\273\217: K\341\273\203 c\303\242u chuy\341\273\207n, suy ngh\304\251 v\303\240 tr\304\203n tr\341\273\237 th\341\272\255t c\341\273\247a b\341\272\243n th\303\242n\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'N\306\241i \304\221\306\260\341\273\243c l\341\272\257ng nghe & chia s\341\272\273: C\303\271ng ng\306\260\341\273\235i c\303\263 chuy\303\252n m\303\264n v\303\240 nh\341\273\257ng ng\306\260\341\273\235i \304\221\341\273\223ng h\303\240nh\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      \'N\306\241i soi chi\341\272\277u: Nh\341\272\255n ra m\303\254nh l\303\240 ai, m\303\254nh \304\221ang c\303\263 g\303\254 v\303\240 mu\341\273\221n tr\341\273\237 th\303\240nh ng\306\260\341\273\235i nh\306\260 th\341\272\277 n\303\240o\',"
