  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express, { Request, Response } from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport { createServer as createViteServer } from \'vite\';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json({ limit: \'20mb\' }));\n\n// Lazy initialize GoogleGenAI with telemetry header\nlet aiClient: GoogleGenAI | null = null;\nfunction getAi(): GoogleGenAI {\n  if (!aiClient) {\n    const apiKey = process.env.GEMINI_API_KEY;\n    if (!apiKey) {\n      console.warn(\'GEMINI_API_KEY is not set. Using fallback mode.\');\n    }\n    aiClient = new GoogleGenAI({\n      apiKey: apiKey || \'\',\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.json({ status: \'ok\', timestamp: new Date().toISOString() });\n});\n\n// 1. Extract Program/Workshop from Link, Raw Text, or Image\napp.post(\'/api/extract-program\', async (req: Request, res: Response) => {\n  try {\n    const { url, text, imageBase64 } = req.body;\n\n    if (!url && !text && !imageBase64) {\n      return res.status(400).json({ error: \'Vui l\303\262ng cung c\341\272\245p link Tally/Google Forms, n\341\273\231i dung v\304\203n b\341\272\243n ho\341\272\267c h\303\254nh \341\272\243nh.\' });\n    }\n\n    const ai = getAi();\n    const systemPrompt = `B\341\272\241n l\303\240 m\341\273\231t chuy\303\252n gia ph\303\242n t\303\255ch n\341\273\231i dung Social Media v\303\240 Qu\341\272\243n l\303\275 \304\220\303\240o t\341\272\241o (10 n\304\203m kinh nghi\341\273\207m).\nNhi\341\273\207m v\341\273\245 c\341\273\247a b\341\272\241n l\303\240 b\303\263c t\303\241ch v\303\240 ph\303\242n t\303\255ch th\303\264ng tin c\341\273\247a Workshop (WS) ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh (CT) t\341\273\253 link Tally, Google Forms, text m\303\264 t\341\272\243 ho\341\272\267c h\303\254nh \341\272\243nh \304\221\306\260\341\273\243c cung c\341\272\245p.\n\nQUY T\341\272\256C PH\303\202N LO\341\272\240I & \304\220\341\272\266C \304\220I\341\273\202M C\341\273\220T L\303\225I:\n- Ph\303\242n lo\341\272\241i r\303\265: \'ws\' (Workshop / Talkshow / Bu\341\273\225i chia s\341\272\273 ng\341\272\257n h\341\272\241n) ho\341\272\267c \'ct\' (Ch\306\260\306\241ng tr\303\254nh / Kh\303\263a h\341\273\215c / H\303\240nh tr\303\254nh nhi\341\273\201u b\306\260\341\273\233c / B\303\240i test \304\221\341\273\213nh v\341\273\213).\n- T\341\272\244T C\341\272\242 c\303\241c ch\306\260\306\241ng tr\303\254nh/workshop \304\221\341\273\201u KH\303\224NG nh\341\272\261m m\341\273\245c \304\221\303\255ch h\306\260\341\273\233ng nghi\341\273\207p k\341\273\271 n\304\203ng c\341\273\251ng hay ki\341\272\277m ti\341\273\201n, m\303\240 t\341\272\255p trung v\303\240o: th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n, nh\341\272\255n di\341\273\207n th\341\272\277 m\341\272\241nh, s\341\273\251c b\341\273\201n tinh th\341\272\247n, gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng, t\306\260 duy giao ti\341\272\277p v\303\240 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n.\n- Kh\303\264ng g\303\241n \303\251p template cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech, Y t\341\272\277...).\n- Ng\306\260\341\273\235i tham d\341\273\261 l\303\240 ng\306\260\341\273\235i mu\341\273\221n hi\341\273\203u m\303\254nh v\303\240 l\303\240m b\341\272\243n th\303\242n t\341\273\221t h\306\241n, kh\303\264ng ph\341\272\243i \304\221\341\272\277n \304\221\341\273\203 l\303\240m di\341\273\205n gi\341\272\243 hay d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n\nH\303\243y tr\303\255ch xu\341\272\245t v\303\240 tr\341\272\243 v\341\273\201 \304\221\341\273\213nh d\341\272\241ng JSON ch\303\255nh x\303\241c:\n{\n  \"title\": \"T\303\252n WS ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh\",\n  \"type\": \"ws\" | \"ct\",\n  \"description\": \"M\303\264 t\341\272\243 s\303\272c t\303\255ch v\341\273\201 gi\303\241 tr\341\273\213 v\303\240 m\341\273\245c ti\303\252u (2-3 c\303\242u)\",\n  \"targetAudience\": [\"\304\220\341\273\221i t\306\260\341\273\243ng 1 (k\303\250m \304\221\341\273\231 tu\341\273\225i n\341\272\277u c\303\263)\", \"\304\220\341\273\221i t\306\260\341\273\243ng 2\", \"\304\220\341\273\221i t\306\260\341\273\243ng 3\"],\n  \"painPoints\": [\"N\341\273\227i \304\221au 1\", \"N\341\273\227i \304\221au 2\", \"N\341\273\227i \304\221au 3\"],\n  \"coreValues\": [\"Gi\303\241 tr\341\273\213 mang l\341\272\241i 1\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 2\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 3\"],\n  \"testOrFormAngle\": \"M\303\264 t\341\272\243 g\303\263c ti\341\272\277p c\341\272\255n form/b\303\240i test (v\303\255 d\341\273\245: Template \304\221\303\241nh gi\303\241 t\303\255nh c\303\241ch & tham v\341\272\245n 1-1, Test \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n)\",\n  \"imageUrl\": \"Link \341\272\243nh n\341\272\277u t\303\254m th\341\272\245y trong text/link (ho\341\272\267c \304\221\341\273\203 tr\341\273\221ng)\",\n  \"tallyUrl\": \"Link Tally ho\341\272\267c Form n\341\272\277u c\303\263\",\n  \"notes\": \"Ghi ch\303\272 th\303\252m v\341\273\201 tone & mood ho\341\272\267c l\306\260u \303\275 \304\221\341\272\267c th\303\271\"\n}`;\n\n    const promptText = `H\303\243y ph\303\242n t\303\255ch v\303\240 tr\303\255ch xu\341\272\245t th\303\264ng tin Workshop / Ch\306\260\306\241ng tr\303\254nh t\341\273\253 d\341\273\257 li\341\273\207u sau:\n${url ? `Link Form / Tally: ${url}\\n` : \'\'}\n${text ? `N\341\273\231i dung m\303\264 t\341\272\243 / Text:\\n${text}\\n` : \'\'}`;\n\n    const contents: any[] = [];\n    if (imageBase64) {\n      const mimeType = imageBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : imageBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = imageBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      contents.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    contents.push({ text: promptText });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.7-flash\',\n      contents: { parts: contents },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            title: { type: Type.STRING },\n            type: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            description: { type: Type.STRING },\n            targetAudience: { type: Type.ARRAY, items: { type: Type.STRING } },\n            painPoints: { type: Type.ARRAY, items: { type: Type.STRING } },\n            coreValues: { type: Type.ARRAY, items: { type: Type.STRING } },\n            testOrFormAngle: { type: Type.STRING },\n            imageUrl: { type: Type.STRING },\n            tallyUrl: { type: Type.STRING },\n            notes: { type: Type.STRING },\n          },\n          required: [\'title\', \'type\', \'description\', \'targetAudience\', \'painPoints\', \'coreValues\', \'testOrFormAngle\'],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    if (url && !parsed.tallyUrl) {\n      parsed.tallyUrl = url;\n    }\n\n    res.json({\n      success: true,\n      data: parsed,\n    });\n  } catch (error: any) {\n    console.error(\'Error extracting program:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi tr\303\255ch xu\341\272\245t th\303\264ng tin ch\306\260\306\241ng tr\303\254nh.\' });\n  }\n});\n\n// 2. Generate Content for Orders 1-7\napp.post(\'/api/generate-order\', async (req: Request, res: Response) => {\n  try {\n    const {\n      orderType,\n      context,\n      screenshotBase64,\n      selectedProgramId,\n      programs,\n      options = {},\n    } = req.body;\n\n    const ai = getAi();\n\n    // Map order definitions and strict rules\n    const orderRules: Record<string, { platform: string; allowedTypes: string[]; rules: string }> = {\n      order_1: {\n        platform: \'TikTok\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 1: COMMENT QUA CLIP TIKTOK\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i comment th\303\240nh inbox t\341\273\261 nhi\303\252n, kh\303\264ng l\341\273\231 li\341\273\205u b\303\241n h\303\240ng.\n- Tone & Mood: \304\220\341\273\223ng c\341\272\243m s\303\242u s\341\272\257c, \341\272\245m \303\241p, nh\341\272\257m t\341\273\233i t\341\273\207p 20-39 tu\341\273\225i. \304\220\303\241nh tr\303\272ng t\303\242m l\303\275 so s\303\241nh b\341\272\243n th\303\242n, loay hoay \304\221\341\273\213nh h\306\260\341\273\233ng, hay t\341\273\245t mood, s\341\273\243 sai ho\341\272\267c qu\303\241 ch\303\272 tr\341\273\215ng chuy\303\252n m\303\264n m\303\240 qu\303\252n n\304\203ng l\341\273\261c th\341\272\245u hi\341\273\203u con ng\306\260\341\273\235i.\n- C\341\272\245u tr\303\272c:\n  1. C\303\242u hook \304\221\341\273\223ng c\341\272\243m ch\303\242n th\303\240nh v\341\273\233i ho\303\240n c\341\272\243nh trong clip.\n  2. Insight \304\221\341\272\257t gi\303\241 v\341\273\201 vi\341\273\207c hi\341\273\203u b\341\272\243n th\303\242n / r\303\250n luy\341\273\207n s\341\273\251c b\341\273\201n / n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201.\n  3. G\341\273\243i \303\275 nh\341\272\271 nh\303\240ng v\341\273\201 m\341\273\231t b\303\240i test/review nh\341\273\217 \304\221\303\241nh gi\303\241 1-1 mi\341\273\205n ph\303\255 gi\303\272p t\303\254m ra h\306\260\341\273\233ng \304\221i.\n  4. L\341\273\235i m\341\273\235i inbox nh\341\272\255n b\303\240i test free m\341\273\231t c\303\241ch khi\303\252m t\341\273\221n v\303\240 c\341\273\237i m\341\273\237.\n- Tham kh\341\272\243o gi\341\273\215ng \304\221i\341\273\207u chu\341\272\251n: \"M\303\254nh ngh\304\251 ai c\305\251ng n\303\252n cho b\341\272\243n th\303\242n c\306\241 h\341\273\231i \304\221\306\260\341\273\243c th\341\273\255... N\341\272\277u b\341\272\241n \304\221ang mu\341\273\221n hi\341\273\203u b\341\272\243n th\303\242n h\306\241n c\303\263 th\341\273\203 nh\341\272\257n m\303\254nh nh\303\251\" ho\341\272\267c \"G\341\273\255i c\303\241c b\341\272\241n \304\221ang \341\273\237 \304\221\341\273\231 tu\341\273\225i 20-39t... m\303\254nh c\303\263 1 b\303\240i test review nh\341\273\217 c\303\263 gi\341\272\243i \304\221\303\241p chi ti\341\272\277t 1-1...\"`,\n      },\n      order_2: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 2: COMMENT QUA POST FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG R\341\272\242I CH\306\257\306\240NG TR\303\214NH (CT). CH\341\273\210 \304\220\306\257\341\273\242C PH\303\211P \304\220\341\273\200 XU\341\272\244T WORKSHOP (WS).\n- Tone & Mood: Kh\303\241c v\341\273\233i TikTok/Threads, content Facebook KH\303\224NG mang t\303\255nh \304\221\341\273\223ng c\341\272\243m qu\303\241 \341\273\247y m\341\273\213 hay m\341\273\231t chi\341\273\201u. PH\341\272\242I C\303\223 S\341\273\260 KH\303\201CH QUAN, TRUNG L\341\272\254P, MANG T\303\215NH PH\303\202N T\303\215CH CHO C\341\272\242 \304\220\303\224I B\303\212N (v\303\255 d\341\273\245 g\303\263c nh\303\254n nh\303\242n vi\303\252n vs qu\341\272\243n l\303\275, \303\241p l\341\273\261c v\341\272\255n h\303\240nh vs nguy\341\273\207n v\341\273\215ng ph\303\241t tri\341\273\203n).\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG D\303\231NG C\303\202U KH\341\272\262NG \304\220\341\273\212NH \303\201P \304\220\341\272\266T nh\306\260: \"Thay v\303\254 loay hoay... th\303\254 h\303\243y...\" (nghe nh\306\260 ra l\341\273\207nh) ho\341\272\267c \"Vi\341\273\207c b\341\272\241n c\341\272\243m th\341\272\245y v\303\264 d\341\273\245ng th\341\273\261c ch\341\272\245t l\303\240 do b\341\272\241n b\341\273\213...\" (nghe ti\303\252u c\341\273\261c, 1 chi\341\273\201u, ph\341\272\243n c\341\272\243m).\n- H\341\272\240 TH\341\272\244P B\341\272\242N TH\303\202N TR\306\257\341\273\232C NG\306\257\341\273\234I XEM, d\303\271ng c\341\272\245u tr\303\272c m\341\273\201m m\341\273\217ng: \"T\303\254nh tr\341\272\241ng n\303\240y kh\303\264ng ph\341\272\243i m\341\273\231t m\303\254nh b\341\272\241n... B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS n\303\240y \304\221\341\273\203...\"\n- Ph\303\242n t\303\255ch th\341\273\261c t\341\272\277 \304\221\341\273\235i s\341\273\221ng c\303\264ng s\341\273\237 (v\303\255 d\341\273\245: manager b\341\273\213 \304\221\303\250 l\306\260\306\241ng, kh\341\273\221i l\306\260\341\273\243ng vi\341\273\207c t\303\241i c\341\272\245u tr\303\272c, \304\221\303\240o t\341\272\241o newbie...).`,\n      },\n      order_3: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 3: VI\341\272\276T B\303\200I FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I CH\341\273\210 VI\341\272\276T V\341\273\200 WORKSHOP (WS), KH\303\224NG CH\341\272\240Y CH\306\257\306\240NG TR\303\214NH (CT).\n- Tone & Mood: Kh\303\241ch quan, trung l\341\272\255p, ph\303\242n t\303\255ch \304\221a chi\341\273\201u, khi\303\252m t\341\273\221n. C\303\263 \304\221\341\273\231 s\303\242u v\341\273\201 tr\341\272\243i nghi\341\273\207m th\341\273\261c t\341\272\277 c\303\264ng vi\341\273\207c.\n- C\341\272\245u tr\303\272c:\n  1. M\341\273\237 b\303\240i b\341\272\261ng m\341\273\231t hi\341\273\207n t\306\260\341\273\243ng/t\303\254nh hu\341\273\221ng c\303\264ng s\341\273\237 ho\341\272\267c th\341\273\261c t\341\272\277 ph\341\273\225 bi\341\272\277n (kh\303\264ng k\341\272\277t lu\341\272\255n v\341\273\231i v\303\240ng).\n  2. Ph\303\242n t\303\255ch nguy\303\252n nh\303\242n s\303\242u xa t\341\273\253 g\303\263c \304\221\341\273\231 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201 ho\341\272\267c th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n.\n  3. \304\220\341\273\201 xu\341\272\245t khi\303\252m nh\306\260\341\273\235ng: \"B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS [T\303\252n WS] \304\221\341\273\203 c\303\271ng nh\303\254n nh\341\272\255n l\341\272\241i...\"\n  4. N\341\272\277u c\303\263 y\303\252u c\341\272\247u g\341\272\257n link: ch\303\250n v\341\273\213 tr\303\255 link \304\221\304\203ng k\303\275 r\303\265 r\303\240ng \341\273\237 cu\341\273\221i b\303\240i ho\341\272\267c d\306\260\341\273\233i comment.`,\n      },\n      order_4: {\n        platform: \'Threads\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 4: COMMENT THREADS\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i th\303\240nh inbox th\303\264ng qua t\303\242m s\341\273\261 ch\303\242n th\303\240nh.\n- Tone & Mood: Gi\341\273\215ng \304\221i\341\273\207u ch\303\242n th\341\272\255t (authentic), th\341\273\247 th\341\273\211, s\303\242u l\341\272\257ng, ng\341\272\257t d\303\262ng t\341\273\261 nhi\303\252n, nh\306\260 m\341\273\231t ng\306\260\341\273\235i b\341\272\241n c\303\271ng trang l\341\273\251a \304\221ang tr\341\272\243i l\303\262ng.\n- C\341\272\245u tr\303\272c: 3-5 c\303\242u ng\341\272\257n g\341\27