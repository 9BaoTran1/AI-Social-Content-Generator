    instruction: "Update model hierarchy in generateContentWithRetry to use gemini-2.5-flash as primary and fallback to other stable models"
    replacement_infos {
      original_chunk {
        target_content: "// Resilient API Caller with Exponential Backoff Retry & Fallback\nasync function generateContentWithRetry(\n  params: {\n    contents: any;\n    config?: any;\n  },\n  primaryModel: string = \'gemini-3.7-flash\',\n  maxRetriesPerModel: number = 3\n) {\n  const ai = getAi();\n  const modelsToTry = [primaryModel, \'gemini-flash-latest\'];\n  let lastError: any = null;\n\n  for (const modelName of modelsToTry) {\n    for (let attempt = 1; attempt <= maxRetriesPerModel; attempt++) {\n      try {\n        const response = await ai.models.generateContent({\n          model: modelName,\n          contents: params.contents,\n          config: params.config,\n        });\n        return response;\n      } catch (err: any) {\n        lastError = err;\n        const errMsg = err?.message || String(err);\n        const isUnavailableOrRateLimited =\n          errMsg.includes(\'503\') ||\n          errMsg.includes(\'429\') ||\n          errMsg.includes(\'UNAVAILABLE\') ||\n          errMsg.includes(\'high demand\') ||\n          errMsg.includes(\'RESOURCE_EXHAUSTED\') ||\n          errMsg.includes(\'overloaded\');\n\n        console.warn(`[Gemini API] Model \'${modelName}\' attempt ${attempt}/${maxRetriesPerModel} failed: ${errMsg}`);\n\n        if (isUnavailableOrRateLimited && attempt < maxRetriesPerModel) {\n          const delayMs = attempt * 1000 + Math.floor(Math.random() * 500);\n          console.log(`[Gemini API] Retrying in ${delayMs}ms due to high demand/rate limit...`);\n          await new Promise((resolve) => setTimeout(resolve, delayMs));\n        } else if (!isUnavailableOrRateLimited) {\n          // If non-transient error (e.g. invalid arguments), don\'t retry endlessly with this model\n          break;\n        }\n      }\n    }\n  }\n\n  // Handle human-friendly message if all attempts failed\n  const errMsg = lastError?.message || String(lastError);\n  if (\n    errMsg.includes(\'503\') ||\n    errMsg.includes(\'high demand\') ||\n    errMsg.includes(\'UNAVAILABLE\') ||\n    errMsg.includes(\'overloaded\')\n  ) {\n    throw new Error(\n      \'M\303\264 h\303\254nh AI \304\221ang c\303\263 l\306\260\341\273\243ng ng\306\260\341\273\235i d\303\271ng truy c\341\272\255p cao \304\221\341\273\231t bi\341\272\277n t\341\273\253 Google (503 High Demand). H\341\273\207 th\341\273\221ng \304\221\303\243 t\341\273\261 \304\221\341\273\231ng th\341\273\255 l\341\272\241i nhi\341\273\201u l\341\272\247n nh\306\260ng ch\306\260a k\341\273\213p ph\341\272\243n h\341\273\223i. B\341\272\241n vui l\303\262ng b\341\272\245m n\303\272t \"Th\341\273\255 l\341\272\241i\" sau v\303\240i gi\303\242y.\'\n    );\n  }\n  if (errMsg.includes(\'429\') || errMsg.includes(\'RESOURCE_EXHAUSTED\')) {\n    throw new Error(\n      \'H\341\272\241n ng\341\272\241ch x\341\273\255 l\303\275 AI t\341\272\241m th\341\273\235i b\341\272\255n (429 Rate Limit). Vui l\303\262ng \304\221\341\273\243i 3-5 gi\303\242y v\303\240 b\341\272\245m \"Th\341\273\255 l\341\272\241i\".\'\n    );\n  }\n  throw lastError;\n}"
        replacement_content: "// Resilient API Caller with Exponential Backoff Retry & Fallback\nasync function generateContentWithRetry(\n  params: {\n    contents: any;\n    config?: any;\n  },\n  primaryModel: string = \'gemini-2.5-flash\',\n  maxRetriesPerModel: number = 2\n) {\n  const ai = getAi();\n  // Order of models: prioritize ultra-stable high-availability models\n  const modelsToTry = [\n    primaryModel,\n    \'gemini-2.5-flash\',\n    \'gemini-flash-latest\',\n    \'gemini-3.1-flash-lite\',\n    \'gemini-3.7-flash\',\n  ].filter((v, i, a) => a.indexOf(v) === i); // unique\n\n  let lastError: any = null;\n\n  for (const modelName of modelsToTry) {\n    for (let attempt = 1; attempt <= maxRetriesPerModel; attempt++) {\n      try {\n        console.log(`[Gemini API] Calling model: ${modelName} (Attempt ${attempt}/${maxRetriesPerModel})...`);\n        const response = await ai.models.generateContent({\n          model: modelName,\n          contents: params.contents,\n          config: params.config,\n        });\n        console.log(`[Gemini API] Success with model: ${modelName}`);\n        return response;\n      } catch (err: any) {\n        lastError = err;\n        const errMsg = err?.message || String(err);\n        const isUnavailableOrRateLimited =\n          errMsg.includes(\'503\') ||\n          errMsg.includes(\'429\') ||\n          errMsg.includes(\'UNAVAILABLE\') ||\n          errMsg.includes(\'high demand\') ||\n          errMsg.includes(\'RESOURCE_EXHAUSTED\') ||\n          errMsg.includes(\'overloaded\');\n\n        console.warn(`[Gemini API] Model \'${modelName}\' attempt ${attempt} failed: ${errMsg}`);\n\n        if (isUnavailableOrRateLimited) {\n          // If 503/429, immediately try next model if available to avoid user waiting, or retry after brief pause\n          if (attempt < maxRetriesPerModel) {\n            await new Promise((resolve) => setTimeout(resolve, 800));\n          }\n        } else {\n          // Non-transient error, move to next model or fail\n          break;\n        }\n      }\n    }\n  }\n\n  // Handle human-friendly message if all attempts failed\n  const errMsg = lastError?.message || String(lastError);\n  if (\n    errMsg.includes(\'503\') ||\n    errMsg.includes(\'high demand\') ||\n    errMsg.includes(\'UNAVAILABLE\') ||\n    errMsg.includes(\'overloaded\')\n  ) {\n    throw new Error(\n      \'M\303\264 h\303\254nh AI \304\221ang c\303\263 l\306\260\341\273\243ng ng\306\260\341\273\235i d\303\271ng truy c\341\272\255p cao \304\221\341\273\231t bi\341\272\277n (503 High Demand). Vui l\303\262ng b\341\272\245m n\303\272t \"Th\341\273\255 l\341\272\241i ngay\" \304\221\341\273\203 ti\341\272\277p t\341\273\245c.\'\n    );\n  }\n  if (errMsg.includes(\'429\') || errMsg.includes(\'RESOURCE_EXHAUSTED\')) {\n    throw new Error(\n      \'H\341\272\241n ng\341\272\241ch x\341\273\255 l\303\275 AI t\341\272\241m th\341\273\235i b\341\272\255n (429 Rate Limit). Vui l\303\262ng b\341\272\245m \"Th\341\273\255 l\341\272\241i ngay\".\'\n    );\n  }\n  throw lastError;\n}"
      }
      num_matches: 1
    }
  }
