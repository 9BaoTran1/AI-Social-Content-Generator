          text: "    description: \'L\303\240m ch\341\273\247 s\341\273\261 t\341\272\255p trung t\341\273\253 3 tr\341\273\245 c\341\273\231t: S\341\273\251c kh\341\273\217e th\341\273\203 ch\341\272\245t, D\305\251ng kh\303\255 d\303\241m c\341\272\257t b\341\273\217 m\341\273\245c ti\303\252u ph\341\273\245, v\303\240 S\341\273\261 th\341\272\245u hi\341\273\203u s\303\242u s\341\272\257c ch\303\255nh m\303\254nh.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    targetAudience: [\'Ng\306\260\341\273\235i hay b\341\273\213 xao nh\303\243ng, tr\303\254 ho\303\243n\', \'Ng\306\260\341\273\235i qu\303\241 t\341\272\243i c\303\264ng vi\341\273\207c, n\304\203ng l\306\260\341\273\243ng th\341\272\245t th\306\260\341\273\235ng\', \'Ng\306\260\341\273\235i li\303\252n t\341\273\245c \304\221\341\273\225i m\341\273\245c ti\303\252u\'],"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
