    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ProgramItem, OrderType } from \'./types\';\nimport { getSavedPrograms, savePrograms } from \'./lib/storage\';\nimport { Navbar } from \'./components/Navbar\';\nimport { OrderGrid } from \'./components/OrderGrid\';\nimport { GeneratorWorkbench } from \'./components/GeneratorWorkbench\';\nimport { ProgramManager } from \'./components/ProgramManager\';\nimport { AIChatDrawer } from \'./components/AIChatDrawer\';\nimport { BenchmarkLibrary } from \'./components/BenchmarkLibrary\';\nimport { HistoryModal } from \'./components/HistoryModal\';\n\nexport default function App() {\n  const [programs, setPrograms] = useState<ProgramItem[]>(getSavedPrograms());\n  const [activeTab, setActiveTab] = useState<\n    \'orders\' | \'workbench\' | \'programs\' | \'chat\' | \'templates\' | \'history\'\n  >(\'orders\');\n  const [selectedOrderType, setSelectedOrderType] = useState<OrderType>(\'order_1\');\n  const [isAddModalOpen, setIsAddModalOpen] = useState<boolean>(false);\n  const [externalTriggerHi, setExternalTriggerHi] = useState<number>(0);\n\n  // Program Handlers\n  const handleAddProgram = (newProg: ProgramItem) => {\n    const updated = [newProg, ...programs];\n    setPrograms(updated);\n    savePrograms(updated);\n  };\n\n  const handleUpdateProgram = (updatedProg: ProgramItem) => {\n    const updated = programs.map((p) => (p.id === updatedProg.id ? updatedProg : p));\n    setPrograms(updated);\n    savePrograms(updated);\n  };\n\n  const handleDeleteProgram = (id: string) => {\n    if (confirm(\'B\341\272\241n c\303\263 ch\341\272\257c ch\341\272\257n mu\341\273\221n x\303\263a Workshop/Ch\306\260\306\241ng tr\303\254nh n\303\240y kh\341\273\217i kho?\')) {\n      const updated = programs.filter((p) => p.id !== id);\n      setPrograms(updated);\n      savePrograms(updated);\n    }\n  };\n\n  // Order Selection from Grid\n  const handleSelectOrder = (orderType: OrderType) => {\n    setSelectedOrderType(orderType);\n    setActiveTab(\'workbench\');\n  };\n\n  // Quick Trigger \"Hi\"\n  const handleQuickHiTrigger = () => {\n    setActiveTab(\'chat\');\n    setExternalTriggerHi((prev) => prev + 1);\n  };\n\n  const wsCount = programs.filter((p) => p.type === \'ws\').length;\n  const ctCount = programs.filter((p) => p.type === \'ct\').length;\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-indigo-500 selection:text-white\">\n      {/* Top Navbar */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        onOpenAddProgram={() => {\n          setActiveTab(\'programs\');\n          setIsAddModalOpen(true);\n        }}\n        onQuickHiTrigger={handleQuickHiTrigger}\n        programCount={{ ws: wsCount, ct: ctCount }}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'orders\' && <OrderGrid onSelectOrder={handleSelectOrder} />}\n\n        {activeTab === \'workbench\' && (\n          <GeneratorWorkbench\n            programs={programs}\n            initialOrderType={selectedOrderType}\n            onNavigateToPrograms={() => setActiveTab(\'programs\')}\n          />\n        )}\n\n        {activeTab === \'programs\' && (\n          <ProgramManager\n            programs={programs}\n            onAddProgram={handleAddProgram}\n            onUpdateProgram={handleUpdateProgram}\n            onDeleteProgram={handleDeleteProgram}\n            isAddModalOpen={isAddModalOpen}\n            setIsAddModalOpen={setIsAddModalOpen}\n          />\n        )}\n\n        {activeTab === \'chat\' && (\n          <AIChatDrawer\n            programs={programs}\n            onSelectOrderForWorkbench={(orderType) => {\n              setSelectedOrderType(orderType);\n              setActiveTab(\'workbench\');\n            }}\n            externalTriggerHi={externalTriggerHi}\n          />\n        )}\n\n        {activeTab === \'templates\' && (\n          <BenchmarkLibrary\n            onUseTemplate={(content) => {\n              setActiveTab(\'workbench\');\n            }}\n          />\n        )}\n\n        {activeTab === \'history\' && (\n          <HistoryModal\n            onUseContent={(content) => {\n              setActiveTab(\'workbench\');\n            }}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-slate-900 bg-slate-950 py-4 text-center text-xs text-slate-500\">\n        <p>\n          AI Social Content Specialist \342\200\242 Chuy\341\273\203n \304\221\341\273\225i Comment th\303\240nh Inbox \342\200\242 Tu\303\242n th\341\273\247 chu\341\272\251n TikTok, Facebook, Threads, LinkedIn\n        </p>\n      </footer>\n    </div>\n  );\n}\n"
    }
