  file_change {
    absolute_path_uri: "file:///src/components/HistoryModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { GeneratedContent } from \'../types\';\nimport { getSavedHistory } from \'../lib/storage\';\nimport {\n  Clock,\n  Trash2,\n  Copy,\n  Check,\n  FileText,\n  UserCheck,\n  ExternalLink,\n  ChevronDown\n} from \'lucide-react\';\n\ninterface HistoryModalProps {\n  onUseContent: (content: string) => void;\n}\n\nexport const HistoryModal: React.FC<HistoryModalProps> = ({ onUseContent }) => {\n  const [historyItems, setHistoryItems] = useState<GeneratedContent[]>(getSavedHistory());\n  const [copiedId, setCopiedId] = useState<string | null>(null);\n\n  const clearHistory = () => {\n    if (confirm(\'B\341\272\241n c\303\263 ch\341\272\257c mu\341\273\221n x\303\263a to\303\240n b\341\273\231 l\341\273\213ch s\341\273\255 t\341\272\241o content kh\303\264ng?\')) {\n      localStorage.removeItem(\'order_ai_history_v1\');\n      setHistoryItems([]);\n    }\n  };\n\n  const copyText = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedId(id);\n    setTimeout(() => setCopiedId(null), 2000);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900/90 border border-slate-800 p-5 rounded-2xl\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"px-2.5 py-0.5 text-xs font-bold uppercase rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n              L\341\273\213ch S\341\273\255 S\341\272\243n Xu\341\272\245t\n            </span>\n            <h2 className=\"text-lg font-bold text-white\">\n              L\341\273\213ch S\341\273\255 T\341\272\241o Content & K\341\273\213ch B\341\272\243n DM ({historyItems.length})\n            </h2>\n          </div>\n          <p className=\"text-slate-400 text-xs mt-1\">\n            Xem l\341\272\241i c\303\241c b\303\240i vi\341\272\277t, comment v\303\240 k\341\273\213ch b\341\272\243n 1-1 \304\221\303\243 t\341\272\241o tr\306\260\341\273\233c \304\221\303\263 tr\303\252n c\303\241c n\341\273\201n t\341\272\243ng.\n          </p>\n        </div>\n\n        {historyItems.length > 0 && (\n          <button\n            onClick={clearHistory}\n            className=\"px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-400 hover:text-rose-300 hover:bg-rose-950/40 border border-rose-800/40 flex items-center gap-1.5\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>X\303\263a l\341\273\213ch s\341\273\255</span>\n          </button>\n        )}\n      </div>\n\n      {historyItems.length === 0 ? (\n        <div className=\"min-h-[300px] rounded-2xl border border-dashed border-slate-800 bg-slate-900/30 p-8 flex flex-col items-center justify-center text-center space-y-3\">\n          <Clock className=\"w-10 h-10 text-slate-600\" />\n          <h3 className=\"text-sm font-bold text-slate-300\">Ch\306\260a c\303\263 l\341\273\213ch s\341\273\255 t\341\272\241o content</h3>\n          <p className=\"text-xs text-slate-500 max-w-sm\">\n            C\303\241c n\341\273\231i dung b\341\272\241n t\341\272\241o \341\273\237 Studio ho\341\272\267c Chat AI s\341\272\275 t\341\273\261 \304\221\341\273\231ng \304\221\306\260\341\273\243c l\306\260u l\341\272\241i t\341\272\241i \304\221\303\242y \304\221\341\273\203 t\303\241i s\341\273\255 d\341\273\245ng nhanh ch\303\263ng.\n          </p>\n        </div>\n      ) : (\n        <div className=\"space-y-4\">\n          {historyItems.map((item) => (\n            <div\n              key={item.id}\n              className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-3\"\n            >\n              <div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"px-2.5 py-0.5 rounded-md text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                    {item.orderTitle}\n                  </span>\n                  <span className=\"px-2.5 py-0.5 rounded-md text-xs font-bold bg-slate-800 text-slate-300\">\n                    {item.platform}\n                  </span>\n                  <span className=\"text-xs font-semibold text-emerald-400\">\n                    WS/CT: {item.programTitle}\n                  </span>\n                </div>\n                <span className=\"text-[11px] text-slate-500\">\n                  {new Date(item.createdAt).toLocaleString(\'vi-VN\')}\n                </span>\n              </div>\n\n              {/* Variations */}\n              <div className=\"space-y-2\">\n                {item.variations.map((v, i) => (\n                  <div\n                    key={i}\n                    className=\"p-3 rounded-xl bg-slate-950 border border-slate-800/80 space-y-1.5\"\n                  >\n                    <div className=\"flex justify-between items-center text-[10px] text-slate-400 font-bold\">\n                      <span>M\341\272\253u {i + 1}</span>\n                      <button\n                        onClick={() => copyText(v, `hist-${item.id}-${i}`)}\n                        className=\"text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n                      >\n                        {copiedId === `hist-${item.id}-${i}` ? (\n                          <>\n                            <Check className=\"w-3 h-3 text-emerald-400\" />\n                            <span className=\"text-emerald-400\">\304\220\303\243 copy</span>\n                          </>\n                        ) : (\n                          <>\n                            <Copy className=\"w-3 h-3\" />\n                            <span>Copy</span>\n                          </>\n                        )}\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-200 leading-relaxed font-sans\">{v}</p>\n                  </div>\n                ))}\n              </div>\n\n              {/* DM Script */}\n              {item.dmFollowUpScript && (\n                <div className=\"p-3 rounded-xl bg-indigo-950/30 border border-indigo-900/40 text-xs space-y-1\">\n                  <span className=\"font-bold text-emerald-300 block text-[11px]\">\n                    K\341\273\213ch b\341\272\243n Chat 1-1:\n                  </span>\n                  <p className=\"text-slate-300 italic\">\n                    1. {item.dmFollowUpScript.step1_empathy}\n                  </p>\n                  <p className=\"text-slate-300 italic\">\n                    2. {item.dmFollowUpScript.step2_qualifyQuestion}\n                  </p>\n                  <p className=\"text-slate-300 italic\">\n                    3. {item.dmFollowUpScript.step3_inviteLink}\n                  </p>\n                </div>\n              )}\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
    }
