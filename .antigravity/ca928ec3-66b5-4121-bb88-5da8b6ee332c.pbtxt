  file_change {
    absolute_path_uri: "file:///src/data/defaultPrograms.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { ProgramItem, OrderMeta, SampleTemplate } from \'../types\';\n\nexport const DEFAULT_PROGRAMS: ProgramItem[] = [\n  {\n    id: \'prog-1\',\n    title: \'YEAR-IN-REVIEW 2025 \303\227 SELF-POSITIONING TEST 2026\',\n    type: \'ct\',\n    description: \'D\303\240nh cho ng\306\260\341\273\235i \304\221i l\303\240m \342\200\223 nh\341\273\257ng ng\306\260\341\273\235i \304\221\303\243 n\341\273\227 l\341\273\261c c\341\272\243 n\304\203m v\303\240 c\341\272\247n m\341\273\231t \304\221i\341\273\203m d\341\273\253ng \304\221\341\273\203 nh\303\254n r\303\265 m\303\254nh h\306\241n, \304\221\303\241nh gi\303\241 c\306\241 h\341\273\231i - th\303\241ch th\341\273\251c, ghi nh\341\272\255n th\303\240nh t\341\273\261u v\303\240 t\303\241i \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n.\',\n    targetAudience: [\'Ng\306\260\341\273\235i \304\221i l\303\240m 22-38 tu\341\273\225i\', \'Nh\303\242n s\341\273\261 tr\341\272\243i qua 1 n\304\203m b\341\272\255n r\341\273\231n\', \'Ng\306\260\341\273\235i c\341\272\247n nh\303\254n l\341\272\241i v\303\240 t\303\241i \304\221\341\273\213nh h\306\260\341\273\233ng n\304\203m m\341\273\233i\'],\n    painPoints: [\n      \'Cu\341\273\221n theo c\303\264ng vi\341\273\207c 365 ng\303\240y kh\303\264ng c\303\263 th\341\273\235i gian d\341\273\253ng l\341\272\241i nh\303\254n nh\341\272\255n s\341\273\261 tr\306\260\341\273\237ng th\303\240nh\',\n      \'M\306\241 h\341\273\223 v\341\273\201 \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n sau 12 th\303\241ng bi\341\272\277n \304\221\341\273\231ng\',\n      \'Ch\306\260a r\303\265 n\304\203m m\341\273\233i n\303\252n \306\260u ti\303\252n \304\221i\341\273\201u g\303\254 v\303\240 b\341\273\251t ph\303\241 ra sao\'\n    ],\n    coreValues: [\n      \'Nh\303\254n l\341\272\241i & \304\221\303\241nh gi\303\241 c\306\241 h\341\273\231i - th\303\241ch th\341\273\251c sau 1 n\304\203m\',\n      \'Ghi nh\341\272\255n nh\341\273\257ng \304\221i\341\273\201u \304\221\303\243 l\303\240m \304\221\306\260\341\273\243c d\303\271 nh\341\273\217 hay l\341\273\233n\',\n      \'R\303\272t ra b\303\240i h\341\273\215c qu\303\275 gi\303\241 v\303\240 th\341\273\261c h\303\240nh l\303\262ng bi\341\272\277t \306\241n\',\n      \'\304\220\341\273\213nh v\341\273\213 l\341\272\241i ch\303\255nh m\303\254nh v\303\240 chu\341\272\251n b\341\273\213 b\341\273\251t ph\303\241 n\304\203m m\341\273\233i\'\n    ],\n    testOrFormAngle: \'Self-Positioning Test & Year Review Matrix - Test \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n & b\303\240i t\341\272\255p soi chi\341\272\277u c\303\241 nh\303\242n h\303\263a 1-1\',\n    isActive: true,\n    isBuiltin: true,\n    createdAt: \'2026-01-01\'\n  },\n  {\n    id: \'prog-2\',\n    title: \'Special 2026 \342\200\223 The Art of Conversation\',\n    type: \'ct\',\n    description: \'Ngh\341\273\207 thu\341\272\255t giao ti\341\272\277p v\303\240 th\341\272\245u hi\341\273\203u ch\303\255nh m\303\254nh trong c\303\241c m\341\273\221i quan h\341\273\207 \304\221a t\341\272\247ng (s\341\272\277p, \304\221\341\273\223ng nghi\341\273\207p, v\341\273\243 ch\341\273\223ng, con c\303\241i) th\303\264ng qua t\306\260 duy giao ti\341\272\277p nh\341\272\241y b\303\251n v\303\240 l\341\272\257ng nghe s\303\242u s\341\272\257c.\',\n    targetAudience: [\'Ng\306\260\341\273\235i \304\221i l\303\240m g\341\272\267p kh\303\272c m\341\272\257c giao ti\341\272\277p\', \'C\341\272\267p \304\221\303\264i/v\341\273\243 ch\341\273\223ng/cha m\341\272\271\', \'Ng\306\260\341\273\235i mu\341\273\221n h\303\262a h\341\273\243p c\303\241c m\341\273\221i quan h\341\273\207 m\303\240 kh\303\264ng \304\221\303\241nh m\341\272\245t s\341\273\261 b\303\254nh an\'],\n    painPoints: [\n      \'Ch\306\260a hi\341\273\203u r\303\265 phong c\303\241ch v\303\240 t\306\260 duy giao ti\341\272\277p c\341\273\221t l\303\265i c\341\273\247a ch\303\255nh m\303\254nh\',\n      \'D\341\273\205 r\306\241i v\303\240o xung \304\221\341\273\231t, hi\341\273\203u l\341\272\247m ho\341\272\267c ph\303\262ng th\341\273\247 khi giao ti\341\272\277p v\341\273\233i s\341\272\277p/\304\221\341\273\223ng nghi\341\273\207p/gia \304\221\303\254nh\',\n      \'G\341\272\267p kh\303\263 kh\304\203n trong vi\341\273\207c v\341\273\253a \304\221\341\272\241t m\341\273\245c \304\221\303\255ch h\341\273\231i tho\341\272\241i v\341\273\253a gi\341\273\257 s\341\273\261 ch\303\242n th\303\240nh\'\n    ],\n    coreValues: [\n      \'G\341\273\215i t\303\252n phong c\303\241ch v\303\240 t\306\260 duy giao ti\341\272\277p c\341\273\247a b\341\272\243n th\303\242n\',\n      \'H\303\262a h\341\273\243p m\341\273\215i m\341\273\221i quan h\341\273\207: chuy\341\273\203n h\303\263a xung \304\221\341\273\231t th\303\240nh s\341\273\261 th\341\272\245u hi\341\273\203u\',\n      \'Giao ti\341\272\277p th\303\240nh c\303\264ng b\341\273\201n v\341\273\257ng, gi\341\273\257 b\303\254nh an n\341\273\231i t\303\242m\',\n      \'T\303\255ch h\341\273\243p b\303\240i t\341\272\255p th\341\273\261c h\303\240nh h\303\240ng ng\303\240y v\303\240 theo d\303\265i ti\341\272\277n tr\303\254nh c\303\241 nh\303\242n\'\n    ],\n    testOrFormAngle: \'B\341\273\231 \304\221\303\241nh gi\303\241 phong c\303\241ch giao ti\341\272\277p & gi\341\272\243i m\303\243 \304\221i\341\273\203m ngh\341\272\275n t\306\260\306\241ng t\303\241c 1:1\',\n    imageUrl: \'https://storage.tally.so/30581dc9-c72d-4fb7-9469-676e57bb30ed/photo_6197064284425096831_y.jpg\',\n    isActive: true,\n    isBuiltin: true,\n    createdAt: \'2026-01-05\'\n  },\n  {\n    id: \'prog-3\',\n    title: \'SPOT ON - B\341\272\240N M\341\272\240NH \341\273\236 \304\220\303\202U?\',\n    type: \'ws\',\n    description: \'Workshop kh\303\241m ph\303\241 v\303\240 \304\221\341\273\213nh v\341\273\213 \304\221\303\272ng \304\221i\341\273\203m m\341\272\241nh th\341\273\261c s\341\273\261 c\341\273\247a b\341\272\243n th\303\242n, th\303\241o g\341\273\241 t\303\242m l\303\275 \"ai c\305\251ng l\303\240m \304\221\306\260\341\273\243c v\341\272\255y th\303\264i\" v\303\240 x\303\242y d\341\273\261ng s\341\273\261 t\341\273\261 tin t\341\273\253 g\341\273\221c r\341\273\205 n\341\273\231i t\341\272\241i.\',\n    targetAudience: [\'Ng\306\260\341\273\235i ch\304\203m ch\341\273\211 n\341\273\227 l\341\273\261c nh\306\260ng ch\306\260a d\303\241m kh\341\272\263ng \304\221\341\273\213nh th\341\272\277 m\341\272\241nh\', \'Ng\306\260\341\273\235i t\341\273\261 ti so s\303\241nh\', \'\304\220\341\273\231 tu\341\273\225i 20-35 tu\341\273\225i\'],\n    painPoints: [\n      \'L\303\240m \304\221\306\260\341\273\243c nhi\341\273\201u vi\341\273\207c nh\306\260ng coi l\303\240 \304\221i\341\273\201u b\303\254nh th\306\260\341\273\235ng (\"Ai c\305\251ng l\303\240m \304\221\306\260\341\273\243c v\341\272\255y th\303\264i\")\',\n      \'Kh\303\264ng bi\341\272\277t m\303\254nh th\341\272\255t s\341\273\261 gi\341\273\217i \341\273\237 \304\221\303\242u, \304\221\341\273\251ng \304\221\303\272ng v\341\273\213 tr\303\255 ch\306\260a hay do ho\303\240n c\341\272\243nh \304\221\341\272\251y \304\221\306\260a\',\n      \'M\341\272\245t \304\221\341\273\213nh v\341\273\213 v\341\273\201 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, c\341\272\243m th\341\272\245y t\341\273\261 ti ho\341\272\267c m\303\264ng lung\'\n    ],\n    coreValues: [\n      \'Soi g\306\260\306\241ng ch\303\255nh m\303\254nh: nh\303\254n nh\341\272\255n r\303\265 r\303\240ng, t\303\254m \304\221\303\272ng \304\221i\341\273\203m m\341\272\241nh \304\221\341\273\203 t\341\272\255p trung ph\303\241t tri\341\273\203n\',\n      \'M\341\273\237 r\341\273\231ng g\303\263c nh\303\254n: g\341\273\241 b\341\273\217 l\341\273\221i nh\303\254n ti\303\252u c\341\273\261c v\341\273\201 b\341\272\243n th\303\242n, kh\303\241m ph\303\241 t\303\240i n\304\203ng \341\272\251n gi\341\272\245u\',\n      \'X\303\242y n\341\273\201n v\341\273\257ng ch\341\272\257c: \304\221\341\273\213nh h\306\260\341\273\233ng m\303\264i tr\306\260\341\273\235ng v\303\240 con \304\221\306\260\341\273\235ng ph\303\271 h\341\273\243p v\341\273\233i gi\303\241 tr\341\273\213 th\341\272\255t\',\n      \'T\341\273\261 tin t\341\273\261 nhi\303\252n khi kh\303\264ng c\341\272\247n ph\341\272\243i c\341\273\221 tr\341\273\237 th\303\240nh m\341\273\231t ai kh\303\241c\'\n    ],\n    testOrFormAngle: \'Template \304\221\303\241nh gi\303\241 m\341\273\251c \304\221\341\273\231 th\341\272\245u hi\341\273\203u t\303\255nh c\303\241ch, con ng\306\260\341\273\235i th\341\272\255t & l\341\273\231 tr\303\254nh ph\303\241t tri\341\273\203n \304\221i\341\273\203m m\341\272\241nh 1-1\',\n    isActive: true,\n    isBuiltin: true,\n    createdAt: \'2026-01-10\'\n  },\n  {\n    id: \'prog-4\',\n    title: \'NEW CHAPTER \342\200\223 B\306\257\341\273\232C NGO\341\272\266T S\341\273\260 NGHI\341\273\206P\',\n    type: \'ws\',\n    description: \'Talkshow/Workshop d\303\240nh cho nh\341\273\257ng ng\306\260\341\273\235i mong mu\341\273\221n nh\303\254n l\341\272\241i h\303\240nh tr\303\254nh ngh\341\273\201 nghi\341\273\207p, kh\303\241m ph\303\241 th\341\272\277 m\341\272\241nh, hi\341\273\203u g\303\263c nh\303\254n nh\303\240 tuy\341\273\203n d\341\273\245ng \304\221\341\273\203 ra quy\341\272\277t \304\221\341\273\213nh chuy\341\273\203n h\306\260\341\273\233ng ph\303\271 h\341\273\243p.\',\n    targetAudience: [\'Ng\306\260\341\273\235i \304\221i l\303\240m \304\221ang b\304\203n kho\304\203n g\341\272\257n b\303\263 hay chuy\341\273\203n h\306\260\341\273\233ng\', \'Ng\306\260\341\273\235i mu\341\273\221n t\303\254m m\303\264i tr\306\260\341\273\235ng ph\303\271 h\341\273\243p v\341\273\233i gi\303\241 tr\341\273\213 c\303\241 nh\303\242n\', \'Senior/Junior 23-35 tu\341\273\225i\'],\n    painPoints: [\n      \'\304\220i l\303\240m m\341\273\227i ng\303\240y nh\306\260ng t\341\273\261 h\341\273\217i c\303\263 ph\303\271 h\341\273\243p v\341\273\233i c\303\264ng vi\