  <div className=\"flex flex-wrap gap-1.5 mt-3 pt-2 border-t border-slate-800/80\">\n                        {msg.suggestedActions.map((action, idx) => (\n                          <button\n                            key={idx}\n                            onClick={() => handleSendMessage(action.action)}\n                            className=\"px-2.5 py-1 rounded-lg text-[11px] font-medium bg-slate-900 hover:bg-slate-800 text-indigo-300 hover:text-white border border-slate-700/80 transition-colors\"\n                          >\n                            {action.label}\n                          </button>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n            <div ref={messagesEndRef} />\n          </div>\n\n          {/* Chat Input Bar */}\n          <div className=\"p-3 bg-slate-950 border-t border-slate-800\">\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                handleSendMessage();\n              }}\n              className=\"flex items-center gap-2\"\n            >\n              <input\n                type=\"text\"\n                value={inputMessage}\n                onChange={(e) => setInputMessage(e.target.value)}\n                placeholder=\"Nh\341\272\255p c\303\242u h\341\273\217i ho\341\272\267c g\303\265 \'Hi\' \304\221\341\273\203 m\341\273\237 Menu 7 Order...\"\n                className=\"flex-1 bg-slate-900 border border-slate-800 rounded-xl px-4 py-2.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n              />\n              <button\n                type=\"submit\"\n                disabled={isChatLoading || !inputMessage.trim()}\n                className=\"p-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-40 transition-colors cursor-pointer\"\n              >\n                <Send className=\"w-4 h-4\" />\n              </button>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* SUBTAB 2: HISTORY */}\n      {subTab === \'history\' && (\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-xs text-slate-400\">\n              T\341\273\225ng s\341\273\221 n\341\273\231i dung \304\221\303\243 t\341\272\241o: <strong className=\"text-white\">{historyItems.length}</strong>\n            </span>\n            {historyItems.length > 0 && (\n              <button\n                onClick={clearHistory}\n                className=\"px-3 py-1 rounded-lg text-xs font-semibold text-rose-400 hover:bg-rose-950/40 border border-rose-800/40 flex items-center gap-1\"\n              >\n                <Trash2 className=\"w-3 h-3\" />\n                <span>X\303\263a l\341\273\213ch s\341\273\255</span>\n              </button>\n            )}\n          </div>\n\n          {historyItems.length === 0 ? (\n            <div className=\"min-h-[250px] rounded-2xl border border-slate-800 bg-slate-900/40 p-8 flex flex-col items-center justify-center text-center space-y-2\">\n              <Clock className=\"w-8 h-8 text-slate-600\" />\n              <h3 className=\"text-xs font-bold text-slate-300\">Ch\306\260a c\303\263 l\341\273\213ch s\341\273\255 t\341\272\241o content</h3>\n              <p className=\"text-[11px] text-slate-500 max-w-sm\">\n                Khi b\341\272\241n t\341\272\241o content t\341\272\241i Studio ho\341\272\267c Chat AI, k\341\272\277t qu\341\272\243 s\341\272\275 t\341\273\261 \304\221\341\273\231ng \304\221\306\260\341\273\243c l\306\260u l\341\272\241i t\341\272\241i \304\221\303\242y.\n              </p>\n            </div>\n          ) : (\n            <div className=\"space-y-3\">\n              {historyItems.map((item) => (\n                <div\n                  key={item.id}\n                  className=\"bg-slate-900/90 border border-slate-800/90 rounded-2xl p-4 space-y-3 shadow-sm\"\n                >\n                  <div className=\"flex items-center justify-between border-b border-slate-800/80 pb-2\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs font-bold text-white\">{item.orderTitle}</span>\n                      <span className=\"text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-medium\">\n                        {item.platform}\n                      </span>\n                      <span className=\"text-xs text-indigo-400\">D\341\273\261 \303\241n: {item.programTitle}</span>\n                    </div>\n                    <span className=\"text-[10px] text-slate-500\">\n                      {new Date(item.createdAt).toLocaleString(\'vi-VN\')}\n                    </span>\n                  </div>\n\n                  <div className=\"space-y-2\">\n                    {item.variations.map((v, idx) => (\n                      <div\n                        key={idx}\n                        className=\"bg-slate-950 border border-slate-800 rounded-xl p-3 space-y-1 text-xs\"\n                      >\n                        <div className=\"flex justify-between items-center text-[10px] font-bold text-slate-400\">\n                          <span>M\341\272\253u {idx + 1}</span>\n                          <button\n                            onClick={() => copyText(v, `hist-${item.id}-${idx}`)}\n                            className=\"text-indigo-400 hover:text-indigo-300\"\n                          >\n                            {copiedId === `hist-${item.id}-${idx}` ? \'\342\234\223 \304\220\303\243 ch\303\251p\' : \'Sao ch\303\251p\'}\n                          </button>\n                        </div>\n                        <p className=\"text-slate-200 leading-relaxed whitespace-pre-line\">{v}</p>\n                      </div>\n                    ))}\n                  </div>\n       