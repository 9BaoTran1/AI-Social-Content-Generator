l\303\240 ng\306\260\341\273\235i mu\341\273\221n HI\341\273\202U M\303\214NH, T\303\214M \304\220I\341\273\202M M\341\272\240NH TH\341\273\260C S\341\273\260, R\303\210N S\341\273\250C B\341\273\200N V\303\200 PH\303\201T TRI\341\273\202N N\341\273\230I T\341\273\260.\n2. KH\303\224NG m\341\273\235i ng\306\260\341\273\235i \304\221\341\273\215c l\303\240m kh\303\241ch m\341\273\235i/di\341\273\205n gi\341\272\243 hay \304\221\303\263ng g\303\263p g\303\263c nh\303\254n \304\221\341\273\203 d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n3. KH\303\224NG \303\241p \304\221\341\272\267t khu\303\264n m\341\272\253u cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech...). Template ch\303\255nh l\303\240 form/test c\341\273\247a d\341\273\261 \303\241n.\n4. TUY\341\273\206T \304\220\341\273\220I CH\341\272\244P H\303\200NH NGUY\303\212N T\341\272\256C RI\303\212NG C\341\273\246A T\341\273\252NG N\341\273\200N T\341\272\242NG THEO ORDER:\n${currentOrder.rules}\n\nDANH S\303\201CH WORKSHOP/CH\306\257\306\240NG TR\303\214NH KH\341\272\242 D\341\273\244NG:\n${JSON.stringify(availablePrograms, null, 2)}\n\nH\303\243y ph\303\242n t\303\255ch ng\341\273\257 c\341\272\243nh ng\306\260\341\273\235i d\303\271ng \304\221\306\260a v\303\240o (n\341\273\231i dung clip, post, ho\341\272\267c screenshot), ch\341\273\215n Workshop/Ch\306\260\306\241ng tr\303\254nh ph\303\271 h\341\273\243p nh\341\272\245t (n\341\272\277u ng\306\260\341\273\235i d\303\271ng ch\306\260a ch\341\273\211 \304\221\341\273\213nh), v\303\240 t\341\272\241o ra s\341\272\243n ph\341\272\251m ho\303\240n ch\341\273\211nh theo c\341\272\245u tr\303\272c JSON.`;\n\n    const userPrompt = `Y\303\212U C\341\272\246U TH\341\273\260C HI\341\273\206N:\n- Lo\341\272\241i Order: ${orderType} (${currentOrder.platform})\n- Ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng / Clip / Tr\304\203n tr\341\273\237:\n\"${context || \'Ng\306\260\341\273\235i tr\341\272\273 loay hoay v\341\273\201 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, t\341\273\261 ti so s\303\241nh v\303\240 ch\306\260a d\303\241m kh\341\272\263ng \304\221\341\273\213nh th\341\272\277 m\341\272\241nh\'}\"\n${selectedProgramId ? `- Workshop/Ch\306\260\306\241ng tr\303\254nh \304\221\306\260\341\273\243c ch\341\273\211 \304\221\341\273\213nh ID: ${selectedProgramId}` : \'- H\303\243y t\341\273\261 \304\221\341\273\231ng ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t t\341\273\253 danh s\303\241ch.\'}\n- T\303\271y ch\341\273\215n:\n  * G\341\272\257n link \304\221\304\203ng k\303\275: ${options.includeLink ? \'C\303\263 g\341\272\257n link\' : \'Kh\303\264ng g\341\272\257n link tr\341\273\261c ti\341\272\277p (k\303\252u g\341\273\215i inbox)\'}\n  * Gi\341\273\233i thi\341\273\207u ch\306\260\306\241ng tr\303\254nh/WS: ${options.introduceProgram !== false ? \'C\303\263\' : \'Ch\341\273\211 nh\341\272\257c nh\341\272\271\'}\n  * T\303\271y ch\341\273\211nh tone: ${options.tone || \'T\341\273\261 \304\221\341\273\231ng theo chu\341\272\251n n\341\273\201n t\341\272\243ng\'}\n  * \304\220\341\273\221i t\306\260\341\273\243ng nh\341\272\257m t\341\273\233i: ${options.customAudience || \'Theo chu\341\272\251n d\341\273\261 \303\241n\'}\n\nH\303\243y xu\341\272\245t k\341\272\277t qu\341\272\243 JSON:\n{\n  \"selectedProgramId\": \"id c\341\273\247a WS/CT \304\221\306\260\341\273\243c ch\341\273\215n\",\n  \"selectedProgramTitle\": \"T\303\252n WS/CT\",\n  \"selectedProgramType\": \"ws\" | \"ct\",\n  \"rationale\": \"L\303\275 do v\303\254 sao ch\341\273\215n WS/CT n\303\240y v\303\240 ph\303\242n t\303\255ch insight kh\303\241ch h\303\240ng t\341\273\253 context\",\n  \"platformNotes\": \"L\306\260u \303\275 \304\221\341\272\267c bi\341\273\207t v\341\273\201 tone & mood theo quy t\341\272\257c c\341\273\247a n\341\273\201n t\341\272\243ng\",\n  \"primaryContent\": \"N\341\273\231i dung ch\303\255nh ho\303\240n ch\341\273\211nh nh\341\272\245t\",\n  \"variations\": [\n    \"Variation 1: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 1 (t\341\272\255p trung v\303\240o c\341\272\243m x\303\272c / c\303\242u chuy\341\273\207n c\303\241 nh\303\242n)\",\n    \"Variation 2: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 2 (t\341\272\255p trung v\303\240o ph\303\242n t\303\255ch kh\303\241ch quan / g\303\263c nh\303\254n ng\306\260\341\273\235i \304\221i l\303\240m)\",\n    \"Variation 3: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 3 (t\341\272\255p trung v\303\240o b\303\240i test \304\221\303\241nh gi\303\241 1-1 / khoa h\341\273\215c t\303\255nh c\303\241ch)\"\n  ],\n  \"dmFollowUpScript\": {\n    \"step1_empathy\": \"L\341\273\235i m\341\273\237 \304\221\341\272\247u trong DM khi c\303\263 ng\306\260\341\273\235i b\303\254nh lu\341\272\255n/inbox h\341\273\217i: \304\220\341\273\223ng c\341\272\243m, ghi nh\341\272\255n c\341\272\243m x\303\272c v\303\240 t\341\272\241o kh\303\264ng gian an to\303\240n\",\n    \"step2_qualifyQuestion\": \"C\303\242u h\341\273\217i \304\221\303\240o s\303\242u 1-1: 1-2 c\303\242u h\341\273\217i kh\303\251o l\303\251o \304\221\341\273\203 hi\341\273\203u r\303\265 t\303\254nh tr\341\272\241ng hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n \341\272\245y (v\303\255 d\341\273\245: \'Hi\341\273\207n t\341\272\241i b\341\272\241n \304\221ang c\341\272\243m th\341\272\245y ph\303\242n v\303\242n \341\273\237 \304\221i\341\273\203m n\303\240o nh\341\272\245t...\')\",\n    \"step3_inviteLink\": \"L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / link tham v\341\272\245n 1-1: Nh\341\272\271 nh\303\240ng, mi\341\273\205n ph\303\255 v\303\240 cam k\341\272\277t \304\221\341\273\223ng h\303\240nh\"\n  }\n}`;\n\n    const parts: any[] = [];\n    if (screenshotBase64) {\n      const mimeType = screenshotBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : screenshotBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = screenshotBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      parts.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    parts.push({ text: userPrompt });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.7-flash\',\n      contents: { parts },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            selectedProgramId: { type: Type.STRING },\n            selectedProgramTitle: { type: Type.STRING },\n            selectedProgramType: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            rationale: { type: Type.STRING },\n            platformNotes: { type: Type.STRING },\n            primaryContent: { type: Type.STRING },\n            variations: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n            },\n            dmFollowUpScript: {\n              type: Type.OBJECT,\n              properties: {\n                step1_empathy: { type: Type.STRING },\n                step2_qualifyQuestion: { type: Type.STRING },\n                step3_inviteLink: { type: Type.STRING },\n              },\n              required: [\'step1_empathy\', \'step2_qualifyQuestion\', \'step3_inviteLink\'],\n            },\n          },\n          required: [\n            \'selectedProgramId\',\n            \'selectedProgramTitle\',\n            \'selectedProgramType\',\n            \'rationale\',\n            \'platformNotes\',\n            \'primaryContent\',\n            \'variations\',\n            \'dmFollowUpScript\',\n          ],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n\n    res.json({\n      success: true,\n      data: parsed,\n    });\n  } catch (error: any) {\n    console.error(\'Error generating order content:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi t\341\272\241o n\341\273\231i dung Order.\' });\n  }\n});\n\n// 3. Automated Order Chat Assistant\napp.post(\'/api/chat\', async (req: Request, res: Response) => {\n  try {\n    const { message, history, programs } = req.body;\n    const lowerMessage = (message || \'\').trim().toLowerCase();\n\n    // Special trigger: If message is \"hi\" or greeting, immediately return the automated Order menu\n    if (lowerMessage === \'hi\' || lowerMessage === \'hello\' || lowerMessage === \'xin ch\303\240o\' || lowerMessage === \'ch\303\240o\') {\n      const orderMenuText = `Xin ch\303\240o b\341\272\241n! M\303\254nh l\303\240 Tr\341\273\243 l\303\275 AI Content & Social Media Manager (10 n\304\203m kinh nghi\341\273\207m). M\303\254nh \304\221\303\243 s\341\272\265n s\303\240ng h\341\273\227 tr\341\273\243 b\341\272\241n s\341\272\243n xu\341\272\245t content chuy\341\273\203n \304\221\341\273\225i v\303\240 d\341\272\253n d\341\272\257t 1-1 theo chu\341\272\251n t\341\273\253ng n\341\273\201n t\341\272\243ng.\n\nD\306\260\341\273\233i \304\221\303\242y l\303\240 danh s\303\241ch c\303\241c Order t\341\273\261 \304\221\341\273\231ng, b\341\272\241n ch\341\273\211 c\341\272\247n g\303\265 **Order [s\341\273\221]** k\303\250m th\303\264ng tin/m\303\264 t\341\272\243 clip/post ho\341\272\267c g\341\273\255i \341\272\243nh m\303\240n h\303\254nh nh\303\251:\n\n\360\237\223\213 **DANH S\303\201CH ORDER T\341\273\260 \304\220\341\273\230NG:**\n- **Order 1**: Comment qua clip TikTok (\304\220\341\273\223ng c\341\272\243m tu\341\273\225i 20-39, t\341\272\267ng b\303\240i test 1-1)\n- **Order 2**: Comment qua post Facebook (*Ch\341\273\211 Workshop (WS), tone trung l\341\272\255p ph\303\242n t\303\255ch hai chi\341\273\201u)\n- **Order 3**: Vi\341\272\277t b\303\240i Facebook (*Ch\341\273\211 Workshop (WS), ph\303\242n t\303\255ch s\303\242u s\341\272\257c, h\341\273\217i link)\n- **Order 4**: Comment Threads (T\341\273\261 s\341\273\261, ch\303\242n th\341\272\255t, ch\341\272\241m n\341\273\227i \304\221au n\341\273\231i t\303\242m)\n- **Order 5**: Vi\341\272\277t b\303\240i Threads (Ng\341\272\257n g\341\273\215n, hook b\341\272\257t tai, ng\341\272\257t d\303\262ng nh\341\273\213p nh\303\240ng)\n- **Order 6**: Vi\341\272\277t b\303\240i ti\341\272\277p c\341\272\255n qua tin nh\341\272\257n LinkedIn (G\303\263c nh\303\254n HRBP/L&D, MBTI & n\304\203ng l\306\260\341\273\243ng)\n- **Order 7**: Vi\341\272\277t content Email (Ti\303\252u \304\221\341\273\201 t\303\262 m\303\262, c\303\242u chuy\341\273\207n k\341\272\277t n\341\273\221i, c\303\242u h\341\273\217i t\341\273\261 v\341\272\245n)\n\n\360\237\221\211 *B\341\272\241n mu\341\273\221n th\341\273\261c hi\341\273\207n Order n\303\240o ngay b\303\242y gi\341\273\235? H\303\243y g\303\265 v\303\255 d\341\273\245: \"Order 1 [m\303\264 t\341\272\243 clip]\" ho\341\272\267c b\341\272\245m n\303\272t Order b\303\252n d\306\260\341\273\233i.*`;\n\n      return res.json({\n        success: true,\n        reply: orderMenuText,\n        suggestedActions: [\n          { label: \'\360\237\216\254 Order 1: Comment TikTok\', action: \'Order 1\', orderType: \'order_1\' },\n          { label: \'\360\237\222\254 Order 2: Comment Facebook\', action: \'Order 2\', orderType: \'order_2\' },\n          { label: \'\360\237\223\235 Order 3: B\303\240i vi\341\272\277t Facebook\', action: \'Order 3\', orderType: \'order_3\' },\n          { label: \'\360\237\247\265 Order 4: Comment Threads\', action: \'Order 4\', orderType: \'order_4\' },\n          { label: \'\342\234\215\357\270\217 Order 5: B\303\240i vi\341\272\277t Threads\', action: \'Order 5\', orderType: \'order_5\' },\n          { label: \'\360\237\222\274 Order 6: Tin nh\341\272\257n LinkedIn\', action: \'Order 6\', orderType: \'order_6\' },\n          { label: \'\360\237\223\247 Order 7: Content Email\', action: \'Order 7\', orderType: \'order_7\' },\n        ],\n      });\n    }\n\n    const ai = getAi();\n    const systemPrompt = `B\341\272\241n l\303\240 Content Master 10 n\304\203m kinh nghi\341\273\207m, Social Media Manager chuy\303\252n s\303\242u 4 n\341\273\201n t\341\272\243ng (TikTok, Facebook, Threads, LinkedIn, Email).\nNhi\341\273\207m v\341\273\245 c\341\273\247a b\341\272\241n l\303\240 h\341\273\227 tr\341\273\243 ng\306\260\341\273\235i d\303\271ng s\341\272\243n xu\341\272\245t content chuy\341\273\203n \304\221\341\273\225i comment th\303\240nh inbox v\303\240 k\341\273\213ch b\341\272\243n chat 1-1.\n\nQUY T\341\272\256C B\341\272\256T BU\341\273\230C:\n- N\341\272\277u ng\306\260\341\273\235i d\303\271ng y\303\252u c\341\272\247u Order 1-7, h\303\243y ki\341\273\203m tra quy t\341\272\257c: Facebook TUY\341\273\206T \304\220\341\273\220I ch\341\273\211 r\341\272\243i Workshop (WS), KH\303\224NG r\341\272\243i Ch\306\260\306\241ng tr\303\254nh (CT). Tone Facebook ph\341\272\243i trung l\341\272\255p, ph\303\242n t\303\255ch \304\221a chi\341\273\201u cho c\341\272\243 hai b\303\252n, h\341\272\241 th\341\272\245p b\341\272\243n th\303\242n, kh\303\264ng d\303\271ng c\303\242u kh\341\272\263ng \304\221\341\273\213nh \303\241p \304\221\341\272\267t.\n- C\303\241c ch\306\260\306\241ng tr\303\254nh kh\303\264ng d\341\272\241y k\341\273\271 n\304\203ng ki\341\272\277m ti\341\273\201n/h\306\260\341\273\233ng nghi\341\273\207p b\341\273\201 n\341\273\225i m\303\240 t\341\272\255p trung th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n, s\341\273\251c b\341\273\201n tinh th\341\272\247n, gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201.\n- Lu\303\264n \304\221\306\260a ra g\341\273\243i \303\275 k\341\273\213ch b\341\272\243n tr\341\272\243 l\341\273\235i tin nh\341\272\257n 1-1 (DM) khi c\303\263 ng\306\260\341\273\235i quan t\303\242m.\n\nDANH S\303\201CH WS/CT HI\341\273\206N C\303\223:\n${JSON.stringify(programs || [], null, 2)}`;\n\n    const contents = [];\n    if (history && Array.isArray(history)) {\n      for (const h of history.slice(-6)) {\n        contents.push({\n          role: h.role === \'user\' ? \'user\' : \'model\',\n          parts: [{ text: h.content }],\n        });\n      }\n    }\n    contents.push({\n      role: \'user\',\n      parts: [{ text: message }],\n    });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.7-flash\',\n      contents,\n      config: {\n        systemInstruction: systemPrompt,\n      },\n    });\n\n    res.json({\n      success: true,\n      reply: response.text || \'\304\220\303\243 x\341\273\255 l\303\275 xong y\303\252u c\341\272\247u c\341\273\247a b\341\272\241n.\',\n    });\n  } catch (error: any) {\n    console.error(\'Error in chat:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi x\341\273\255 l\303\275 chat.\' });\n  }\n});\n\n// Setup Vite or Static serve\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req: Request, res: Response) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Server running at http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
