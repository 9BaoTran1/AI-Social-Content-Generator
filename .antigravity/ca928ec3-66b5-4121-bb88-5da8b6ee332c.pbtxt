          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                <p className={`text-xs leading-relaxed ${isDark ? \'text-slate-400\' : \'text-slate-500\'}`}>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                  Nh\341\272\255p \303\275 t\306\260\341\273\237ng b\303\240i \304\221\304\203ng \341\273\237 c\341\273\231t b\303\252n tr\303\241i v\303\240 b\341\272\245m <strong>\"T\341\272\241o 3 Ph\306\260\306\241ng \303\201n & K\341\273\213ch B\341\272\243n DM\"</strong> \304\221\341\273\203 nh\341\272\255n ngay k\341\272\277t qu\341\272\243."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                </p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          )}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
