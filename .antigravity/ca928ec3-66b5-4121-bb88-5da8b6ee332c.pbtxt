    instruction: "Implement resilient Gemini API call with exponential backoff retry and model fallback for 503 high demand spikes"
    replacement_infos {
      original_chunk {
        target_content: "// Lazy initialize GoogleGenAI with telemetry header\nlet aiClient: GoogleGenAI | null = null;\nfunction getAi(): GoogleGenAI {\n  if (!aiClient) {\n    const apiKey = process.env.GEMINI_API_KEY;\n    if (!apiKey) {\n      console.warn(\'GEMINI_API_KEY is not set. Using fallback mode.\');\n    }\n    aiClient = new GoogleGenAI({\n      apiKey: apiKey || \'\',\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.json({ status: \'ok\', timestamp: new Date().toISOString() });\n});\n\n// 1. Extract Program/Workshop from Link, Raw Text, or Image\napp.post(\'/api/extract-program\', async (req: Request, res: Response) => {\n  try {\n    const { url, text, imageBase64 } = req.body;\n\n    if (!url && !text && !imageBase64) {\n      return res.status(400).json({ error: \'Vui l\303\262ng cung c\341\272\245p link Tally/Google Forms, n\341\273\231i dung v\304\203n b\341\272\243n ho\341\272\267c h\303\254nh \341\272\243nh.\' });\n    }\n\n    const ai = getAi();\n    const systemPrompt = `B\341\272\241n l\303\240 m\341\273\231t chuy\303\252n gia ph\303\242n t\303\255ch n\341\273\231i dung Social Media v\303\240 Qu\341\272\243n l\303\275 \304\220\303\240o t\341\272\241o (10 n\304\203m kinh nghi\341\273\207m).\nNhi\341\273\207m v\341\273\245 c\341\273\247a b\341\272\241n l\303\240 b\303\263c t\303\241ch v\303\240 ph\303\242n t\303\255ch th\303\264ng tin c\341\273\247a Workshop (WS) ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh (CT) t\341\273\253 link Tally, Google Forms, text m\303\264 t\341\272\243 ho\341\272\267c h\303\254nh \341\272\243nh \304\221\306\260\341\273\243c cung c\341\272\245p.\n\nQUY T\341\272\256C PH\303\202N LO\341\272\240I & \304\220\341\272\266C \304\220I\341\273\202M C\341\273\220T L\303\225I:\n- Ph\303\242n lo\341\272\241i r\303\265: \'ws\' (Workshop / Talkshow / Bu\341\273\225i chia s\341\272\273 ng\341\272\257n h\341\272\241n) ho\341\272\267c \'ct\' (Ch\306\260\306\241ng tr\303\254nh / Kh\303\263a h\341\273\215c / H\303\240nh tr\303\254nh nhi\341\273\201u b\306\260\341\273\233c / B\303\240i test \304\221\341\273\213nh v\341\273\213).\n- T\341\272\244T C\341\272\242 c\303\241c ch\306\260\306\241ng tr\303\254nh/workshop \304\221\341\273\201u KH\303\224NG nh\341\272\261m m\341\273\245c \304\221\303\255ch h\306\260\341\273\233ng nghi\341\273\207p k\341\273\271 n\304\203ng c\341\273\251ng hay ki\341\272\277m ti\341\273\201n, m\303\240 t\341\272\255p trung v\303\240o: th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n, nh\341\272\255n di\341\273\207n th\341\272\277 m\341\272\241nh, s\341\273\251c b\341\273\201n tinh th\341\272\247n, gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng, t\306\260 duy giao ti\341\272\277p v\303\240 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n.\n- Kh\303\264ng g\303\241n \303\251p template cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech, Y t\341\272\277...).\n- Ng\306\260\341\273\235i tham d\341\273\261 l\303\240 ng\306\260\341\273\235i mu\341\273\221n hi\341\273\203u m\303\254nh v\303\240 l\303\240m b\341\272\243n th\303\242n t\341\273\221t h\306\241n, kh\303\264ng ph\341\272\243i \304\221\341\272\277n \304\221\341\273\203 l\303\240m di\341\273\205n gi\341\272\243 hay d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n\nH\303\243y tr\303\255ch xu\341\272\245t v\303\240 tr\341\272\243 v\341\273\201 \304\221\341\273\213nh d\341\272\241ng JSON ch\303\255nh x\303\241c:\n{\n  \"title\": \"T\303\252n WS ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh\",\n  \"type\": \"ws\" | \"ct\",\n  \"description\": \"M\303\264 t\341\272\243 s\303\272c t\303\255ch v\341\273\201 gi\303\241 tr\341\273\213 v\303\240 m\341\273\245c ti\303\252u (2-3 c\303\242u)\",\n  \"targetAudience\": [\"\304\220\341\273\221i t\306\260\341\273\243ng 1 (k\303\250m \304\221\341\273\231 tu\341\273\225i n\341\272\277u c\303\263)\", \"\304\220\341\273\221i t\306\260\341\273\243ng 2\", \"\304\220\341\273\221i t\306\260\341\273\243ng 3\"],\n  \"painPoints\": [\"N\341\273\227i \304\221au 1\", \"N\341\273\227i \304\221au 2\", \"N\341\273\227i \304\221au 3\"],\n  \"coreValues\": [\"Gi\303\241 tr\341\273\213 mang l\341\272\241i 1\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 2\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 3\"],\n  \"testOrFormAngle\": \"M\303\264 t\341\272\243 g\303\263c ti\341\272\277p c\341\272\255n form/b\303\240i test (v\303\255 d\341\273\245: Template \304\221\303\241nh gi\303\241 t\303\255nh c\303\241ch & tham v\341\272\245n 1-1, Test \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n)\",\n  \"imageUrl\": \"Link \341\272\243nh n\341\272\277u t\303\254m th\341\272\245y trong text/link (ho\341\272\267c \304\221\341\273\203 tr\341\273\221ng)\",\n  \"tallyUrl\": \"Link Tally ho\341\272\267c Form n\341\272\277u c\303\263\",\n  \"notes\": \"Ghi ch\303\272 th\303\252m v\341\273\201 tone & mood ho\341\272\267c l\306\260u \303\275 \304\221\341\272\267c th\303\271\"\n}`;\n\n    const promptText = `H\303\243y ph\303\242n t\303\255ch v\303\240 tr\303\255ch xu\341\272\245t th\303\264ng tin Workshop / Ch\306\260\306\241ng tr\303\254nh t\341\273\253 d\341\273\257 li\341\273\207u sau:\n${url ? `Link Form / Tally: ${url}\\n` : \'\'}\n${text ? `N\341\273\231i dung m\303\264 t\341\272\243 / Text:\\n${text}\\n` : \'\'}`;\n\n    const contents: any[] = [];\n    if (imageBase64) {\n      const mimeType = imageBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : imageBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = imageBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      contents.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    contents.push({ text: promptText });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.7-flash\',\n      contents: { parts: contents },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            title: { type: Type.STRING },\n            type: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            description: { type: Type.STRING },\n            targetAudience: { type: Type.ARRAY, items: { type: Type.STRING } },\n            painPoints: { type: Type.ARRAY, items: { type: Type.STRING } },\n            coreValues: { type: Type.ARRAY, items: { type: Type.STRING } },\n            testOrFormAngle: { type: Type.STRING },\n            imageUrl: { type: Type.STRING },\n            tallyUrl: { type: Type.STRING },\n            notes: { type: Type.STRING },\n          },\n          required: [\'title\', \'type\', \'description\', \'targetAudience\', \'painPoints\', \'coreValues\', \'testOrFormAngle\'],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    if (url && !parsed.tallyUrl) {\n      parsed.tallyUrl = url;\n    }\n\n    res.json({\n      success: true,\n      data: parsed,\n    });\n  } catch (error: any) {\n    console.error(\'Error extracting program:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi tr\303\255ch xu\341\272\245t th\303\264ng tin ch\306\260\306\241ng tr\303\254nh.\' });\n  }\n});\n\n// 2. Generate Content for Orders 1-7\napp.post(\'/api/generate-order\', async (req: Request, res: Response) => {\n  try {\n    const {\n      orderType,\n      context,\n      screenshotBase64,\n      selectedProgramId,\n      programs,\n      options = {},\n    } = req.body;\n\n    const ai = getAi();\n\n    // Map order definitions and strict rules\n    const orderRules: Record<string, { platform: string; allowedTypes: string[]; rules: string }> = {\n      order_1: {\n        platform: \'TikTok\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 1: COMMENT QUA CLIP TIKTOK\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i comment th\303\240nh inbox t\341\273\261 nhi\303\252n, kh\303\264ng l\341\273\231 li\341\273\205u b\303\241n h\303\240ng.\n- Tone & Mood: \304\220\341\273\223ng c\341\272\243m s\303\242u s\341\272\257c, \341\272\245m \303\241p, nh\341\272\257m t\341\273\233i t\341\273\207p 20-39 tu\341\273\225i. \304\220\303\241nh tr\303\272ng t\303\242m l\303\275 so s\303\241nh b\341\272\243n th\303\242n, loay hoay \304\221\341\273\213nh h\306\260\341\273\233ng, hay t\341\273\245t mood, s\341\273\243 sai ho\341\272\267c qu\303\241 ch\303\272 tr\341\273\215ng chuy\303\252n m\303\264n m\303\240 qu\303\252n n\304\203ng l\341\273\261c th\341\272\245u hi\341\273\203u con ng\306\260\341\273\235i.\n- C\341\272\245u tr\303\272c:\n  1. C\303\242u hook \304\221\341\273\223ng c\341\272\243m ch\303\242n th\303\240nh v\341\273\233i ho\303\240n c\341\272\243nh trong clip.\n  2. Insight \304\221\341\272\257t gi\303\241 v\341\273\201 vi\341\273\207c hi\341\273\203u b\341\272\243n th\303\242n / r\303\250n luy\341\273\207n s\341\273\251c b\341\273\201n / n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201.\n  3. G\341\273\243i \303\275 nh\341\272\271 nh\303\240ng v\341\273\201 m\341\273\231t b\303\240i test/review nh\341\273\217 \304\221\303\241nh gi\303\241 1-1 mi\341\273\205n ph\303\255 gi\303\272p t\303\254m ra h\306\260\341\273\233ng \304\221i.\n  4. L\341\273\235i m\341\273\235i inbox nh\341\272\255n b\303\240i test free m\341\273\231t c\303\241ch khi\303\252m t\341\273\221n v\303\240 c\341\273\237i m\341\273\237.\n- Tham kh\341\272\243o gi\341\273\215ng \304\221i\341\273\207u chu\341\272\251n: \"M\303\254nh ngh\304\251 ai c\305\251ng n\303\252n cho b\341\272\243n th\303\242n c\306\241 h\341\273\231i \304\221\306\260\341\273\243c th\341\273\255... N\341\272\277u b\341\272\241n \304\221ang mu\341\273\221n hi\341\273\203u b\341\272\243n th\303\242n h\306\241n c\303\263 th\341\273\203 nh\341\272\257n m\303\254nh nh\303\251\" ho\341\272\267c \"G\341\273\255i c\303\241c b\341\272\241n \304\221ang \341\273\237 \304\221\341\273\231 tu\341\273\225i 20-39t... m\303\254nh c\303\263 1 b\303\240i test review nh\341\273\217 c\303\263 gi\341\272\243i \304\221\303\241p chi ti\341\272\277t 1-1...\"`,\n      },\n      order_2: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 2: COMMENT QUA POST FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG R\341\272\242I CH\306\257\306\240NG TR\303\214NH (CT). CH\341\273\210 \304\220\306\257\341\273\242C PH\303\211P \304\220\341\273\200 XU\341\272\244T WORKSHOP (WS).\n- Tone & Mood: Kh\303\241c v\341\273\233i TikTok/Threads, content Facebook KH\303\224NG mang t\303\255nh \304\221\341\273\223ng c\341\272\243m qu\303\241 \341\273\247y m\341\273\213 hay m\341\273\231t chi\341\273\201u. PH\341\272\242I C\303\223 S\341\273\260 KH\303\201CH QUAN, TRUNG L\341\272\254P, MANG T\303\215NH PH\303\202N T\303\215CH CHO C\341\272\242 \304\220\303\224I B\303\212N (v\303\255 d\341\273\245 g\303\263c nh\303\254n nh\303\242n vi\303\252n vs qu\341\272\243n l\303\275, \303\241p l\341\273\261c v\341\272\255n h\303\240nh vs nguy\341\273\207n v\341\273\215ng ph\303\241t tri\341\273\203n).\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG D\303\231NG C\303\202U KH\341\272\262NG \304\220\341\273\212NH \303\201P \304\220\341\272\266T nh\306\260: \"Thay v\303\254 loay hoay... th\303\254 h\303\243y...\" (nghe nh\306\260 ra l\341\273\207nh) ho\341\272\267c \"Vi\341\273\207c b\341\272\241n c\341\272\243m th\341\272\245y v\303\264 d\341\273\245ng th\341\273\261c ch\341\272\245t l\303\240 do b\341\272\241n b\341\273\213...\" (nghe ti\303\252u c\341\273\261c, 1 chi\341\273\201u, ph\341\272\243n c\341\272\243m).\n- H\341\272\240 TH\341\272\244P B\341\272\242N TH\303\202N TR\306\257\341\273\232C NG\306\257\341\273\234I XEM, d\303\271ng c\341\272\245u tr\303\272c m\341\273\201m m\341\273\217ng: \"T\303\254nh tr\341\272\241ng n\303\240y kh\303\264ng ph\341\272\243i m\341\273\231t m\303\254nh b\341\272\241n... B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS n\303\240y \304\221\341\273\203...\"\n- Ph\303\242n t\303\255ch th\341\273\261c t\341\272\277 \304\221\341\273\235i s\341\273\221ng c\303\264ng s\341\273\237 (v\303\255 d\341\273\245: manager b\341\273\213 \304\221\303\250 l\306\260\306\241ng, kh\341\273\221i l\306\260\341\273\243ng vi\341\273\207c t\303\241i c\341\272\245u tr\303\272c, \304\221\303\240o t\341\272\241o newbie...).`,\n      },\n      order_3: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 3: VI\341\272\276T B\303\200I FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I CH\341\273\210 VI\341\272\276T V\341\273\200 WORKSHOP (WS), KH\303\224NG CH\341\272\240Y CH\306\257\306\240NG TR\303\214NH (CT).\n- Tone & Mood: Kh\303\241ch quan, trung l\341\272\255p, ph\303\242n t\303\255ch \304\221a chi\341\273\201u, khi\303\252m t\341\273\221n. C\303\263 \304\221\341\273\231 s\303\242u v\341\273\201 tr\341\272\243i nghi\341\273\207m th\341\273\261c t\341\272\277 c\303\264ng vi\341\273\207c.\n- C\341\272\245u tr\303\272c:\n  1. M\341\273\237 b\303\240i b\341\272\261ng m\341\273\231t hi\341\273\207n t\306\260\341\273\243ng/t\303\254nh hu\341\273\221ng c\303\264ng s\341\273\237 ho\341\272\267c th\341\273\261c t\341\272\277 ph\341\273\225 bi\341\272\277n (kh\303\264ng k\341\272\277t lu\341\272\255n v\341\273\231i v\303\240ng).\n  2. Ph\303\242n t\303\255ch nguy\303\252n nh\303\242n s\303\242u xa t\341\273\253 g\303\263c \304\221\341\273\231 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201 ho\341\272\267c th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n.\n  3. \304\220\341\273\201 xu\341\272\245t khi\303\252m nh\306\260\341\273\235ng: \"B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS [T\303\252n WS] \304\221\341\273\203 c\303\271ng nh\303\254n nh\341\272\255n l\341\272\241i...\"\n  4. N\341\272\277u c\303\263 y\303\252u c\341\272\247u g\341\272\257n link: ch\303\250n v\341\273\213 tr\303\255 link \304\221\304\203ng k\303\275 r\303\265 r\303\240ng \341\273\237 cu\341\273\221i b\303\240i ho\341\272\267c d\306\260\341\273\233i comment.`,\n      },\n      order_4: {\n        platform: \'Threads\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 4: COMMENT THREADS\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i th\303\240nh inbox th\303\264ng qua t\303\242m s\341\273\261 ch\303\242n th\303\240nh.\n- Tone & Mood: Gi\341\273\215ng \304\221i\341\273\207u ch\303\242n th\341\272\255t (authentic), th\341\273\247 th\341\273\211, s\303\242u l\341\272\257ng, ng\341\272\257t d\303\262ng t\341\273\261 nhi\303\252n, nh\306\260 m\341\273\231t ng\306\260\341\273\235i b\341\272\241n c\303\271ng trang l\341\273\251a \304\221ang tr\341\272\243i l\303\262ng.\n- C\341\272\245u tr\303\272c: 3-5 c\303\242u ng\341\272\257n g\341\273\215n, ch\341\272\241m v\303\240o c\341\272\243m gi\303\241c b\341\272\277 t\341\272\257c ho\341\272\267c tr\304\203n tr\341\273\237 c\341\273\247a b\303\240i vi\341\272\277t g\341\273\221c, g\341\273\243i m\341\273\237 v\341\273\201 m\341\273\231t g\303\263c nh\303\254n soi chi\341\272\277u b\341\272\243n th\303\242n v\303\240 m\341\273\235i inbox nh\341\272\255n template/b\303\240i test 1-1 mi\341\273\205n ph\303\255.`,\n      },\n      order_5: {\n        platform: \'Threads\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 5: VI\341\272\276T B\303\200I THREADS\n- \304\220\341\273\213nh d\341\272\241ng: Chu\341\273\227i c\303\241c \304\221o\341\272\241n ng\341\272\257n g\341\273\215n (1-2 c\303\242u m\341\273\227i \304\221o\341\272\241n), ng\341\272\257t d\303\262ng tho\303\241ng, d\341\273\205 \304\221\341\273\215c tr\303\252n mobile.\n- Tone & Mood: T\341\273\261 s\341\273\261, s\303\242u s\341\272\257c, chia s\341\272\273 b\303\240i h\341\273\215c th\341\272\255t t\341\273\253 b\341\272\243n th\303\242n, kh\303\264ng gi\341\272\243ng \304\221\341\272\241o hay d\341\272\241y \304\221\341\273\235i.\n- Hook m\341\273\237 \304\221\341\272\247u \304\221\303\241nh tr\303\272ng insight t\303\242m l\303\275 ng\306\260\341\273\235i tr\341\272\273 \304\221i l\303\240m.\n- \304\220o\341\272\241n k\341\272\277t m\341\273\237, m\341\273\235i m\341\273\215i ng\306\260\341\273\235i th\341\272\243o lu\341\272\255n ho\341\272\267c nh\341\272\257n tin ri\303\252ng \304\221\341\273\203 nh\341\272\255n b\341\273\231 c\303\242u h\341\273\217i/template soi chi\341\272\277u 1-1.`,\n      },\n      order_6: {\n        platform: \'LinkedIn\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 6: TI\341\272\276P C\341\272\254N QUA TIN NH\341\272\256N LINKEDIN (INMAIL/DM)\n- Tone & Mood: Chuy\303\252n nghi\341\273\207p, l\341\273\213ch thi\341\273\207p, \341\272\245m \303\241p, \304\221\341\273\213nh v\341\273\213 ng\306\260\341\273\235i g\341\273\255i l\303\240 HRBP ho\341\272\267c c\341\273\231ng t\303\241c vi\303\252n L&D y\303\252u th\303\255ch nghi\303\252n c\341\273\251u ph\303\241t tri\341\273\203n con ng\306\260\341\273\235i.\n- C\304\203n c\341\273\251 khoa h\341\273\215c: Nh\341\272\257c \304\221\341\272\277n c\303\264ng c\341\273\245 khoa h\341\273\215c (MBTI, test t\303\255nh c\303\241ch, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng work-life, \304\221\341\273\213nh h\306\260\341\273\233ng c\303\241 nh\303\242n h\303\263a).\n- M\341\272\253u chu\341\272\251n: \"Xin ch\303\240o b\341\272\241n, m\303\254nh l\303\240 [T\303\252n], hi\341\273\207n \304\221ang l\303\240m HRBP... D\341\273\261 \303\241n phi l\341\273\243i nhu\341\272\255n/t\303\242m huy\341\272\277t d\303\240nh cho sinh vi\303\252n v\303\240 ng\306\260\341\273\235i \304\221i l\303\240m, mi\341\273\205n ph\303\255 tham v\341\272\245n 1:1...\"\n- Lu\303\264n k\341\272\277t th\303\272c b\341\272\261ng l\341\273\235i ch\303\272c t\303\255ch c\341\273\261c, l\341\273\213ch s\341\273\261, kh\303\264ng \303\251p bu\341\273\231c.`,\n      },\n      order_7: {\n        platform: \'Email\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 7: VI\341\272\276T CONTENT EMAIL\n- C\341\272\245u tr\303\272c:\n  1. Ti\303\252u \304\221\341\273\201 (Subject Line): 3 g\341\273\243i \303\275 ti\303\252u \304\221\341\273\201 t\303\262 m\303\262, c\303\241 nh\303\242n h\303\263a, t\341\273\267 l\341\273\207 m\341\273\237 cao.\n  2. Hook m\341\273\237 \304\221\341\272\247u: L\341\273\235i ch\303\240o \341\272\245m \303\241p, k\341\272\277t n\341\273\221i b\341\272\261ng m\341\273\231t c\303\242u chuy\341\273\207n ho\341\272\267c tr\304\203n tr\341\273\237 th\341\273\261c t\341\272\277.\n  3. Th\303\242n b\303\240i: Ph\303\242n t\303\255ch insight, \304\221\306\260a ra 2-3 c\303\242u h\341\273\217i t\341\273\261 v\341\272\245n s\303\242u s\341\272\257c.\n  4. Gi\341\273\233i thi\341\273\207u Workshop/Ch\306\260\306\241ng tr\303\254nh nh\306\260 m\341\273\231t gi\341\272\243i ph\303\241p \304\221\341\273\223ng h\303\240nh soi g\306\260\306\241ng v\303\240 b\341\273\251t ph\303\241.\n  5. Call to action (CTA): R\303\265 r\303\240ng, th\303\272c \304\221\341\272\251y \304\221\304\203ng k\303\275 form ho\341\272\267c ph\341\272\243n h\341\273\223i email.`,\n      },\n    };\n\n    const currentOrder = orderRules[orderType] || orderRules.order_1;\n\n    // Filter available programs based on platform restrictions\n    let availablePrograms = (programs || []).filter((p: any) => p.isActive !== false);\n    if (currentOrder.allowedTypes.length === 1 && currentOrder.allowedTypes[0] === \'ws\') {\n      availablePrograms = availablePrograms.filter((p: any) => p.type === \'ws\');\n    }\n\n    const systemPrompt = `B\341\272\241n l\303\240 m\341\273\231t Content Master 10 n\304\203m kinh nghi\341\273\207m v\303\240 Social Media Manager xu\341\272\245t s\341\272\257c, qu\341\272\243n l\303\275 4 n\341\273\201n t\341\272\243ng ch\303\255nh: TikTok, Facebook, Threads, LinkedIn v\303\240 Email.\nM\341\273\245c ti\303\252u t\341\273\221i th\306\260\341\273\243ng c\341\273\247a b\341\272\241n l\303\240: T\341\272\240O RA CONTENT CHUY\341\273\202N \304\220\341\273\224I CAO T\341\273\252 COMMENT/B\303\200I \304\220\304\202NG TH\303\200NH INBOX (1-1 DM / CHAT LEAD), sau \304\221\303\263 cung c\341\272\245p k\341\273\213ch b\341\272\243n d\341\272\253n d\341\272\257t tr\303\262 chuy\341\273\207n 1-1 \304\221\341\273\203 chuy\341\273\203n \304\221\341\273\225i sang \304\221\304\203ng k\303\275 Workshop/Ch\306\260\306\241ng tr\303\254nh.\n\nQUY T\341\272\256C C\341\273\220T L\303\225I B\341\272\256T BU\341\273\230C:\n1. KH\303\224NG vi\341\272\277t theo h\306\260\341\273\233ng h\306\260\341\273\233ng nghi\341\273\207p ki\341\272\277m ti\341\273\201n hay k\341\273\271 n\304\203ng b\303\252n ngo\303\240i (nh\306\260 thuy\341\272\277t tr\303\254nh, ki\341\272\277m ti\341\273\201n nhanh...). Ng\306\260\341\273\235i tham gia l\303\240 ng\306\260\341\273\235i mu\341\273\221n HI\341\273\202U M\303\214NH, T\303\214M \304\220I\341\273\202M M\341\272\240NH TH\341\273\260C S\341\273\260, R\303\210N S\341\273\250C B\341\273\200N V\303\200 PH\303\201T TRI\341\273\202N N\341\273\230I T\341\273\260.\n2. KH\303\224NG m\341\273\235i ng\306\260\341\273\235i \304\221\341\273\215c l\303\240m kh\303\241ch m\341\273\235i/di\341\273\205n gi\341\272\243 hay \304\221\303\263ng g\303\263p g\303\263c nh\303\254n \304\221\341\273\203 d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n3. KH\303\224NG \303\241p \304\221\341\272\267t khu\303\264n m\341\272\253u cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech...). Template ch\303\255nh l\303\240 form/test c\341\273\247a d\341\273\261 \303\241n.\n4. TUY\341\273\206T \304\220\341\273\220I CH\341\272\244P H\303\200NH NGUY\303\212N T\341\272\256C RI\303\212NG C\341\273\246A T\341\273\252NG N\341\273\200N T\341\272\242NG THEO ORDER:\n${currentOrder.rules}\n\nDANH S\303\201CH WORKSHOP/CH\306\257\306\240NG TR\303\214NH KH\341\272\242 D\341\273\244NG:\n${JSON.stringify(availablePrograms, null, 2)}\n\nH\303\243y ph\303\242n t\303\255ch ng\341\273\257 c\341\272\243nh ng\306\260\341\273\235i d\303\271ng \304\221\306\260a v\303\240o (n\341\273\231i dung clip, post, ho\341\272\267c screenshot), ch\341\273\215n Workshop/Ch\306\260\306\241ng tr\303\254nh ph\303\271 h\341\273\243p nh\341\272\245t (n\341\272\277u ng\306\260\341\273\235i d\303\271ng ch\306\260a ch\341\273\211 \304\221\341\273\213nh), v\303\240 t\341\272\241o ra s\341\272\243n ph\341\272\251m ho\303\240n ch\341\273\211nh theo c\341\272\245u tr\303\272c JSON.`;\n\n    const userPrompt = `Y\303\212U C\341\272\246U TH\341\273\260C HI\341\273\206N:\n- Lo\341\272\241i Order: ${orderType} (${currentOrder.platform})\n- Ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng / Clip / Tr\304\203n tr\341\273\237:\n\"${context || \'Ng\306\260\341\273\235i tr\341\272\273 loay hoay v\341\273\201 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, t\341\273\261 ti so s\303\241nh v\303\240 ch\306\260a d\303\241m kh\341\272\263ng \304\221\341\273\213nh th\341\272\277 m\341\272\241nh\'}\"\n${selectedProgramId ? `- Workshop/Ch\306\260\306\241ng tr\303\254nh \304\221\306\260\341\273\243c ch\341\273\211 \304\221\341\273\213nh ID: ${selectedProgramId}` : \'- H\303\243y t\341\273\261 \304\221\341\273\231ng ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t t\341\273\253 danh s\303\241ch.\'}\n- T\303\271y ch\341\273\215n:\n  * G\341\272\257n link \304\221\304\203ng k\303\275: ${options.includeLink ? \'C\303\263 g\341\272\257n link\' : \'Kh\303\264ng g\341\272\257n link tr\341\273\261c ti\341\272\277p (k\303\252u g\341\273\215i inbox)\'}\n  * Gi\341\273\233i thi\341\273\207u ch\306\260\306\241ng tr\303\254nh/WS: ${options.introduceProgram !== false ? \'C\303\263\' : \'Ch\341\273\211 nh\341\272\257c nh\341\272\271\'}\n  * T\303\271y ch\341\273\211nh tone: ${options.tone || \'T\341\273\261 \304\221\341\273\231ng theo chu\341\272\251n n\341\273\201n t\341\272\243ng\'}\n  * \304\220\341\273\221i t\306\260\341\273\243ng nh\341\272\257m t\341\273\233i: ${options.customAudience || \'Theo chu\341\272\251n d\341\273\261 \303\241n\'}\n\nH\303\243y xu\341\272\245t k\341\272\277t qu\341\272\243 JSON:\n{\n  \"selectedProgramId\": \"id c\341\273\247a WS/CT \304\221\306\260\341\273\243c ch\341\273\215n\",\n  \"selectedProgramTitle\": \"T\303\252n WS/CT\",\n  \"selectedProgramType\": \"ws\" | \"ct\",\n  \"rationale\": \"L\303\275 do v\303\254 sao ch\341\273\215n WS/CT n\303\240y v\303\240 ph\303\242n t\303\255ch insight kh\303\241ch h\303\240ng t\341\273\253 context\",\n  \"platformNotes\": \"L\306\260u \303\275 \304\221\341\272\267c bi\341\273\207t v\341\273\201 tone & mood theo quy t\341\272\257c c\341\273\247a n\341\273\201n t\341\272\243ng\",\n  \"primaryContent\": \"N\341\273\231i dung ch\303\255nh ho\303\240n ch\341\273\211nh nh\341\272\245t\",\n  \"variations\": [\n    \"Variation 1: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 1 (t\341\272\255p trung v\303\240o c\341\272\243m x\303\272c / c\303\242u chuy\341\273\207n c\303\241 nh\303\242n)\",\n    \"Variation 2: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 2 (t\341\272\255p trung v\303\240o ph\303\242n t\303\255ch kh\303\241ch quan / g\303\263c nh\303\254n ng\306\260\341\273\235i \304\221i l\303\240m)\",\n    \"Variation 3: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 3 (t\341\272\255p trung v\303\240o b\303\240i test \304\221\303\241nh gi\303\241 1-1 / khoa h\341\273\215c t\303\255nh c\303\241ch)\"\n  ],\n  \"dmFollowUpScript\": {\n    \"step1_empathy\": \"L\341\273\235i m\341\273\237 \304\221\341\272\247u trong DM khi c\303\263 ng\306\260\341\273\235i b\303\254nh lu\341\272\255n/inbox h\341\273\217i: \304\220\341\273\223ng c\341\272\243m, ghi nh\341\272\255n c\341\272\243m x\303\272c v\303\240 t\341\272\241o kh\303\264ng gian an to\303\240n\",\n    \"step2_qualifyQuestion\": \"C\303\242u h\341\273\217i \304\221\303\240o s\303\242u 1-1: 1-2 c\303\242u h\341\273\217i kh\303\251o l\303\251o \304\221\341\273\203 hi\341\273\203u r\303\265 t\303\254nh tr\341\272\241ng hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n \341\272\245y (v\303\255 d\341\273\245: \'Hi\341\273\207n t\341\272\241i b\341\272\241n \304\221ang c\341\272\243m th\341\272\245y ph\303\242n v\303\242n \341\273\237 \304\221i\341\273\203m n\303\240o nh\341\272\245t...\')\",\n    \"step3_inviteLink\": \"L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / link tham v\341\272\245n 1-1: Nh\341\272\271 nh\303\240ng, mi\341\273\205n ph\303\255 v\303\240 cam k\341\272\277t \304\221\341\273\223ng h\303\240nh\"\n  }\n}`;\n\n    const parts: any[] = [];\n    if (screenshotBase64) {\n      const mimeType = screenshotBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : screenshotBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = screenshotBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      parts.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    parts.push({ text: userPrompt });\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.7-flash\',\n      contents: { parts },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            selectedProgramId: { type: Type.STRING },\n            selectedProgramTitle: { type: Type.STRING },\n            selectedProgramType: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            rationale: { type: Type.STRING },\n            platformNotes: { type: Type.STRING },\n            primaryContent: { type: Type.STRING },\n            variations: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n            },\n            dmFollowUpScript: {\n              type: Type.OBJECT,\n              properties: {\n                step1_empathy: { type: Type.STRING },\n                step2_qualifyQuestion: { type: Type.STRING },\n                step3_inviteLink: { type: Type.STRING },\n              },\n              required: [\'step1_empathy\', \'step2_qualifyQuestion\', \'step3_inviteLink\'],\n            },\n          },\n          required: [\n            \'selectedProgramId\',\n            \'selectedProgramTitle\',\n            \'selectedProgramType\',\n            \'rationale\',\n            \'platformNotes\',\n            \'primaryContent\',\n            \'variations\',\n            \'dmFollowUpScript\',\n          ],\n        },\n      },\n    });"
        replacement_content: "// Lazy initialize GoogleGenAI with telemetry header\nlet aiClient: GoogleGenAI | null = null;\nfunction getAi(): GoogleGenAI {\n  if (!aiClient) {\n    const apiKey = process.env.GEMINI_API_KEY;\n    if (!apiKey) {\n      console.warn(\'GEMINI_API_KEY is not set. Using fallback mode.\');\n    }\n    aiClient = new GoogleGenAI({\n      apiKey: apiKey || \'\',\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n  }\n  return aiClient;\n}\n\n// Resilient API Caller with Exponential Backoff Retry & Fallback\nasync function generateContentWithRetry(\n  params: {\n    contents: any;\n    config?: any;\n  },\n  primaryModel: string = \'gemini-3.7-flash\',\n  maxRetriesPerModel: number = 3\n) {\n  const ai = getAi();\n  const modelsToTry = [primaryModel, \'gemini-flash-latest\'];\n  let lastError: any = null;\n\n  for (const modelName of modelsToTry) {\n    for (let attempt = 1; attempt <= maxRetriesPerModel; attempt++) {\n      try {\n        const response = await ai.models.generateContent({\n          model: modelName,\n          contents: params.contents,\n          config: params.config,\n        });\n        return response;\n      } catch (err: any) {\n        lastError = err;\n        const errMsg = err?.message || String(err);\n        const isUnavailableOrRateLimited =\n          errMsg.includes(\'503\') ||\n          errMsg.includes(\'429\') ||\n          errMsg.includes(\'UNAVAILABLE\') ||\n          errMsg.includes(\'high demand\') ||\n          errMsg.includes(\'RESOURCE_EXHAUSTED\') ||\n          errMsg.includes(\'overloaded\');\n\n        console.warn(`[Gemini API] Model \'${modelName}\' attempt ${attempt}/${maxRetriesPerModel} failed: ${errMsg}`);\n\n        if (isUnavailableOrRateLimited && attempt < maxRetriesPerModel) {\n          const delayMs = attempt * 1000 + Math.floor(Math.random() * 500);\n          console.log(`[Gemini API] Retrying in ${delayMs}ms due to high demand/rate limit...`);\n          await new Promise((resolve) => setTimeout(resolve, delayMs));\n        } else if (!isUnavailableOrRateLimited) {\n          // If non-transient error (e.g. invalid arguments), don\'t retry endlessly with this model\n          break;\n        }\n      }\n    }\n  }\n\n  // Handle human-friendly message if all attempts failed\n  const errMsg = lastError?.message || String(lastError);\n  if (\n    errMsg.includes(\'503\') ||\n    errMsg.includes(\'high demand\') ||\n    errMsg.includes(\'UNAVAILABLE\') ||\n    errMsg.includes(\'overloaded\')\n  ) {\n    throw new Error(\n      \'M\303\264 h\303\254nh AI \304\221ang c\303\263 l\306\260\341\273\243ng ng\306\260\341\273\235i d\303\271ng truy c\341\272\255p cao \304\221\341\273\231t bi\341\272\277n t\341\273\253 Google (503 High Demand). H\341\273\207 th\341\273\221ng \304\221\303\243 t\341\273\261 \304\221\341\273\231ng th\341\273\255 l\341\272\241i nhi\341\273\201u l\341\272\247n nh\306\260ng ch\306\260a k\341\273\213p ph\341\272\243n h\341\273\223i. B\341\272\241n vui l\303\262ng b\341\272\245m n\303\272t \"Th\341\273\255 l\341\272\241i\" sau v\303\240i gi\303\242y.\'\n    );\n  }\n  if (errMsg.includes(\'429\') || errMsg.includes(\'RESOURCE_EXHAUSTED\')) {\n    throw new Error(\n      \'H\341\272\241n ng\341\272\241ch x\341\273\255 l\303\275 AI t\341\272\241m th\341\273\235i b\341\272\255n (429 Rate Limit). Vui l\303\262ng \304\221\341\273\243i 3-5 gi\303\242y v\303\240 b\341\272\245m \"Th\341\273\255 l\341\272\241i\".\'\n    );\n  }\n  throw lastError;\n}\n\n// Health check endpoint\napp.get(\'/api/health\', (req: Request, res: Response) => {\n  res.json({ status: \'ok\', timestamp: new Date().toISOString() });\n});\n\n// 1. Extract Program/Workshop from Link, Raw Text, or Image\napp.post(\'/api/extract-program\', async (req: Request, res: Response) => {\n  try {\n    const { url, text, imageBase64 } = req.body;\n\n    if (!url && !text && !imageBase64) {\n      return res.status(400).json({ error: \'Vui l\303\262ng cung c\341\272\245p link Tally/Google Forms, n\341\273\231i dung v\304\203n b\341\272\243n ho\341\272\267c h\303\254nh \341\272\243nh.\' });\n    }\n\n    const systemPrompt = `B\341\272\241n l\303\240 m\341\273\231t chuy\303\252n gia ph\303\242n t\303\255ch n\341\273\231i dung Social Media v\303\240 Qu\341\272\243n l\303\275 \304\220\303\240o t\341\272\241o (10 n\304\203m kinh nghi\341\273\207m).\nNhi\341\273\207m v\341\273\245 c\341\273\247a b\341\272\241n l\303\240 b\303\263c t\303\241ch v\303\240 ph\303\242n t\303\255ch th\303\264ng tin c\341\273\247a Workshop (WS) ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh (CT) t\341\273\253 link Tally, Google Forms, text m\303\264 t\341\272\243 ho\341\272\267c h\303\254nh \341\272\243nh \304\221\306\260\341\273\243c cung c\341\272\245p.\n\nQUY T\341\272\256C PH\303\202N LO\341\272\240I & \304\220\341\272\266C \304\220I\341\273\202M C\341\273\220T L\303\225I:\n- Ph\303\242n lo\341\272\241i r\303\265: \'ws\' (Workshop / Talkshow / Bu\341\273\225i chia s\341\272\273 ng\341\272\257n h\341\272\241n) ho\341\272\267c \'ct\' (Ch\306\260\306\241ng tr\303\254nh / Kh\303\263a h\341\273\215c / H\303\240nh tr\303\254nh nhi\341\273\201u b\306\260\341\273\233c / B\303\240i test \304\221\341\273\213nh v\341\273\213).\n- T\341\272\244T C\341\272\242 c\303\241c ch\306\260\306\241ng tr\303\254nh/workshop \304\221\341\273\201u KH\303\224NG nh\341\272\261m m\341\273\245c \304\221\303\255ch h\306\260\341\273\233ng nghi\341\273\207p k\341\273\271 n\304\203ng c\341\273\251ng hay ki\341\272\277m ti\341\273\201n, m\303\240 t\341\272\255p trung v\303\240o: th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n, nh\341\272\255n di\341\273\207n th\341\272\277 m\341\272\241nh, s\341\273\251c b\341\273\201n tinh th\341\272\247n, gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng, t\306\260 duy giao ti\341\272\277p v\303\240 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n.\n- Kh\303\264ng g\303\241n \303\251p template cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech, Y t\341\272\277...).\n- Ng\306\260\341\273\235i tham d\341\273\261 l\303\240 ng\306\260\341\273\235i mu\341\273\221n hi\341\273\203u m\303\254nh v\303\240 l\303\240m b\341\272\243n th\303\242n t\341\273\221t h\306\241n, kh\303\264ng ph\341\272\243i \304\221\341\272\277n \304\221\341\273\203 l\303\240m di\341\273\205n gi\341\272\243 hay d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n\nH\303\243y tr\303\255ch xu\341\272\245t v\303\240 tr\341\272\243 v\341\273\201 \304\221\341\273\213nh d\341\272\241ng JSON ch\303\255nh x\303\241c:\n{\n  \"title\": \"T\303\252n WS ho\341\272\267c Ch\306\260\306\241ng tr\303\254nh\",\n  \"type\": \"ws\" | \"ct\",\n  \"description\": \"M\303\264 t\341\272\243 s\303\272c t\303\255ch v\341\273\201 gi\303\241 tr\341\273\213 v\303\240 m\341\273\245c ti\303\252u (2-3 c\303\242u)\",\n  \"targetAudience\": [\"\304\220\341\273\221i t\306\260\341\273\243ng 1 (k\303\250m \304\221\341\273\231 tu\341\273\225i n\341\272\277u c\303\263)\", \"\304\220\341\273\221i t\306\260\341\273\243ng 2\", \"\304\220\341\273\221i t\306\260\341\273\243ng 3\"],\n  \"painPoints\": [\"N\341\273\227i \304\221au 1\", \"N\341\273\227i \304\221au 2\", \"N\341\273\227i \304\221au 3\"],\n  \"coreValues\": [\"Gi\303\241 tr\341\273\213 mang l\341\272\241i 1\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 2\", \"Gi\303\241 tr\341\273\213 mang l\341\272\241i 3\"],\n  \"testOrFormAngle\": \"M\303\264 t\341\272\243 g\303\263c ti\341\272\277p c\341\272\255n form/b\303\240i test (v\303\255 d\341\273\245: Template \304\221\303\241nh gi\303\241 t\303\255nh c\303\241ch & tham v\341\272\245n 1-1, Test \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n)\",\n  \"imageUrl\": \"Link \341\272\243nh n\341\272\277u t\303\254m th\341\272\245y trong text/link (ho\341\272\267c \304\221\341\273\203 tr\341\273\221ng)\",\n  \"tallyUrl\": \"Link Tally ho\341\272\267c Form n\341\272\277u c\303\263\",\n  \"notes\": \"Ghi ch\303\272 th\303\252m v\341\273\201 tone & mood ho\341\272\267c l\306\260u \303\275 \304\221\341\272\267c th\303\271\"\n}`;\n\n    const promptText = `H\303\243y ph\303\242n t\303\255ch v\303\240 tr\303\255ch xu\341\272\245t th\303\264ng tin Workshop / Ch\306\260\306\241ng tr\303\254nh t\341\273\253 d\341\273\257 li\341\273\207u sau:\n${url ? `Link Form / Tally: ${url}\\n` : \'\'}\n${text ? `N\341\273\231i dung m\303\264 t\341\272\243 / Text:\\n${text}\\n` : \'\'}`;\n\n    const contents: any[] = [];\n    if (imageBase64) {\n      const mimeType = imageBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : imageBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = imageBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      contents.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    contents.push({ text: promptText });\n\n    const response = await generateContentWithRetry({\n      contents: { parts: contents },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            title: { type: Type.STRING },\n            type: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            description: { type: Type.STRING },\n            targetAudience: { type: Type.ARRAY, items: { type: Type.STRING } },\n            painPoints: { type: Type.ARRAY, items: { type: Type.STRING } },\n            coreValues: { type: Type.ARRAY, items: { type: Type.STRING } },\n            testOrFormAngle: { type: Type.STRING },\n            imageUrl: { type: Type.STRING },\n            tallyUrl: { type: Type.STRING },\n            notes: { type: Type.STRING },\n          },\n          required: [\'title\', \'type\', \'description\', \'targetAudience\', \'painPoints\', \'coreValues\', \'testOrFormAngle\'],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n    if (url && !parsed.tallyUrl) {\n      parsed.tallyUrl = url;\n    }\n\n    res.json({\n      success: true,\n      data: parsed,\n    });\n  } catch (error: any) {\n    console.error(\'Error extracting program:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi tr\303\255ch xu\341\272\245t th\303\264ng tin ch\306\260\306\241ng tr\303\254nh.\' });\n  }\n});\n\n// 2. Generate Content for Orders 1-7\napp.post(\'/api/generate-order\', async (req: Request, res: Response) => {\n  try {\n    const {\n      orderType,\n      context,\n      screenshotBase64,\n      selectedProgramId,\n      programs,\n      options = {},\n    } = req.body;\n\n    // Map order definitions and strict rules\n    const orderRules: Record<string, { platform: string; allowedTypes: string[]; rules: string }> = {\n      order_1: {\n        platform: \'TikTok\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 1: COMMENT QUA CLIP TIKTOK\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i comment th\303\240nh inbox t\341\273\261 nhi\303\252n, kh\303\264ng l\341\273\231 li\341\273\205u b\303\241n h\303\240ng.\n- Tone & Mood: \304\220\341\273\223ng c\341\272\243m s\303\242u s\341\272\257c, \341\272\245m \303\241p, nh\341\272\257m t\341\273\233i t\341\273\207p 20-39 tu\341\273\225i. \304\220\303\241nh tr\303\272ng t\303\242m l\303\275 so s\303\241nh b\341\272\243n th\303\242n, loay hoay \304\221\341\273\213nh h\306\260\341\273\233ng, hay t\341\273\245t mood, s\341\273\243 sai ho\341\272\267c qu\303\241 ch\303\272 tr\341\273\215ng chuy\303\252n m\303\264n m\303\240 qu\303\252n n\304\203ng l\341\273\261c th\341\272\245u hi\341\273\203u con ng\306\260\341\273\235i.\n- C\341\272\245u tr\303\272c:\n  1. C\303\242u hook \304\221\341\273\223ng c\341\272\243m ch\303\242n th\303\240nh v\341\273\233i ho\303\240n c\341\272\243nh trong clip.\n  2. Insight \304\221\341\272\257t gi\303\241 v\341\273\201 vi\341\273\207c hi\341\273\203u b\341\272\243n th\303\242n / r\303\250n luy\341\273\207n s\341\273\251c b\341\273\201n / n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201.\n  3. G\341\273\243i \303\275 nh\341\272\271 nh\303\240ng v\341\273\201 m\341\273\231t b\303\240i test/review nh\341\273\217 \304\221\303\241nh gi\303\241 1-1 mi\341\273\205n ph\303\255 gi\303\272p t\303\254m ra h\306\260\341\273\233ng \304\221i.\n  4. L\341\273\235i m\341\273\235i inbox nh\341\272\255n b\303\240i test free m\341\273\231t c\303\241ch khi\303\252m t\341\273\221n v\303\240 c\341\273\237i m\341\273\237.\n- Tham kh\341\272\243o gi\341\273\215ng \304\221i\341\273\207u chu\341\272\251n: \"M\303\254nh ngh\304\251 ai c\305\251ng n\303\252n cho b\341\272\243n th\303\242n c\306\241 h\341\273\231i \304\221\306\260\341\273\243c th\341\273\255... N\341\272\277u b\341\272\241n \304\221ang mu\341\273\221n hi\341\273\203u b\341\272\243n th\303\242n h\306\241n c\303\263 th\341\273\203 nh\341\272\257n m\303\254nh nh\303\251\" ho\341\272\267c \"G\341\273\255i c\303\241c b\341\272\241n \304\221ang \341\273\237 \304\221\341\273\231 tu\341\273\225i 20-39t... m\303\254nh c\303\263 1 b\303\240i test review nh\341\273\217 c\303\263 gi\341\272\243i \304\221\303\241p chi ti\341\272\277t 1-1...\"`,\n      },\n      order_2: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 2: COMMENT QUA POST FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG R\341\272\242I CH\306\257\306\240NG TR\303\214NH (CT). CH\341\273\210 \304\220\306\257\341\273\242C PH\303\211P \304\220\341\273\200 XU\341\272\244T WORKSHOP (WS).\n- Tone & Mood: Kh\303\241c v\341\273\233i TikTok/Threads, content Facebook KH\303\224NG mang t\303\255nh \304\221\341\273\223ng c\341\272\243m qu\303\241 \341\273\247y m\341\273\213 hay m\341\273\231t chi\341\273\201u. PH\341\272\242I C\303\223 S\341\273\260 KH\303\201CH QUAN, TRUNG L\341\272\254P, MANG T\303\215NH PH\303\202N T\303\215CH CHO C\341\272\242 \304\220\303\224I B\303\212N (v\303\255 d\341\273\245 g\303\263c nh\303\254n nh\303\242n vi\303\252n vs qu\341\272\243n l\303\275, \303\241p l\341\273\261c v\341\272\255n h\303\240nh vs nguy\341\273\207n v\341\273\215ng ph\303\241t tri\341\273\203n).\n- TUY\341\273\206T \304\220\341\273\220I KH\303\224NG D\303\231NG C\303\202U KH\341\272\262NG \304\220\341\273\212NH \303\201P \304\220\341\272\266T nh\306\260: \"Thay v\303\254 loay hoay... th\303\254 h\303\243y...\" (nghe nh\306\260 ra l\341\273\207nh) ho\341\272\267c \"Vi\341\273\207c b\341\272\241n c\341\272\243m th\341\272\245y v\303\264 d\341\273\245ng th\341\273\261c ch\341\272\245t l\303\240 do b\341\272\241n b\341\273\213...\" (nghe ti\303\252u c\341\273\261c, 1 chi\341\273\201u, ph\341\272\243n c\341\272\243m).\n- H\341\272\240 TH\341\272\244P B\341\272\242N TH\303\202N TR\306\257\341\273\232C NG\306\257\341\273\234I XEM, d\303\271ng c\341\272\245u tr\303\272c m\341\273\201m m\341\273\217ng: \"T\303\254nh tr\341\272\241ng n\303\240y kh\303\264ng ph\341\272\243i m\341\273\231t m\303\254nh b\341\272\241n... B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS n\303\240y \304\221\341\273\203...\"\n- Ph\303\242n t\303\255ch th\341\273\261c t\341\272\277 \304\221\341\273\235i s\341\273\221ng c\303\264ng s\341\273\237 (v\303\255 d\341\273\245: manager b\341\273\213 \304\221\303\250 l\306\260\306\241ng, kh\341\273\221i l\306\260\341\273\243ng vi\341\273\207c t\303\241i c\341\272\245u tr\303\272c, \304\221\303\240o t\341\272\241o newbie...).`,\n      },\n      order_3: {\n        platform: \'Facebook\',\n        allowedTypes: [\'ws\'], // STRICTLY WS ONLY!\n        rules: `ORDER 3: VI\341\272\276T B\303\200I FACEBOOK\n*** QUY T\341\272\256C S\341\273\220NG C\303\222N TR\303\212N FACEBOOK ***:\n- TUY\341\273\206T \304\220\341\273\220I CH\341\273\210 VI\341\272\276T V\341\273\200 WORKSHOP (WS), KH\303\224NG CH\341\272\240Y CH\306\257\306\240NG TR\303\214NH (CT).\n- Tone & Mood: Kh\303\241ch quan, trung l\341\272\255p, ph\303\242n t\303\255ch \304\221a chi\341\273\201u, khi\303\252m t\341\273\221n. C\303\263 \304\221\341\273\231 s\303\242u v\341\273\201 tr\341\272\243i nghi\341\273\207m th\341\273\261c t\341\272\277 c\303\264ng vi\341\273\207c.\n- C\341\272\245u tr\303\272c:\n  1. M\341\273\237 b\303\240i b\341\272\261ng m\341\273\231t hi\341\273\207n t\306\260\341\273\243ng/t\303\254nh hu\341\273\221ng c\303\264ng s\341\273\237 ho\341\272\267c th\341\273\261c t\341\272\277 ph\341\273\225 bi\341\272\277n (kh\303\264ng k\341\272\277t lu\341\272\255n v\341\273\231i v\303\240ng).\n  2. Ph\303\242n t\303\255ch nguy\303\252n nh\303\242n s\303\242u xa t\341\273\253 g\303\263c \304\221\341\273\231 \304\221\341\273\213nh v\341\273\213 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, n\304\203ng l\341\273\261c gi\341\272\243i quy\341\272\277t v\341\272\245n \304\221\341\273\201 ho\341\272\267c th\341\272\245u hi\341\273\203u b\341\272\243n th\303\242n.\n  3. \304\220\341\273\201 xu\341\272\245t khi\303\252m nh\306\260\341\273\235ng: \"B\341\272\241n c\303\263 th\341\273\203 th\341\273\255 tham gia WS [T\303\252n WS] \304\221\341\273\203 c\303\271ng nh\303\254n nh\341\272\255n l\341\272\241i...\"\n  4. N\341\272\277u c\303\263 y\303\252u c\341\272\247u g\341\272\257n link: ch\303\250n v\341\273\213 tr\303\255 link \304\221\304\203ng k\303\275 r\303\265 r\303\240ng \341\273\237 cu\341\273\221i b\303\240i ho\341\272\267c d\306\260\341\273\233i comment.`,\n      },\n      order_4: {\n        platform: \'Threads\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 4: COMMENT THREADS\n- M\341\273\245c ti\303\252u: Chuy\341\273\203n \304\221\341\273\225i th\303\240nh inbox th\303\264ng qua t\303\242m s\341\273\261 ch\303\242n th\303\240nh.\n- Tone & Mood: Gi\341\273\215ng \304\221i\341\273\207u ch\303\242n th\341\272\255t (authentic), th\341\273\247 th\341\273\211, s\303\242u l\341\272\257ng, ng\341\272\257t d\303\262ng t\341\273\261 nhi\303\252n, nh\306\260 m\341\273\231t ng\306\260\341\273\235i b\341\272\241n c\303\271ng trang l\341\273\251a \304\221ang tr\341\272\243i l\303\262ng.\n- C\341\272\245u tr\303\272c: 3-5 c\303\242u ng\341\272\257n g\341\273\215n, ch\341\272\241m v\303\240o c\341\272\243m gi\303\241c b\341\272\277 t\341\272\257c ho\341\272\267c tr\304\203n tr\341\273\237 c\341\273\247a b\303\240i vi\341\272\277t g\341\273\221c, g\341\273\243i m\341\273\237 v\341\273\201 m\341\273\231t g\303\263c nh\303\254n soi chi\341\272\277u b\341\272\243n th\303\242n v\303\240 m\341\273\235i inbox nh\341\272\255n template/b\303\240i test 1-1 mi\341\273\205n ph\303\255.`,\n      },\n      order_5: {\n        platform: \'Threads\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 5: VI\341\272\276T B\303\200I THREADS\n- \304\220\341\273\213nh d\341\272\241ng: Chu\341\273\227i c\303\241c \304\221o\341\272\241n ng\341\272\257n g\341\273\215n (1-2 c\303\242u m\341\273\227i \304\221o\341\272\241n), ng\341\272\257t d\303\262ng tho\303\241ng, d\341\273\205 \304\221\341\273\215c tr\303\252n mobile.\n- Tone & Mood: T\341\273\261 s\341\273\261, s\303\242u s\341\272\257c, chia s\341\272\273 b\303\240i h\341\273\215c th\341\272\255t t\341\273\253 b\341\272\243n th\303\242n, kh\303\264ng gi\341\272\243ng \304\221\341\272\241o hay d\341\272\241y \304\221\341\273\235i.\n- Hook m\341\273\237 \304\221\341\272\247u \304\221\303\241nh tr\303\272ng insight t\303\242m l\303\275 ng\306\260\341\273\235i tr\341\272\273 \304\221i l\303\240m.\n- \304\220o\341\272\241n k\341\272\277t m\341\273\237, m\341\273\235i m\341\273\215i ng\306\260\341\273\235i th\341\272\243o lu\341\272\255n ho\341\272\267c nh\341\272\257n tin ri\303\252ng \304\221\341\273\203 nh\341\272\255n b\341\273\231 c\303\242u h\341\273\217i/template soi chi\341\272\277u 1-1.`,\n      },\n      order_6: {\n        platform: \'LinkedIn\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 6: TI\341\272\276P C\341\272\254N QUA TIN NH\341\272\256N LINKEDIN (INMAIL/DM)\n- Tone & Mood: Chuy\303\252n nghi\341\273\207p, l\341\273\213ch thi\341\273\207p, \341\272\245m \303\241p, \304\221\341\273\213nh v\341\273\213 ng\306\260\341\273\235i g\341\273\255i l\303\240 HRBP ho\341\272\267c c\341\273\231ng t\303\241c vi\303\252n L&D y\303\252u th\303\255ch nghi\303\252n c\341\273\251u ph\303\241t tri\341\273\203n con ng\306\260\341\273\235i.\n- C\304\203n c\341\273\251 khoa h\341\273\215c: Nh\341\272\257c \304\221\341\272\277n c\303\264ng c\341\273\245 khoa h\341\273\215c (MBTI, test t\303\255nh c\303\241ch, c\303\242n b\341\272\261ng n\304\203ng l\306\260\341\273\243ng work-life, \304\221\341\273\213nh h\306\260\341\273\233ng c\303\241 nh\303\242n h\303\263a).\n- M\341\272\253u chu\341\272\251n: \"Xin ch\303\240o b\341\272\241n, m\303\254nh l\303\240 [T\303\252n], hi\341\273\207n \304\221ang l\303\240m HRBP... D\341\273\261 \303\241n phi l\341\273\243i nhu\341\272\255n/t\303\242m huy\341\272\277t d\303\240nh cho sinh vi\303\252n v\303\240 ng\306\260\341\273\235i \304\221i l\303\240m, mi\341\273\205n ph\303\255 tham v\341\272\245n 1:1...\"\n- Lu\303\264n k\341\272\277t th\303\272c b\341\272\261ng l\341\273\235i ch\303\272c t\303\255ch c\341\273\261c, l\341\273\213ch s\341\273\261, kh\303\264ng \303\251p bu\341\273\231c.`,\n      },\n      order_7: {\n        platform: \'Email\',\n        allowedTypes: [\'ws\', \'ct\'],\n        rules: `ORDER 7: VI\341\272\276T CONTENT EMAIL\n- C\341\272\245u tr\303\272c:\n  1. Ti\303\252u \304\221\341\273\201 (Subject Line): 3 g\341\273\243i \303\275 ti\303\252u \304\221\341\273\201 t\303\262 m\303\262, c\303\241 nh\303\242n h\303\263a, t\341\273\267 l\341\273\207 m\341\273\237 cao.\n  2. Hook m\341\273\237 \304\221\341\272\247u: L\341\273\235i ch\303\240o \341\272\245m \303\241p, k\341\272\277t n\341\273\221i b\341\272\261ng m\341\273\231t c\303\242u chuy\341\273\207n ho\341\272\267c tr\304\203n tr\341\273\237 th\341\273\261c t\341\272\277.\n  3. Th\303\242n b\303\240i: Ph\303\242n t\303\255ch insight, \304\221\306\260a ra 2-3 c\303\242u h\341\273\217i t\341\273\261 v\341\272\245n s\303\242u s\341\272\257c.\n  4. Gi\341\273\233i thi\341\273\207u Workshop/Ch\306\260\306\241ng tr\303\254nh nh\306\260 m\341\273\231t gi\341\272\243i ph\303\241p \304\221\341\273\223ng h\303\240nh soi g\306\260\306\241ng v\303\240 b\341\273\251t ph\303\241.\n  5. Call to action (CTA): R\303\265 r\303\240ng, th\303\272c \304\221\341\272\251y \304\221\304\203ng k\303\275 form ho\341\272\267c ph\341\272\243n h\341\273\223i email.`,\n      },\n    };\n\n    const currentOrder = orderRules[orderType] || orderRules.order_1;\n\n    // Filter available programs based on platform restrictions\n    let availablePrograms = (programs || []).filter((p: any) => p.isActive !== false);\n    if (currentOrder.allowedTypes.length === 1 && currentOrder.allowedTypes[0] === \'ws\') {\n      availablePrograms = availablePrograms.filter((p: any) => p.type === \'ws\');\n    }\n\n    const systemPrompt = `B\341\272\241n l\303\240 m\341\273\231t Content Master 10 n\304\203m kinh nghi\341\273\207m v\303\240 Social Media Manager xu\341\272\245t s\341\272\257c, qu\341\272\243n l\303\275 4 n\341\273\201n t\341\272\243ng ch\303\255nh: TikTok, Facebook, Threads, LinkedIn v\303\240 Email.\nM\341\273\245c ti\303\252u t\341\273\221i th\306\260\341\273\243ng c\341\273\247a b\341\272\241n l\303\240: T\341\272\240O RA CONTENT CHUY\341\273\202N \304\220\341\273\224I CAO T\341\273\252 COMMENT/B\303\200I \304\220\304\202NG TH\303\200NH INBOX (1-1 DM / CHAT LEAD), sau \304\221\303\263 cung c\341\272\245p k\341\273\213ch b\341\272\243n d\341\272\253n d\341\272\257t tr\303\262 chuy\341\273\207n 1-1 \304\221\341\273\203 chuy\341\273\203n \304\221\341\273\225i sang \304\221\304\203ng k\303\275 Workshop/Ch\306\260\306\241ng tr\303\254nh.\n\nQUY T\341\272\256C C\341\273\220T L\303\225I B\341\272\256T BU\341\273\230C:\n1. KH\303\224NG vi\341\272\277t theo h\306\260\341\273\233ng h\306\260\341\273\233ng nghi\341\273\207p ki\341\272\277m ti\341\273\201n hay k\341\273\271 n\304\203ng b\303\252n ngo\303\240i (nh\306\260 thuy\341\272\277t tr\303\254nh, ki\341\272\277m ti\341\273\201n nhanh...). Ng\306\260\341\273\235i tham gia l\303\240 ng\306\260\341\273\235i mu\341\273\221n HI\341\273\202U M\303\214NH, T\303\214M \304\220I\341\273\202M M\341\272\240NH TH\341\273\260C S\341\273\260, R\303\210N S\341\273\250C B\341\273\200N V\303\200 PH\303\201T TRI\341\273\202N N\341\273\230I T\341\273\260.\n2. KH\303\224NG m\341\273\235i ng\306\260\341\273\235i \304\221\341\273\215c l\303\240m kh\303\241ch m\341\273\235i/di\341\273\205n gi\341\272\243 hay \304\221\303\263ng g\303\263p g\303\263c nh\303\254n \304\221\341\273\203 d\341\272\241y ng\306\260\341\273\235i kh\303\241c.\n3. KH\303\224NG \303\241p \304\221\341\272\267t khu\303\264n m\341\272\253u cho ri\303\252ng ng\303\240nh n\303\240o (IT, Tech...). Template ch\303\255nh l\303\240 form/test c\341\273\247a d\341\273\261 \303\241n.\n4. TUY\341\273\206T \304\220\341\273\220I CH\341\272\244P H\303\200NH NGUY\303\212N T\341\272\256C RI\303\212NG C\341\273\246A T\341\273\252NG N\341\273\200N T\341\272\242NG THEO ORDER:\n${currentOrder.rules}\n\nDANH S\303\201CH WORKSHOP/CH\306\257\306\240NG TR\303\214NH KH\341\272\242 D\341\273\244NG:\n${JSON.stringify(availablePrograms, null, 2)}\n\nH\303\243y ph\303\242n t\303\255ch ng\341\273\257 c\341\272\243nh ng\306\260\341\273\235i d\303\271ng \304\221\306\260a v\303\240o (n\341\273\231i dung clip, post, ho\341\272\267c screenshot), ch\341\273\215n Workshop/Ch\306\260\306\241ng tr\303\254nh ph\303\271 h\341\273\243p nh\341\272\245t (n\341\272\277u ng\306\260\341\273\235i d\303\271ng ch\306\260a ch\341\273\211 \304\221\341\273\213nh), v\303\240 t\341\272\241o ra s\341\272\243n ph\341\272\251m ho\303\240n ch\341\273\211nh theo c\341\272\245u tr\303\272c JSON.`;\n\n    const userPrompt = `Y\303\212U C\341\272\246U TH\341\273\260C HI\341\273\206N:\n- Lo\341\272\241i Order: ${orderType} (${currentOrder.platform})\n- Ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng / Clip / Tr\304\203n tr\341\273\237:\n\"${context || \'Ng\306\260\341\273\235i tr\341\272\273 loay hoay v\341\273\201 b\341\272\243n s\341\272\257c c\303\241 nh\303\242n, t\341\273\261 ti so s\303\241nh v\303\240 ch\306\260a d\303\241m kh\341\272\263ng \304\221\341\273\213nh th\341\272\277 m\341\272\241nh\'}\"\n${selectedProgramId ? `- Workshop/Ch\306\260\306\241ng tr\303\254nh \304\221\306\260\341\273\243c ch\341\273\211 \304\221\341\273\213nh ID: ${selectedProgramId}` : \'- H\303\243y t\341\273\261 \304\221\341\273\231ng ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t t\341\273\253 danh s\303\241ch.\'}\n- T\303\271y ch\341\273\215n:\n  * G\341\272\257n link \304\221\304\203ng k\303\275: ${options.includeLink ? \'C\303\263 g\341\272\257n link\' : \'Kh\303\264ng g\341\272\257n link tr\341\273\261c ti\341\272\277p (k\303\252u g\341\273\215i inbox)\'}\n  * Gi\341\273\233i thi\341\273\207u ch\306\260\306\241ng tr\303\254nh/WS: ${options.introduceProgram !== false ? \'C\303\263\' : \'Ch\341\273\211 nh\341\272\257c nh\341\272\271\'}\n  * T\303\271y ch\341\273\211nh tone: ${options.tone || \'T\341\273\261 \304\221\341\273\231ng theo chu\341\272\251n n\341\273\201n t\341\272\243ng\'}\n  * \304\220\341\273\221i t\306\260\341\273\243ng nh\341\272\257m t\341\273\233i: ${options.customAudience || \'Theo chu\341\272\251n d\341\273\261 \303\241n\'}\n\nH\303\243y xu\341\272\245t k\341\272\277t qu\341\272\243 JSON:\n{\n  \"selectedProgramId\": \"id c\341\273\247a WS/CT \304\221\306\260\341\273\243c ch\341\273\215n\",\n  \"selectedProgramTitle\": \"T\303\252n WS/CT\",\n  \"selectedProgramType\": \"ws\" | \"ct\",\n  \"rationale\": \"L\303\275 do v\303\254 sao ch\341\273\215n WS/CT n\303\240y v\303\240 ph\303\242n t\303\255ch insight kh\303\241ch h\303\240ng t\341\273\253 context\",\n  \"platformNotes\": \"L\306\260u \303\275 \304\221\341\272\267c bi\341\273\207t v\341\273\201 tone & mood theo quy t\341\272\257c c\341\273\247a n\341\273\201n t\341\272\243ng\",\n  \"primaryContent\": \"N\341\273\231i dung ch\303\255nh ho\303\240n ch\341\273\211nh nh\341\272\245t\",\n  \"variations\": [\n    \"Variation 1: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 1 (t\341\272\255p trung v\303\240o c\341\272\243m x\303\272c / c\303\242u chuy\341\273\207n c\303\241 nh\303\242n)\",\n    \"Variation 2: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 2 (t\341\272\255p trung v\303\240o ph\303\242n t\303\255ch kh\303\241ch quan / g\303\263c nh\303\254n ng\306\260\341\273\235i \304\221i l\303\240m)\",\n    \"Variation 3: H\306\260\341\273\233ng ti\341\272\277p c\341\272\255n 3 (t\341\272\255p trung v\303\240o b\303\240i test \304\221\303\241nh gi\303\241 1-1 / khoa h\341\273\215c t\303\255nh c\303\241ch)\"\n  ],\n  \"dmFollowUpScript\": {\n    \"step1_empathy\": \"L\341\273\235i m\341\273\237 \304\221\341\272\247u trong DM khi c\303\263 ng\306\260\341\273\235i b\303\254nh lu\341\272\255n/inbox h\341\273\217i: \304\220\341\273\223ng c\341\272\243m, ghi nh\341\272\255n c\341\272\243m x\303\272c v\303\240 t\341\272\241o kh\303\264ng gian an to\303\240n\",\n    \"step2_qualifyQuestion\": \"C\303\242u h\341\273\217i \304\221\303\240o s\303\242u 1-1: 1-2 c\303\242u h\341\273\217i kh\303\251o l\303\251o \304\221\341\273\203 hi\341\273\203u r\303\265 t\303\254nh tr\341\272\241ng hi\341\273\207n t\341\272\241i c\341\273\247a b\341\272\241n \341\272\245y (v\303\255 d\341\273\245: \'Hi\341\273\207n t\341\272\241i b\341\272\241n \304\221ang c\341\272\243m th\341\272\245y ph\303\242n v\303\242n \341\273\237 \304\221i\341\273\203m n\303\240o nh\341\272\245t...\')\",\n    \"step3_inviteLink\": \"L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / link tham v\341\272\245n 1-1: Nh\341\272\271 nh\303\240ng, mi\341\273\205n ph\303\255 v\303\240 cam k\341\272\277t \304\221\341\273\223ng h\303\240nh\"\n  }\n}`;\n\n    const parts: any[] = [];\n    if (screenshotBase64) {\n      const mimeType = screenshotBase64.startsWith(\'data:image/png\')\n        ? \'image/png\'\n        : screenshotBase64.startsWith(\'data:image/webp\')\n        ? \'image/webp\'\n        : \'image/jpeg\';\n      const cleanBase64 = screenshotBase64.replace(/^data:image\\/[a-z]+;base64,/, \'\');\n      parts.push({\n        inlineData: {\n          mimeType,\n          data: cleanBase64,\n        },\n      });\n    }\n    parts.push({ text: userPrompt });\n\n    const response = await generateContentWithRetry({\n      contents: { parts },\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            selectedProgramId: { type: Type.STRING },\n            selectedProgramTitle: { type: Type.STRING },\n            selectedProgramType: { type: Type.STRING, enum: [\'ws\', \'ct\'] },\n            rationale: { type: Type.STRING },\n            platformNotes: { type: Type.STRING },\n            primaryContent: { type: Type.STRING },\n            variations: {\n              type: Type.ARRAY,\n              items: { type: Type.STRING },\n            },\n            dmFollowUpScript: {\n              type: Type.OBJECT,\n              properties: {\n                step1_empathy: { type: Type.STRING },\n                step2_qualifyQuestion: { type: Type.STRING },\n                step3_inviteLink: { type: Type.STRING },\n              },\n              required: [\'step1_empathy\', \'step2_qualifyQuestion\', \'step3_inviteLink\'],\n            },\n          },\n          required: [\n            \'selectedProgramId\',\n            \'selectedProgramTitle\',\n            \'selectedProgramType\',\n            \'rationale\',\n            \'platformNotes\',\n            \'primaryContent\',\n            \'variations\',\n            \'dmFollowUpScript\',\n          ],\n        },\n      },\n    });\n\n    const parsed = JSON.parse(response.text || \'{}\');\n\n    res.json({\n      success: true,\n      data: parsed,\n    });\n  } catch (error: any) {\n    console.error(\'Error generating order content:\', error);\n    res.status(500).json({ error: error.message || \'L\341\273\227i khi t\341\272\241o n\341\273\231i dung Order.\' });\n  }\n});"
      }
      num_matches: 1
    }
  }
}
