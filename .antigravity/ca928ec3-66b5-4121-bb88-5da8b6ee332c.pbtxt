        }
        lines {
          text: "    keyInsight: \'Nh\341\272\245n m\341\272\241nh vi\341\273\207c d\303\241m b\306\260\341\273\233c \304\221i \304\221\341\272\277n t\341\273\253 s\341\273\261 hi\341\273\203u m\303\254nh, kh\303\264ng ph\341\272\243i do thi\341\272\277u n\304\203ng l\341\273\261c.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `M\303\254nh ngh\304\251 ai c\305\251ng n\303\252n cho b\341\272\243n th\303\242n c\306\241 h\341\273\231i \304\221\306\260\341\273\243c th\341\273\255, \304\221\306\260\341\273\243c sai v\303\240 \304\221\306\260\341\273\243c h\341\273\215c. Nhi\341\273\201u khi m\303\254nh ch\306\260a d\303\241m b\306\260\341\273\233c \304\221i kh\303\264ng ph\341\272\243i v\303\254 kh\303\264ng c\303\263 kh\341\272\243 n\304\203ng, m\303\240 v\303\254 ch\306\260a th\341\272\255t s\341\273\261 hi\341\273\203u m\303\254nh l\303\240 ai v\303\240 ph\303\271 h\341\273\243p v\341\273\233i \304\221i\341\273\201u g\303\254. \304\220\341\273\253ng ng\341\272\241i tr\341\272\243i nghi\341\273\207m nh\341\273\257ng \304\221i\341\273\201u m\341\273\233i, b\341\273\237i ch\303\255nh nh\341\273\257ng tr\341\272\243i nghi\341\273\207m \304\221\303\263 s\341\272\275 gi\303\272p m\303\254nh nh\303\254n r\303\265 gi\303\241 tr\341\273\213, \304\221i\341\273\203m m\341\272\241nh v\303\240 c\341\272\243 nh\341\273\257ng gi\341\273\233i h\341\272\241n c\341\272\247n v\306\260\341\273\243t qua c\341\273\247a b\341\272\243n th\303\242n. M\303\254nh c\303\263 bi\341\272\277t m\341\273\231t d\341\273\261 \303\241n kh\303\241 hay gi\303\272p x\303\241c \304\221\341\273\213nh hi\341\273\207n t\341\272\241i b\341\272\241n \304\221ang \341\273\237 tr\341\272\241ng th\303\241i n\303\240o, \304\221i\341\273\201u g\303\254 \304\221ang c\341\272\243n tr\341\273\237 s\341\273\261 ph\303\241t tri\341\273\203n v\303\240 \304\221\303\242u l\303\240 h\306\260\341\273\233ng \304\221i ph\303\271 h\341\273\243p h\306\241n trong th\341\273\235i gian t\341\273\233i. N\341\272\277u b\341\272\241n \304\221ang mu\341\273\221n hi\341\273\203u b\341\272\243n th\303\242n h\306\241n v\303\240 ph\303\241t tri\341\273\203n \304\221\303\272ng h\306\260\341\273\233ng, c\303\263 th\341\273\203 nh\341\272\257n m\303\254nh nh\303\251`"
