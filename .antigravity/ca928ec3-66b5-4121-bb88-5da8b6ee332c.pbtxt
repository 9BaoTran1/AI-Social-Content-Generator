  file_change {
    absolute_path_uri: "file:///src/components/GeneratorWorkbench.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { ProgramItem, OrderType, OrderMeta, GeneratedContent } from \'../types\';\nimport { ORDERS_METADATA } from \'../data/defaultPrograms\';\nimport {\n  Sparkles,\n  Copy,\n  Check,\n  Upload,\n  Image as ImageIcon,\n  AlertTriangle,\n  RefreshCw,\n  FileText,\n  Layers,\n  ChevronDown,\n  UserCheck,\n  Zap,\n  Sliders,\n  Eye,\n  LayoutGrid,\n  Smartphone,\n  Share2,\n  Heart,\n  MessageCircle,\n  Bookmark,\n  Send,\n  Wand2,\n  ArrowRight,\n  ExternalLink,\n  ShieldCheck,\n  Smile\n} from \'lucide-react\';\nimport { saveHistoryItem } from \'../lib/storage\';\n\ninterface GeneratorWorkbenchProps {\n  programs: ProgramItem[];\n  initialOrderType?: OrderType;\n  onNavigateToPrograms: () => void;\n}\n\n// Preset Quick Scenarios for 1-Click Inspiration\nconst QUICK_SCENARIOS = [\n  {\n    title: \'\360\237\216\254 Loay hoay tu\341\273\225i 25\',\n    tag: \'TikTok / Threads\',\n    orderType: \'order_1\' as OrderType,\n    text: \'Clip n\303\263i v\341\273\201 c\341\272\243m gi\303\241c kh\341\273\247ng ho\341\272\243ng tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng th\341\272\245y t\341\273\261 tin v\341\273\201 chuy\303\252n m\303\264n, li\303\252n t\341\273\245c so s\303\241nh b\341\272\243n th\303\242n v\341\273\233i b\341\272\241n b\303\250 th\303\240nh c\303\264ng mua nh\303\240 mua xe tr\303\252n m\341\272\241ng x\303\243 h\341\273\231i.\',\n  },\n  {\n    title: \'\360\237\222\274 Xung \304\221\341\273\231t S\341\272\277p vs Nh\303\242n vi\303\252n\',\n    tag: \'Facebook / LinkedIn\',\n    orderType: \'order_2\' as OrderType,\n    text: \'B\303\240i vi\341\272\277t th\341\272\243o lu\341\272\255n v\341\273\201 t\303\254nh hu\341\273\221ng qu\341\272\243n l\303\275 giao vi\341\273\207c nh\306\260ng nh\303\242n s\341\273\261 Gen Z l\303\240m \304\221\341\273\221i ph\303\263, trong khi nh\303\242n s\341\273\261 c\341\272\243m th\341\272\245y s\341\272\277p micromanage v\303\240 kh\303\264ng t\341\272\241o kh\303\264ng gian ph\303\241t tri\341\273\203n.\',\n  },\n  {\n    title: \'\342\232\241 Ki\341\273\207t s\341\273\251c & M\341\272\245t ph\306\260\306\241ng h\306\260\341\273\233ng\',\n    tag: \'Threads / TikTok\',\n    orderType: \'order_4\' as OrderType,\n    text: \'T\303\242m s\341\273\261 c\341\273\247a m\341\273\231t b\341\272\241n \304\221i l\303\240m 4 n\304\203m, b\341\273\201 ngo\303\240i \341\273\225n \304\221\341\273\213nh nh\306\260ng b\303\252n trong r\341\273\227ng tu\341\272\277ch, m\341\273\227i s\303\241ng th\341\273\251c d\341\272\255y \304\221\341\273\201u m\341\273\207t m\341\273\217i v\303\240 kh\303\264ng bi\341\272\277t m\341\273\245c ti\303\252u ngh\341\273\201 nghi\341\273\207p ti\341\272\277p theo l\303\240 g\303\254.\',\n  },\n  {\n    title: \'\360\237\223\210 Qu\341\272\243n l\303\275 & L&D b\341\272\277 t\341\272\257c\',\n    tag: \'LinkedIn / Email\',\n    orderType: \'order_6\' as OrderType,\n    text: \'Post ph\303\242n t\303\255ch v\341\273\201 vi\341\273\207c \304\221\303\240o t\341\272\241o nh\303\242n s\341\273\261 n\341\273\231i b\341\273\231 kh\303\264ng hi\341\273\207u qu\341\272\243, nh\303\242n vi\303\252n h\341\273\215c xong kh\303\264ng \303\241p d\341\273\245ng \304\221\306\260\341\273\243c v\303\240o th\341\273\261c t\341\272\277 khi\341\272\277n ban l\303\243nh \304\221\341\272\241o ng\341\272\247n ng\341\272\241i \304\221\341\272\247u t\306\260 ng\303\242n s\303\241ch \304\221\303\240o t\341\272\241o.\',\n  },\n];\n\nexport const GeneratorWorkbench: React.FC<GeneratorWorkbenchProps> = ({\n  programs,\n  initialOrderType = \'order_1\',\n  onNavigateToPrograms,\n}) => {\n  const [selectedOrderType, setSelectedOrderType] = useState<OrderType>(initialOrderType);\n  const [context, setContext] = useState<string>(\'\');\n  const [selectedProgramId, setSelectedProgramId] = useState<string>(\'auto\');\n  const [includeLink, setIncludeLink] = useState<boolean>(false);\n  const [introduceProgram, setIntroduceProgram] = useState<boolean>(true);\n  const [customAudience, setCustomAudience] = useState<string>(\'\');\n  const [toneStyle, setToneStyle] = useState<string>(\'auto\');\n  const [lengthPreference, setLengthPreference] = useState<\'short\' | \'medium\' | \'deep\'>(\'medium\');\n\n  // Preview Mode: \'cards\' (Grid) vs \'mockup\' (Real App Simulation)\n  const [previewMode, setPreviewMode] = useState<\'cards\' | \'mockup\'>(\'cards\');\n  const [activeVariationIndex, setActiveVariationIndex] = useState<number>(0);\n\n  // Image Upload state\n  const [screenshotBase64, setScreenshotBase64] = useState<string | null>(null);\n  const [imagePreview, setImagePreview] = useState<string | null>(null);\n\n  // Generation state\n  const [isLoading, setIsLoading] = useState<boolean>(false);\n  const [isEnhancingPrompt, setIsEnhancingPrompt] = useState<boolean>(false);\n  const [generatedResult, setGeneratedResult] = useState<GeneratedContent | null>(null);\n  const [error, setError] = useState<string | null>(null);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 2500);\n  };\n\n  const currentOrderMeta: OrderMeta =\n    ORDERS_METADATA.find((o) => o.id === selectedOrderType) || ORDERS_METADATA[0];\n\n  const isFacebook = currentOrderMeta.platform === \'Facebook\';\n\n  // Filter programs based on order restrictions\n  const filteredPrograms = programs.filter((p) => {\n    if (!p.isActive) return false;\n    if (isFacebook) {\n      return p.type === \'ws\'; // Strictly WS only for FB!\n    }\n    return true;\n  });\n\n  // Reset selected program if switching to FB and a CT was previously selected\n  useEffect(() => {\n    if (isFacebook && selectedProgramId !== \'auto\') {\n      const selected = programs.find((p) => p.id === selectedProgramId);\n      if (selected && selected.type === \'ct\') {\n        setSelectedProgramId(\'auto\');\n      }\n    }\n  }, [selectedOrderType, isFacebook, selectedProgramId, programs]);\n\n  const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      if (file.size > 5 * 1024 * 1024) {\n        setError(\'K\303\255ch th\306\260\341\273\233c \341\272\243nh qu\303\241 l\341\273\233n. Vui l\303\262ng ch\341\273\215n \341\272\243nh d\306\260\341\273\233i 5MB.\');\n        return;\n      }\n      const reader = new FileReader();\n      reader.onloadend = () => {\n        const result = reader.result as string;\n        setScreenshotBase64(result);\n        setImagePreview(result);\n        showToast(\'\304\220\303\243 n\341\272\241p \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh th\303\240nh c\303\264ng!\');\n      };\n      reader.readAsDataURL(file);\n    }\n  };\n\n  const removeImage = () => {\n    setScreenshotBase64(null);\n    setImagePreview(null);\n  };\n\n  // Smart Context Enhancer\n  const handleEnhanceContext = () => {\n    if (!context.trim()) {\n      showToast(\'H\303\243y nh\341\272\255p \303\275 t\306\260\341\273\237ng t\303\263m t\341\272\257t tr\306\260\341\273\233c khi t\341\273\221i \306\260u\');\n      return;\n    }\n    setIsEnhancingPrompt(true);\n    setTimeout(() => {\n      setContext((prev) => {\n        const trimmed = prev.trim();\n        return `${trimmed}\\n\\n[Chi ti\341\272\277t b\341\273\225 sung cho AI]: T\341\272\255p trung v\303\240o c\341\272\243m gi\303\241c b\341\272\277 t\341\272\257c, thi\341\272\277u t\341\273\261 tin c\341\273\247a ng\306\260\341\273\235i xem. Mu\341\273\221n t\303\254m gi\341\272\243i ph\303\241p \304\221\341\273\213nh h\306\260\341\273\233ng th\341\273\261c t\341\272\277, kh\303\264ng l\303\275 thuy\341\272\277t s\303\241o r\341\273\227ng. Ph\303\271 h\341\273\243p d\341\272\253n d\341\272\257t \304\221\341\272\277n b\303\240i test/workshop \304\221\341\273\213nh v\341\273\213 b\341\272\243n th\303\242n.`;\n      });\n      setIsEnhancingPrompt(false);\n      showToast(\'\304\220\303\243 t\341\273\221i \306\260u h\303\263a ng\341\273\257 c\341\272\243nh \304\221\341\273\201 b\303\240i!\');\n    }, 600);\n  };\n\n  const handleSelectScenario = (sc: typeof QUICK_SCENARIOS[0]) => {\n    setSelectedOrderType(sc.orderType);\n    setContext(sc.text);\n    setError(null);\n    showToast(`\304\220\303\243 t\341\272\243i k\341\273\213ch b\341\272\243n m\341\272\253u: ${sc.title}`);\n  };\n\n  const handleGenerate = async () => {\n    if (!context.trim() && !screenshotBase64) {\n      setError(\'Vui l\303\262ng nh\341\272\255p m\303\264 t\341\272\243 ng\341\273\257 c\341\272\243nh clip/post ho\341\272\267c t\341\272\243i l\303\252n \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh.\');\n      return;\n    }\n\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const response = await fetch(\'/api/generate-order\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          orderType: selectedOrderType,\n          context: context.trim(),\n          screenshotBase64,\n          selectedProgramId: selectedProgramId === \'auto\' ? undefined : selectedProgramId,\n          programs: filteredPrograms,\n          options: {\n            includeLink,\n            introduceProgram,\n            customAudience: customAudience.trim() || undefined,\n            tone: toneStyle === \'auto\' ? undefined : toneStyle,\n            lengthPreference,\n          },\n        }),\n      });\n\n      const data = await response.json();\n      if (!response.ok || !data.success) {\n        throw new Error(data.error || \'Kh\303\264ng th\341\273\203 t\341\272\241o n\341\273\231i dung. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n      }\n\n      const result: GeneratedContent = {\n        id: `gen-${Date.now()}`,\n        orderId: selectedOrderType,\n        orderTitle: currentOrderMeta.title,\n        platform: currentOrderMeta.platform,\n        programId: data.data.selectedProgramId,\n        programTitle: data.data.selectedProgramTitle,\n        programType: data.data.selectedProgramType,\n        primaryContent: data.data.primaryContent,\n        variations: data.data.variations || [],\n        dmFollowUpScript: data.data.dmFollowUpScript,\n        rationale: data.data.rationale,\n        platformNotes: data.data.platformNotes,\n        createdAt: new Date().toISOString(),\n      };\n\n      setGeneratedResult(result);\n      setActiveVariationIndex(0);\n      saveHistoryItem(result);\n      showToast(\'\342\234\250 \304\220\303\243 ho\303\240n th\303\240nh 3 ph\306\260\306\241ng \303\241n content & k\341\273\213ch b\341\272\243n DM!\');\n    } catch (err: any) {\n      setError(err.message || \'L\341\273\227i x\341\273\255 l\303\275. Vui l\303\262ng th\341\273\255 l\341\272\241i.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const copyToClipboard = (text: string, label: string) => {\n    navigator.clipboard.writeText(text);\n    showToast(`\342\234\223 \304\220\303\243 sao ch\303\251p ${label}!`);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Floating Toast Notification */}\n      {toastMessage && (\n        <div className=\"fixed bottom-6 right-6 z-50 bg-indigo-600 text-white px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 text-xs font-semibold animate-bounce\">\n          <Sparkles className=\"w-4 h-4 text-amber-300\" />\n          <span>{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Header / Studio Banner */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900/90 border border-slate-800 p-5 rounded-2xl shadow-sm\">\n        <div>\n          <div className=\"flex items-center space-x-2\">\n            <span className=\"px-2.5 py-0.5 text-xs font-bold uppercase rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n              Studio S\341\272\243n Xu\341\272\245t Content\n            </span>\n            <h2 className=\"text-lg font-bold text-white tracking-tight\">\n              Order {currentOrderMeta.orderNumber}: {currentOrderMeta.title}\n            </h2>\n          </div>\n          <p className=\"text-slate-400 text-xs mt-1\">\n            S\341\272\243n xu\341\272\245t 3 ph\306\260\306\241ng \303\241n comment/b\303\240i vi\341\272\277t chu\341\272\251n n\341\273\201n t\341\272\243ng {currentOrderMeta.platform} v\303\240 b\341\273\231 k\341\273\213ch b\341\272\243n chat 1-1 chuy\341\273\203n \304\221\341\273\225i inbox.\n          </p>\n        </div>\n\n        {/* Quick Order Selector Pills */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar\">\n          {ORDERS_METADATA.map((order) => (\n            <button\n              key={order.id}\n              onClick={() => {\n                setSelectedOrderType(order.id);\n                setError(null);\n              }}\n              className={`px-3 py-1.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all flex items-center gap-1.5 ${\n                selectedOrderType === order.id\n                  ? \'bg-indigo-600 text-white shadow-md shadow-indigo-600/30 ring-1 ring-indigo-400/50\'\n                  : \'bg-slate-950/70 text-slate-300 hover:bg-slate-800 border border-slate-800\'\n              }`}\n            >\n              <span>Order {order.orderNumber}</span>\n              <span className=\"text-[10px] opacity-70\">({order.platform})</span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* 1-Click Inspiration Quick Presets */}\n      <div className=\"bg-slate-900/60 border border-slate-800/80 rounded-2xl p-4\">\n        <div className=\"flex items-center justify-between mb-2.5\">\n          <span className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n            <Zap className=\"w-3.5 h-3.5 text-amber-400\" />\n            K\341\273\213ch b\341\272\243n m\341\272\253u nhanh (1-Click Presets)\n          </span>\n          <span className=\"text-[11px] text-slate-500\">B\341\272\245m \304\221\341\273\203 n\341\272\241p nhanh ng\341\273\257 c\341\272\243nh th\341\273\255 nghi\341\273\207m</span>\n        </div>\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2\">\n          {QUICK_SCENARIOS.map((sc, i) => (\n            <button\n              key={i}\n              onClick={() => handleSelectScenario(sc)}\n              className=\"text-left p-2.5 rounded-xl bg-slate-950/80 hover:bg-slate-800/90 border border-slate-800 hover:border-indigo-500/40 transition-all group\"\n            >\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"text-xs font-semibold text-slate-200 group-hover:text-indigo-300\">\n                  {sc.title}\n                </span>\n                <span className=\"text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400\">\n                  {sc.tag}\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 line-clamp-1 group-hover:text-slate-400\">\n                {sc.text}\n              </p>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Main 2-Column Layout */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column: Input Form & Controls (5 Cols) */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 space-y-4 shadow-sm\">\n            {/* Active Order Banner */}\n            <div className=\"p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-indigo-300 uppercase\">\n                  Order #{currentOrderMeta.orderNumber}: {currentOrderMeta.title}\n                </span>\n                <span className=\"text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-800 text-slate-300\">\n                  {currentOrderMeta.platform}\n                </span>\n              </div>\n              <p className=\"text-slate-400 text-xs leading-relaxed\">\n                {currentOrderMeta.description}\n              </p>\n\n              {/* Strict Rule Notice if Facebook */}\n              {isFacebook && (\n                <div className=\"mt-2 p-2.5 rounded-lg bg-blue-950/50 border border-blue-800/60 text-[11px] text-blue-200 flex items-start gap-1.5\">\n                  <ShieldCheck className=\"w-4 h-4 text-blue-400 flex-shrink-0 mt-0.5\" />\n                  <div>\n                    <strong className=\"text-blue-300 block font-semibold\">Quy t\341\272\257c Facebook:</strong>\n                    Ch\341\273\211 ch\341\272\241y Workshop (WS), tuy\341\273\207t \304\221\341\273\221i kh\303\264ng ch\341\272\241y CT. Tone trung l\341\272\255p, ph\303\242n t\303\255ch \304\221a chi\341\273\201u cho c\341\272\243 2 b\303\252n.\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Target Workshop / Program Selector */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n                  <Layers className=\"w-3.5 h-3.5 text-indigo-400\" />\n                  Workshop / Ch\306\260\306\241ng tr\303\254nh m\341\273\245c ti\303\252u\n                </label>\n                <button\n                  type=\"button\"\n                  onClick={onNavigateToPrograms}\n                  className=\"text-[11px] text-indigo-400 hover:text-indigo-300 underline flex items-center gap-1\"\n                >\n                  <span>Kho ({programs.length})</span>\n                  <ExternalLink className=\"w-3 h-3\" />\n                </button>\n              </div>\n\n              <div className=\"relative\">\n                <select\n                  value={selectedProgramId}\n                  onChange={(e) => setSelectedProgramId(e.target.value)}\n                  className=\"w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 appearance-none cursor-pointer\"\n                >\n                  <option value=\"auto\">\342\234\250 \304\220\341\273\203 AI t\341\273\261 \304\221\341\273\231ng ph\303\242n t\303\255ch & ch\341\273\215n WS/CT ph\303\271 h\341\273\243p nh\341\272\245t</option>\n                  <optgroup label={isFacebook ? \'Workshops Kh\341\272\243 D\341\273\245ng (Facebook ch\341\273\211 WS)\' : \'Workshops & Ch\306\260\306\241ng Tr\303\254nh\'}>\n                    {filteredPrograms.map((p) => (\n                      <option key={p.id} value={p.id}>\n                        [{p.type === \'ws\' ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}] {p.title}\n                      </option>\n                    ))}\n                  </optgroup>\n                </select>\n                <ChevronDown className=\"w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none\" />\n              </div>\n            </div>\n\n            {/* Input Context / Clip Description */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n                  <span>Ng\341\273\257 c\341\272\243nh clip / Post / N\341\273\227i \304\221au ng\306\260\341\273\235i xem</span>\n                </label>\n                <button\n                  type=\"button\"\n                  onClick={handleEnhanceContext}\n                  disabled={isEnhancingPrompt}\n                  className=\"text-[11px] font-semibold text-amber-300 hover:text-amber-200 flex items-center gap-1 bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/30 transition-all cursor-pointer\"\n                >\n                  <Wand2 className=\"w-3 h-3 text-amber-400\" />\n                  <span>{isEnhancingPrompt ? \'\304\220ang t\341\273\221i \306\260u...\' : \'\360\237\252\204 T\341\273\221i \306\260u \304\221\341\273\201 b\303\240i\'}</span>\n                </button>\n              </div>\n              <textarea\n                value={context}\n                onChange={(e) => setContext(e.target.value)}\n                placeholder=\"V\303\255 d\341\273\245: Clip n\303\263i v\341\273\201 c\341\272\243m gi\303\241c loay hoay tu\341\273\225i 25, l\303\240m nhi\341\273\201u vi\341\273\207c nh\306\260ng kh\303\264ng t\341\273\261 tin, b\341\273\213 m\341\272\245t ph\306\260\306\241ng h\306\260\341\273\233ng khi so s\303\241nh v\341\273\233i b\341\272\241n b\303\250 c\303\271ng trang l\341\273\251a...\"\n                rows={4}\n                className=\"w-full bg-slate-950 border border-slate-700/80 rounded-xl p-3 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 leading-relaxed font-sans\"\n              />\n            </div>\n\n            {/* Image / Screenshot Upload */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"text-xs font-bold text-slate-300 flex items-center gap-1.5\">\n                  <ImageIcon className=\"w-3.5 h-3.5 text-indigo-400\" />\n                  \341\272\242nh ch\341\273\245p m\303\240n h\303\254nh clip/post (T\303\271y ch\341\273\215n)\n                </label>\n                {imagePreview && (\n                  <button\n                    type=\"button\"\n                    onClick={removeImage}\n                    className=\"text-[10px] text-rose-400 hover:text-rose-300 font-semibold\"\n                  >\n                    X\303\263a \341\272\243nh\n                  </button>\n                )}\n              </div>\n\n              {imagePreview ? (\n                <div className=\"relative rounded-xl overflow-hidden border border-slate-700 bg-slate-950 p-2.5 flex items-center gap-3\">\n                  <img\n                    src={imagePreview}\n                    alt=\"Upload preview\"\n                    className=\"w-16 h-16 object-cover rounded-lg border border-slate-800\"\n                  />\n                  <div className=\"text-xs text-slate-300 flex-1\">\n                    <span className=\"font-semibold text-emerald-400 block mb-0.5\">\342\234\223 \304\220\303\243 n\341\272\241p \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh</span>\n                    <span className=\"text-[11px] text-slate-400\">AI s\341\272\275 t\341\273\261 \304\221\341\273\231ng \304\221\341\273\215c text & bi\341\273\203u c\341\272\243m trong \341\272\243nh \304\221\341\273\203 vi\341\272\277t \304\221\303\272ng hook</span>\n                  </div>\n                </div>\n              ) : (\n                <label className=\"flex flex-col items-center justify-center p-3.5 border border-dashed border-slate-700 rounded-xl bg-slate-950/50 hover:bg-slate-950 hover:border-indigo-500/50 cursor-pointer transition-all\">\n                  <Upload className=\"w-5 h-5 text-slate-400 mb-1\" />\n                  <span className=\"text-xs text-slate-300 font-medium\">T\341\272\243i \341\272\243nh ch\341\273\245p m\303\240n h\303\254nh clip / post</span>\n                  <span className=\"text-[10px] text-slate-500 mt-0.5\">PNG, JPG, WebP t\341\273\221i \304\221a 5MB</span>\n                  <input\n                    type=\"file\"\n                    accept=\"image/*\"\n                    onChange={handleImageUpload}\n                    className=\"hidden\"\n                  />\n                </label>\n              )}\n            </div>\n\n            {/* Custom Options Accordion */}\n            <div className=\"pt-3 border-t border-slate-800/80 space-y-3\">\n              <span className=\"text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5\">\n                <Sliders className=\"w-3.5 h-3.5 text-indigo-400\" />\n                T\303\271y Ch\341\273\215n Tinh Ch\341\273\211nh N\303\242ng Cao\n              </span>\n\n              {/* Length Preferences */}\n              <div>\n                <label className=\"text-[11px] font-medium text-slate-400 block mb-1\">\n                  \304\220\341\273\231 d\303\240i n\341\273\231i dung:\n                </label>\n                <div className=\"grid grid-cols-3 gap-1.5\">\n                  {[\n                    { id: \'short\', label: \'\342\232\241 Ng\341\272\257n g\341\273\215n\' },\n                    { id: \'medium\', label: \'\360\237\221\214 Ti\303\252u chu\341\272\251n\' },\n                    { id: \'deep\', label: \'\360\237\223\226 S\303\242u s\341\272\257c\' },\n                  ].map((l) => (\n                    <button\n                      key={l.id}\n                      type=\"button\"\n                      onClick={() => setLengthPreference(l.id as any)}\n                      className={`py-1.5 text-xs font-semibold rounded-lg border transition-all ${\n                        lengthPreference === l.id\n                          ? \'bg-indigo-600/30 text-indigo-300 border-indigo-500\'\n                          : \'bg-slate-950 text-slate-400 border-slate-800 hover:bg-slate-800\'\n                      }`}\n                    >\n                      {l.label}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Toggle Include Link */}\n              <div className=\"flex items-center justify-between text-xs pt-1\">\n                <label className=\"text-slate-300 cursor-pointer flex items-center gap-2\">\n                  <input\n                    type=\"checkbox\"\n                    checked={includeLink}\n                    onChange={(e) => setIncludeLink(e.target.checked)}\n                    className=\"rounded bg-slate-950 border-slate-700 text-indigo-600 focus:ring-indigo-500\"\n                  />\n                  <span>Ch\303\250n link Form / Test v\303\240o comment</span>\n                </label>\n                <span className=\"text-[10px] text-slate-500\">\n                  {includeLink ? \'C\303\263 g\341\272\257n link\' : \'Ch\341\273\211 k\303\252u g\341\273\215i Inbox\'}\n                </span>\n              </div>\n\n              {/* Custom Audience Input */}\n              <div>\n                <label className=\"text-[11px] font-medium text-slate-400 block mb-1\">\n                  \304\220\341\273\221i t\306\260\341\273\243ng c\341\273\245 th\341\273\203 (T\303\271y ch\341\273\215n)\n                </label>\n                <input\n                  type=\"text\"\n                  value={customAudience}\n                  onChange={(e) => setCustomAudience(e.target.value)}\n                  placeholder=\"V\303\255 d\341\273\245: Ng\306\260\341\273\235i \304\221i l\303\240m 22-35t, Senior loay hoay...\"\n                  className=\"w-full bg-slate-950 border border-slate-700/80 rounded-xl px-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500\"\n                />\n              </div>\n            </div>\n\n            {/* Error Message */}\n            {error && (\n              <div className=\"p-3 rounded-xl bg-rose-950/50 border border-rose-800 text-xs text-rose-300 flex items-center gap-2\">\n                <AlertTriangle className=\"w-4 h-4 text-rose-400 flex-shrink-0\" />\n                <span>{error}</span>\n              </div>\n            )}\n\n            {/* Submit Button */}\n            <button\n              onClick={handleGenerate}\n              disabled={isLoading}\n              className=\"w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-indigo-600 via-indigo-700 to-rose-600 hover:from-indigo-500 hover:to-rose-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/25 transition-all flex items-center justify-center space-x-2 disabled:opacity-50 cursor-pointer\"\n            >\n              {isLoading ? (\n                <>\n                  <RefreshCw className=\"w-4 h-4 animate-spin text-white\" />\n                  <span>AI \304\220ang Ph\303\242n T\303\255ch & S\341\272\243n Xu\341\272\245t Content...</span>\n                </>\n              ) : (\n                <>\n                  <Sparkles className=\"w-4 h-4 text-amber-300\" />\n                  <span>T\341\272\241o Content Order {currentOrderMeta.orderNumber} & K\341\273\213ch B\341\272\243n DM</span>\n                </>\n              )}\n            </button>\n          </div>\n        </div>\n\n        {/* Right Column: Generated Output & 1:1 Follow-up Script (7 Cols) */}\n        <div className=\"lg:col-span-7 space-y-4\">\n          {generatedResult ? (\n            <div className=\"space-y-4\">\n              {/* Output Meta & View Mode Switcher */}\n              <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-4 shadow-sm space-y-3\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                      {generatedResult.orderTitle}\n                    </span>\n                    <span className=\"px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-300\">\n                      N\341\273\201n t\341\272\243ng: {generatedResult.platform}\n                    </span>\n                  </div>\n\n                  {/* View Mode Toggle */}\n                  <div className=\"flex bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs\">\n                    <button\n                      onClick={() => setPreviewMode(\'cards\')}\n                      className={`px-3 py-1 rounded-lg font-semibold flex items-center gap-1.5 transition-all ${\n                        previewMode === \'cards\'\n                          ? \'bg-indigo-600 text-white shadow-sm\'\n                          : \'text-slate-400 hover:text-slate-200\'\n                      }`}\n                    >\n                      <LayoutGrid className=\"w-3.5 h-3.5\" />\n                      <span>3 Ph\306\260\306\241ng \303\201n</span>\n                    </button>\n                    <button\n                      onClick={() => setPreviewMode(\'mockup\')}\n                      className={`px-3 py-1 rounded-lg font-semibold flex items-center gap-1.5 transition-all ${\n                        previewMode === \'mockup\'\n                          ? \'bg-indigo-600 text-white shadow-sm\'\n                          : \'text-slate-400 hover:text-slate-200\'\n                      }`}\n                    >\n                      <Smartphone className=\"w-3.5 h-3.5 text-rose-400\" />\n                      <span>M\303\264 Ph\341\273\217ng Th\341\273\261c T\341\272\277</span>\n                    </button>\n                  </div>\n                </div>\n\n                {/* Selected Workshop/CT Summary */}\n                <div className=\"p-3 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1.5\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-[10px] font-bold uppercase px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\">\n                      {generatedResult.programType === \'ws\' ? \'Workshop (WS)\' : \'Ch\306\260\306\241ng tr\303\254nh (CT)\'}\n                    </span>\n                    <h4 className=\"text-xs font-bold text-slate-100\">\n                      {generatedResult.programTitle}\n                    </h4>\n                  </div>\n                  <p className=\"text-slate-400 text-xs italic\">\n                    \360\237\222\241 Insight ti\341\272\277p c\341\272\255n: {generatedResult.rationale}\n                  </p>\n                </div>\n              </div>\n\n              {/* View Mode 1: 3 Copyable Variations */}\n              {previewMode === \'cards\' ? (\n                <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <h3 className=\"text-sm font-bold text-white flex items-center gap-2\">\n                      <FileText className=\"w-4 h-4 text-indigo-400\" />\n                      3 Ph\306\260\306\241ng \303\201n Content Chu\341\272\251n H\303\263a\n                    </h3>\n                    <span className=\"text-[11px] text-slate-400\">Ch\341\273\215n ph\306\260\306\241ng \303\241n \306\260ng \303\275 nh\341\272\245t \304\221\341\273\203 r\341\272\243i</span>\n                  </div>\n\n                  <div className=\"space-y-3\">\n                    {generatedResult.variations.map((variation, idx) => (\n                      <div\n                        key={idx}\n                        className=\"group relative bg-slate-950 border border-slate-800 hover:border-slate-700 rounded-xl p-4 transition-all\"\n                      >\n                        <div className=\"flex items-center justify-between mb-2\">\n                          <div className=\"flex items-center gap-2\">\n                            <span className=\"text-[11px] font-bold text-indigo-300 uppercase tracking-wider\">\n                              Ph\306\260\306\241ng \303\241n {idx + 1}\n                            </span>\n                            {idx === activeVariationIndex && (\n                              <span className=\"text-[9px] font-semibold px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300\">\n                                \304\220ang ch\341\273\215n m\303\264 ph\341\273\217ng\n                              </span>\n                            )}\n                          </div>\n                          <div className=\"flex items-center gap-1.5\">\n                            <button\n                              onClick={() => {\n                                setActiveVariationIndex(idx);\n                                setPreviewMode(\'mockup\');\n                              }}\n                              className=\"px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 bg-slate-900 hover:bg-slate-800 transition-all flex items-center gap-1\"\n                            >\n                              <Eye className=\"w-3 h-3\" />\n                              <span>M\303\264 ph\341\273\217ng</span>\n                            </button>\n                            <button\n                              onClick={() => copyToClipboard(variation, `Ph\306\260\306\241ng \303\241n ${idx + 1}`)}\n                              className=\"px-2.5 py-1 rounded-lg text-xs font-semibold bg-indigo-600/30 hover:bg-indigo-600/50 text-indigo-200 border border-indigo-500/40 transition-all flex items-center gap-1.5\"\n                            >\n                              <Copy className=\"w-3.5 h-3.5\" />\n                              <span>Copy m\341\272\253u {idx + 1}</span>\n                            </button>\n                          </div>\n                        </div>\n\n                        <p className=\"text-xs text-slate-200 leading-relaxed whitespace-pre-line font-sans select-all\">\n                          {variation}\n                        </p>\n\n                        <div className=\"mt-2.5 pt-2 border-t border-slate-900 text-[10px] text-slate-500 flex items-center justify-between\">\n                          <span>\304\220\341\273\231 d\303\240i: {variation.length} k\303\275 t\341\273\261</span>\n                          <span className=\"italic text-slate-400\">\304\220\303\243 ki\341\273\203m duy\341\273\207t theo tone {generatedResult.platform}</span>\n                        </div>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              ) : (\n                /* View Mode 2: Real Platform Mockup Simulation */\n                <div className=\"bg-slate-900/90 border border-slate-800 rounded-2xl p-5 shadow-sm space-y-4\">\n                  <div className=\"flex items-center justify-between\">\n                    <div className=\"flex items-center gap-2\">\n                      <Smartphone className=\"w-4 h-4 text-rose-400\" />\n                      <h3 className=\"text-sm font-bold text-white\">\n                        M\303\264 Ph\341\273\217ng Tr\341\273\261c Ti\341\272\277p Tr\303\252n Giao Di\341\273\207n {generatedResult.platform}\n                      </h3>\n                    </div>\n                    {/* Variation switcher inside mockup */}\n                    <div className=\"flex items-center gap-1\">\n                      {generatedResult.variations.map((_, i) => (\n                        <button\n                          key={i}\n                          onClick={() => setActiveVariationIndex(i)}\n                          className={`px-2.5 py-1 rounded-lg text-xs font-semibold transition-all ${\n                            activeVariationIndex === i\n                              ? \'bg-indigo-600 text-white\'\n                              : \'bg-slate-950 text-slate-400 hover:text-white\'\n                          }`}\n                        >\n                          Ph\306\260\306\241ng \303\241n {i + 1}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Platform Mock Frame */}\n                  <div className=\"rounded-2xl border border-slate-700/80 bg-slate-950 p-5 shadow-inner space-y-4 max-w-xl mx-auto\">\n                    {/* Platform Header in Mock */}\n                    <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n                      <div className=\"flex items-center space-x-2.5\">\n                        <div className=\"w-9 h-9 rounded-full bg-gradient-to-tr from-rose-500 to-indigo-600 flex items-center justify-center text-white font-bold text-xs\">\n                          {generatedResult.platform.slice(0, 2).toUpperCase()}\n                        </div>\n                        <div>\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className=\"text-xs font-bold text-white\">\n                              Chuy\303\252n Gia \304\220\341\273\213nh H\306\260\341\273\233ng\n                            </span>\n                            <span className=\"text-[10px] text-blue-400\">\342\234\223</span>\n                          </div>\n                          <span className=\"text-[10px] text-slate-500\">\n                            {generatedResult.platform} Community \342\200\242 V\341\273\253a xong\n                          </span>\n                        </div>\n                      </div>\n                      <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-slate-800 text-slate-400\">\n                        Public\n                      </span>\n                    </div>\n\n                    {/* Content inside Mock */}\n                    <div className=\"text-xs text-slate-100 leading-relaxed whitespace-pre-line font-sans select-all p-3 rounded-xl bg-slate-900/60 border border-slate-800/80\">\n                      {generatedResult.variations[activeVariationIndex]}\n                    </div>\n\n                    {/* Social Action Bar Mock */}\n                    <div className=\"flex items-center justify-between pt-2 border-t border-slate-800 text-slate-400 text-xs\">\n                      <div className=\"flex items-center gap-4\">\n                        <span className=\"flex items-center gap-1 text-rose-400 cursor-pointer\">\n                          <Heart className=\"w-4 h-4 fill-rose-500/20\" />\n                          <span className=\"text-[11px]\">1.2k</span>\n                        </span>\n                        <span className=\"flex items-center gap-1 hover:text-indigo-300 cursor-pointer\">\n                          <MessageCircle className=\"w-4 h-4\" />\n                          <span className=\"text-[11px]\">84 Ph\341\272\243n h\341\273\223i</span>\n                        </span>\n                        <span className=\"flex items-center gap-1 hover:text-emerald-300 cursor-pointer\">\n                          <Share2 className=\"w-4 h-4\" />\n                          <span className=\"text-[11px]\">Chia s\341\272\273</span>\n                        </span>\n                      </div>\n                      <button\n                        onClick={() =>\n                          copyToClipboard(\n                            generatedResult.variations[activeVariationIndex],\n                            `Ph\306\260\306\241ng \303\241n ${activeVariationIndex + 1}`\n                          )\n                        }\n                        className=\"text-xs font-bold text-indigo-400 hover:text-indigo-300 flex items-center gap-1\"\n                      >\n                        <Copy className=\"w-3.5 h-3.5\" />\n                        <span>Copy m\341\272\253u n\303\240y</span>\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {/* 1:1 Inbound Chat Conversion Script */}\n              <div className=\"bg-gradient-to-b from-slate-900 to-indigo-950/30 border border-indigo-900/40 rounded-2xl p-5 shadow-sm space-y-4\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center space-x-2\">\n                    <div className=\"w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-300 flex items-center justify-center shadow-sm\">\n                      <UserCheck className=\"w-4 h-4\" />\n                    </div>\n                    <div>\n                      <h3 className=\"text-sm font-bold text-white\">\n                        K\341\273\213ch B\341\272\243n Chat 1-1 D\341\272\253n D\341\272\257t & Chuy\341\273\203n \304\220\341\273\225i\n                      </h3>\n                      <p className=\"text-[11px] text-slate-400\">\n                        \303\201p d\341\273\245ng ngay khi kh\303\241ch h\303\240ng comment h\341\273\217i ho\341\272\267c inbox xin test/link\n                      </p>\n                    </div>\n                  </div>\n\n                  <button\n                    onClick={() => {\n                      const fullScript = `B\306\257\341\273\232C 1: L\341\273\235i m\341\273\237 \304\221\341\272\247u \304\221\341\273\223ng c\341\272\243m:\\n${generatedResult.dmFollowUpScript.step1_empathy}\\n\\nB\306\257\341\273\232C 2: C\303\242u h\341\273\217i \304\221\303\240o s\303\242u:\\n${generatedResult.dmFollowUpScript.step2_qualifyQuestion}\\n\\nB\306\257\341\273\232C 3: G\341\273\255i b\303\240i test & m\341\273\235i tham gia:\\n${generatedResult.dmFollowUpScript.step3_inviteLink}`;\n                      copyToClipboard(fullScript, \'Tr\341\273\215n b\341\273\231 k\341\273\213ch b\341\272\243n DM\');\n                    }}\n                    className=\"px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-all flex items-center gap-1.5 shadow-sm cursor-pointer\"\n                  >\n                    <Copy className=\"w-3.5 h-3.5\" />\n                    <span>Copy Tr\341\273\215n B\341\273\231 DM</span>\n                  </button>\n                </div>\n\n                <div className=\"space-y-3\">\n                  {/* Step 1 */}\n                  <div className=\"p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1.5\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs font-bold text-amber-300 flex items-center gap-1.5\">\n                        <span className=\"w-4 h-4 rounded-full bg-amber-500/20 text-amber-300 text-[10px] flex items-center justify-center font-bold\">1</span>\n                        B\306\260\341\273\233c 1: Ch\303\240o \304\221\303\263n & \304\220\341\273\223ng c\341\272\243m (T\341\272\241o kh\303\264ng gian an to\303\240n)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyToClipboard(generatedResult.dmFollowUpScript.step1_empathy, \'B\306\260\341\273\233c 1\')\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        Copy\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/60 p-2.5 rounded-lg border border-slate-800/60\">\n                      \"{generatedResult.dmFollowUpScript.step1_empathy}\"\n                    </p>\n                  </div>\n\n                  {/* Step 2 */}\n                  <div className=\"p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1.5\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs font-bold text-sky-300 flex items-center gap-1.5\">\n                        <span className=\"w-4 h-4 rounded-full bg-sky-500/20 text-sky-300 text-[10px] flex items-center justify-center font-bold\">2</span>\n                        B\306\260\341\273\233c 2: C\303\242u h\341\273\217i \304\221\303\240o s\303\242u x\303\241c \304\221\341\273\213nh nhu c\341\272\247u (Qualifying Question)\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyToClipboard(\n                            generatedResult.dmFollowUpScript.step2_qualifyQuestion,\n                            \'B\306\260\341\273\233c 2\'\n                          )\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        Copy\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/60 p-2.5 rounded-lg border border-slate-800/60\">\n                      \"{generatedResult.dmFollowUpScript.step2_qualifyQuestion}\"\n                    </p>\n                  </div>\n\n                  {/* Step 3 */}\n                  <div className=\"p-3.5 rounded-xl bg-slate-950/90 border border-slate-800 space-y-1.5\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs font-bold text-emerald-300 flex items-center gap-1.5\">\n                        <span className=\"w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] flex items-center justify-center font-bold\">3</span>\n                        B\306\260\341\273\233c 3: L\341\273\235i m\341\273\235i g\341\273\255i b\303\240i test / Form tham v\341\272\245n 1-1 mi\341\273\205n ph\303\255\n                      </span>\n                      <button\n                        onClick={() =>\n                          copyToClipboard(generatedResult.dmFollowUpScript.step3_inviteLink, \'B\306\260\341\273\233c 3\')\n                        }\n                        className=\"text-[11px] text-slate-400 hover:text-slate-200\"\n                      >\n                        Copy\n                      </button>\n                    </div>\n                    <p className=\"text-xs text-slate-300 leading-relaxed italic bg-slate-900/60 p-2.5 rounded-lg border border-slate-800/60\">\n                      \"{generatedResult.dmFollowUpScript.step3_inviteLink}\"\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          ) : (\n            /* Empty State */\n            <div className=\"h-full min-h-[440px] rounded-2xl border border-dashed border-slate-800 bg-slate-900/40 p-8 flex flex-col items-center justify-center text-center space-y-4\">\n              <div className=\"w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center\">\n                <Sparkles className=\"w-7 h-7\" />\n              </div>\n              <div className=\"max-w-md space-y-1.5\">\n                <h3 className=\"text-sm font-bold text-slate-200\">\n                  Studio S\341\272\265n S\303\240ng T\341\272\241o Content\n                </h3>\n                <p className=\"text-xs text-slate-400 leading-relaxed\">\n                  Nh\341\272\255p ng\341\273\257 c\341\272\243nh b\303\240i \304\221\304\203ng \341\273\237 c\341\273\231t b\303\252n tr\303\241i ho\341\272\267c ch\341\273\215n <strong>\"K\341\273\213ch b\341\272\243n m\341\272\253u nhanh\"</strong>, sau \304\221\303\263 b\341\272\245m <strong>\"T\341\272\241o Content Order\"</strong> \304\221\341\273\203 nh\341\272\255n ngay 3 ph\306\260\306\241ng \303\241n chu\341\272\251n h\303\263a v\303\240 k\341\273\213ch b\341\272\243n chat 1-1.\n                </p>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
