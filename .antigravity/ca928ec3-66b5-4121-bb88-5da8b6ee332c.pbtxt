        lines {
          text: "    targetAudience: [\'Sinh vi\303\252n n\304\203m 3, 4\', \'C\341\273\255 nh\303\242n m\341\273\233i t\341\273\221t nghi\341\273\207p\', \'Ng\306\260\341\273\235i chu\341\272\251n b\341\273\213 b\306\260\341\273\233c v\303\240o m\303\264i tr\306\260\341\273\235ng l\303\240m vi\341\273\207c th\341\273\261c t\341\272\277\'],"
